+// M activation rows (fp32, legacy permuted, row stride ap_stride) against weight rows [n0, n1).
+// Scales: fp32 (E8 = false, dv = float*) or e8m0 bytes (E8 = true, dv = uint8_t*). c[mi * c_stride + ni].
+template <int M, bool E8, int VAR, int PFD>
+static void gemv(const float* __restrict ap, size_t ap_stride, const uint8_t* __restrict b, const void* __restrict dv,
+                 int k, int n0, int n1, float* __restrict c, size_t c_stride) {
+  static const DConst K;
+  const float* e8 = avx2kern::e8_table();
+  const int G = k / 32;
+  const size_t rb = (size_t)k / 2;
+  for (int ni = n0; ni < n1; ni++) {
+    const uint8_t* br = b + (size_t)ni * rb;
+    const float* sf = E8 ? nullptr : (const float*)dv + (size_t)ni * G;
+    const uint8_t* se = E8 ? (const uint8_t*)dv + (size_t)ni * G : nullptr;
+    __m256 t0[M], t1[M];
+#pragma GCC unroll 4
+    for (int mi = 0; mi < M; mi++) t0[mi] = t1[mi] = _mm256_setzero_ps();
+    auto step = [&](int g, __m256* tacc) __attribute__((always_inline)) {
+      if constexpr (PFD > 0) {
+        constexpr auto H = (VAR & PFL2) != 0 ? _MM_HINT_T1 : _MM_HINT_T0;
+        if ((g & 3) == 0) _mm_prefetch((const char*)(br + (size_t)g * 16 + PFD), H);
+        if constexpr (E8) {
+          if ((g & 63) == 0) _mm_prefetch((const char*)(se + g + PFD / 16), H);
+        } else {
+          if ((g & 15) == 0) _mm_prefetch((const char*)(sf + g + PFD / 16), H);
+        }
+      }
+      __m256 w0, w1, w2, w3;
+      decode<VAR>(br + (size_t)g * 16, K, w0, w1, w2, w3);
+      const __m256 sv = E8 ? _mm256_broadcast_ss(e8 + se[g]) : _mm256_broadcast_ss(sf + g);
+#pragma GCC unroll 4
+      for (int mi = 0; mi < M; mi++) {
+        const float* a = ap + mi * ap_stride + (size_t)g * 32;
+        // NOTE: swapping the first two terms is an EQUIVALENT change (a*w is exact for bf16 x FP4, so
+        // mul(a0,w0)+fma(a1,w1) == mul(a1,w1)+fma(a0,w0)); mutant 3 therefore swaps terms 3 and 4.
+        __m256 gacc;
+        if constexpr ((VAR & MULADD) != 0) {
+          __m256 p0 = _mm256_mul_ps(_mm256_loadu_ps(a), w0);
+          __m256 p1 = _mm256_mul_ps(_mm256_loadu_ps(a + 8), w1);
+          __m256 p2 = _mm256_mul_ps(_mm256_loadu_ps(a + 16), w2);
+          __m256 p3 = _mm256_mul_ps(_mm256_loadu_ps(a + 24), w3);
+          // pin the products: without this, -ffast-math contracts mul+add back into fma (same value, long chain)
+          __asm__("" : "+x"(p0), "+x"(p1), "+x"(p2), "+x"(p3));
+          // fixed order ((p0 + p1) + p2) + p3; the empty asm pins each partial sum against -ffast-math reassociation
+          gacc = _mm256_add_ps(p0, p1);
+          __asm__("" : "+x"(gacc));
+#if defined(DK_MUTANT) && DK_MUTANT == 3
+          gacc = _mm256_add_ps(gacc, p3);
+          __asm__("" : "+x"(gacc));
+          gacc = _mm256_add_ps(gacc, p2);
+#else
+          gacc = _mm256_add_ps(gacc, p2);
+          __asm__("" : "+x"(gacc));
+          gacc = _mm256_add_ps(gacc, p3);
+#endif
+          __asm__("" : "+x"(gacc));
+        } else {
+          gacc = _mm256_mul_ps(_mm256_loadu_ps(a), w0);
+          gacc = _mm256_fmadd_ps(_mm256_loadu_ps(a + 8), w1, gacc);
+#if defined(DK_MUTANT) && DK_MUTANT == 3  // positive control only: third and fourth product in the other order
+          gacc = _mm256_fmadd_ps(_mm256_loadu_ps(a + 24), w3, gacc);
+          gacc = _mm256_fmadd_ps(_mm256_loadu_ps(a + 16), w2, gacc);
+#else
+          gacc = _mm256_fmadd_ps(_mm256_loadu_ps(a + 16), w2, gacc);
+          gacc = _mm256_fmadd_ps(_mm256_loadu_ps(a + 24), w3, gacc);
+#endif
+        }
+        tacc[mi] = _mm256_fmadd_ps(gacc, sv, tacc[mi]);
+      }
+    };
+    int g = 0;
+#if defined(DK_MUTANT) && DK_MUTANT == 2  // positive control only: groups g % 4 == 3 into t0 instead of t1
+    // (a plain t0/t1 swap would be EQUIVALENT: the final t0 + t1 is commutative)
+    for (; g + 2 <= G; g += 2) {
+      step(g, t0);
+      step(g + 1, ((g + 1) & 3) == 3 ? t0 : t1);
+    }
+    if (g < G) step(g, t0);
+#else
+    for (; g + 2 <= G; g += 2) {
+      step(g, t0);
+      step(g + 1, t1);
+    }
+    if (g < G) step(g, t0);
+#endif
+#pragma GCC unroll 4
+    for (int mi = 0; mi < M; mi++) c[mi * c_stride + ni] = avx2::hsum_avx2(_mm256_add_ps(t0[mi], t1[mi]));
+  }
+}
