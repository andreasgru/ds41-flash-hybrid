+  // SwiGLU of one 32-group (in place into the gate slot, as apply_activation) + down activation of that group.
+  inline void k2p_act_group(int s, int g, int kern) {
+    ggml_bf16_t* gp = k2p_g_[s] + (size_t)g * 32;
+    const ggml_bf16_t* up = k2p_u_[s] + (size_t)g * 32;
+    const float lim = config_.swiglu_limit, alpha = config_.swiglu_alpha;
+    for (int q = 0; q < 32; q += 8) {
+      __m256 gate_val = avx2::load_bf16_to_fp32(gp + q);
+      __m256 up_val = avx2::load_bf16_to_fp32(up + q);
+      __m256 result = avx2::act_fn(gate_val, up_val, lim, alpha);
+      avx2::store_fp32_to_bf16(gp + q, result);
+    }
+    typename T::BufferA& ha = k2p_ha_[s];
+    if (kern == 2) {
+      int8_t* q = (int8_t*)ha.perm;
+      float* da = (float*)(q + ha.max_m * ha.k);
+      avx2kern::quant_act_q8(gp, 32, q + (size_t)g * 32, da + g);
+    } else {
+      avx2kern::permute_act_bf16(gp, ha.perm + (size_t)g * 32, 32);
+    }
+  }
