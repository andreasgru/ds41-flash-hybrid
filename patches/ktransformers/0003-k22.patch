+/**
+ * @Description  : AVX2 MXFP4 exact decode GEMV variants for Zen 2
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Same contract as avx2kern::gemv_m<M, E8> (mxfp4-kernel.hpp): per (weight row, activation row) the arithmetic is
+ * IDENTICAL to the legacy single-row loop of gemm_mxfp4 (group size 32):
+ *   gacc = a0*w0; gacc = fma(a1,w1,gacc); gacc = fma(a2,w2,gacc); gacc = fma(a3,w3,gacc);
+ *   t[g & 1] = fma(gacc, scale_g, t[g & 1]);   result = hsum(t0 + t1)
+ * with the legacy column -> lane mapping (w0 = cols {0,2,4,6 | 1,3,5,7}, w1 = {8..14 | 9..15}, ...).
+ * Only HOW w0..w3 are produced and how memory is touched differs:
+ *   VAR bit 0 (SPLIT): nibble split with one broadcast load + vpsrlvd + vpand (2 FP ops instead of 4).
+ *   PFD > 0          : software prefetch of the weight stream PFD bytes ahead (prefetcht0, one per 64-byte line),
+ *                      e8m0 scales PFD/16 bytes ahead; rows are contiguous, so the prefetch runs into the next row.
+ * The values w0..w3 are bit-identical to the legacy decode for every input byte (checked exhaustively over all
+ * 256 byte values per position by dskern_selftest_decode()).
+ **/
+#ifndef CPUINFER_OPERATOR_AVX2_MXFP4_DSKERN_H
+#define CPUINFER_OPERATOR_AVX2_MXFP4_DSKERN_H
+
+#include <immintrin.h>
+
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#include "mxfp4-kernel.hpp"  // avx2kern::KConst, decode_group<0>, e8_table, kern_mode
+
+namespace dskern {
+
+// VAR bit 1 (MULADD): the four products a_i*w_i are EXACT in fp32 (bf16 activation: 8 significant bits; FP4 weight:
+// at most 2), so fma(a_i, w_i, acc) == round(acc + a_i*w_i) == add(acc, mul(a_i, w_i)). MULADD computes the four
+// products independently and chains three adds: same roundings in the same order, but a dependency chain of
+// mul(3) + 3 x add(3) instead of mul(3) + 3 x fma(5) cycles. Exactness needs |a| <= 2^125 (no product overflow)
+// and finite activations; act_safe() checks that once per activation buffer, callers fall back to VAR & ~MULADD.
+// VAR bit 2 (PFL2): software prefetch with _MM_HINT_T1 (into L2) instead of _MM_HINT_T0 (into L1).
+enum : int { SPLIT = 1, MULADD = 2, PFL2 = 4 };
+
+// true if every activation value is finite and |a| <= 2^125 (then |a*w| <= 6 * 2^125 < FLT_MAX: no overflow).
+static inline bool act_safe(const float* a, size_t n) {
+  const __m256 lim = _mm256_set1_ps(0x1p125f);
+  const __m256 absm = _mm256_castsi256_ps(_mm256_set1_epi32(0x7FFFFFFF));
+  __m256 bad = _mm256_setzero_ps();
+  size_t i = 0;
+  for (; i + 8 <= n; i += 8) {
+    const __m256 x = _mm256_and_ps(_mm256_loadu_ps(a + i), absm);
+    bad = _mm256_or_ps(bad, _mm256_cmp_ps(x, lim, _CMP_NLE_UQ));  // > lim, or NaN (unordered)
+  }
+  if (_mm256_movemask_ps(bad) != 0) return false;
+  for (; i < n; i++) {
+    const float x = a[i] < 0 ? -a[i] : a[i];
+    if (!(x <= 0x1p125f)) return false;
+  }
+  return true;
+}
+
+// Env switch, read once per process: KT_DS41_MU_DECODE_KERNEL=1 selects the exact decode GEMV for the KERN=1 m <= 3 path.
+// KT_DS41_MU_DECODE_PREFETCH overrides the prefetch distance (bytes, 0 = off; only values compiled below are accepted).
+static inline int env_int(const char* name, int dflt) {
+  const char* s = std::getenv(name);
+  return (s && *s) ? std::atoi(s) : dflt;
+}
+static inline int mode() {
+  static const int m = env_int("KT_DS41_MU_DECODE_KERNEL", 0);
+  return m;
+}
+// KT_DS41_MU_DECODE_PREFETCH: software prefetch distance in bytes for the exact decode GEMV; only 0, 1024, 2048, 4096 are compiled into the
+// package path. Any other value returns -1 (the caller refuses to start: fail closed, no silent fallback).
+static inline int pfd() {
+  static const int p = [] {
+    const int v = env_int("KT_DS41_MU_DECODE_PREFETCH", 0);
+    return (v == 0 || v == 1024 || v == 2048 || v == 4096) ? v : -1;
+  }();
+  return p;
+}
