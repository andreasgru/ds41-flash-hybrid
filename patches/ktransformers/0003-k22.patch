+  // Balanced scheduling: task boundaries (units: rows for gate/up, 8-row blocks for down) for the balanced jobs.
+  //   GUIDED (default, KT_DS41_MU_K2EPLUS_GUIDED != 0): factoring, batches of P chunks of remaining / (2P) units, at least
+  //   minc; long contiguous chunks first, small ones at the end, so a worker slowed by its SMT sibling or an IRQ
+  //   holds the job only for a small last chunk (v2 with 2 equal chunks per thread lost 8-13 % under sibling load).
+  //   Else v2: T = min(tmax, P * split) equal chunks. P = pool threads (KT_DS41_MU_K2EPLUS_GP overrides, for tests only).
+  //   The arithmetic per output row does not depend on the boundaries (checked with many splits).
+  std::vector<long> k2p_bgu_, k2p_bdn_;
+  static bool k2p_guided() {
+    static const bool g = [] { const char* e = std::getenv("KT_DS41_MU_K2EPLUS_GUIDED"); return !(e && *e && std::atoi(e) == 0); }();
+    return g;
+  }
+  static void k2p_bounds(long U, int P, long minc, long tmax, int split, std::vector<long>& b) {
+    static const int gp = [] { const char* e = std::getenv("KT_DS41_MU_K2EPLUS_GP"); return (e && *e) ? std::max(1, std::atoi(e)) : 0; }();
+    if (gp > 0) P = gp;
+    b.clear();
+    b.push_back(0);
+    if (U <= 0) return;
+    if (k2p_guided()) {
+      long pos = 0;
+      while (pos < U) {
+        const long c = std::max(minc, (U - pos) / (2L * P));
+        for (int i = 0; i < P && pos < U; i++) {
+          pos += std::min(c, U - pos);
+          b.push_back(pos);
+        }
+      }
+    } else {
+      const long NT = std::max(1L, std::min(tmax, (long)P * split));
+      for (long t = 1; t <= NT; t++) b.push_back(U * t / NT);
+    }
+  }
+
+  // tasks per worker thread for the balanced jobs (KT_DS41_MU_K2EPLUS_SPLIT1 / _SPLIT2, default 2 / 2)
+  static int k2p_split(int which) {
+    static const int s1 = [] { const char* e = std::getenv("KT_DS41_MU_K2EPLUS_SPLIT1"); return (e && *e) ? std::max(1, std::atoi(e)) : 2; }();
+    static const int s2 = [] { const char* e = std::getenv("KT_DS41_MU_K2EPLUS_SPLIT2"); return (e && *e) ? std::max(1, std::atoi(e)) : 2; }();
+    return which == 1 ? s1 : s2;
+  }
