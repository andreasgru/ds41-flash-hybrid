+// ---- Entry counter for the exact decode dispatch branch -----
+// count_entry() is called as the first statement of the decode branch in avx2::gemm_mxfp4 (mxfp4-moe.hpp). The counter is
+// a relaxed atomic add and does not participate in the arithmetic. Diagnostic output:
+//   * the first entry prints one line "DK_ENTRY_COUNT=<n>", every ENTRY_REPORT_EVERY entries another one,
+//   * an exit handler registered on the first entry prints the final count at the regular stop (process exit).
+// An absent line (or DK_ENTRY_COUNT=0) means the decode branch was never entered. A fallback to gemv_m
+// can preserve identical output bytes while leaving the entry counter at 0.
+static constexpr unsigned long long ENTRY_REPORT_EVERY = 4096;
+
+inline std::atomic<unsigned long long>& entry_counter() {
+  static std::atomic<unsigned long long> c{0};
+  return c;
+}
+
+inline void report_entries(const char* where) {
+  std::fprintf(stdout, "DK_ENTRY_COUNT=%llu final (%s)\n",
+               (unsigned long long)entry_counter().load(std::memory_order_relaxed), where);
+  std::fflush(stdout);
+}
+
+static inline void entry_exit_handler() { report_entries("regular stop"); }
+
+inline void count_entry() {
+  const unsigned long long n = entry_counter().fetch_add(1, std::memory_order_relaxed) + 1;
+  if (n == 1 || (n % ENTRY_REPORT_EVERY) == 0) {
+    std::fprintf(stdout, "DK_ENTRY_COUNT=%llu (DK branch gemm_mxfp4, m<=2)\n", n);
+    std::fflush(stdout);
+  }
+  static const bool handler_set = (std::atexit(entry_exit_handler), true);
+  (void)handler_set;
+}
+
+struct DConst {
+  __m256i lutlo, luthi, nib, zero, shift;
+  DConst() {
+    lutlo = _mm256_broadcastsi128_si256(_mm_load_si128((const __m128i*)avx2kern::kLutLo));
+    luthi = _mm256_broadcastsi128_si256(_mm_load_si128((const __m128i*)avx2kern::kLutHi));
+    nib = _mm256_set1_epi8(0x0F);
+    zero = _mm256_setzero_si256();
+#if defined(DK_MUTANT) && DK_MUTANT == 1  // positive control only: lo/hi nibble halves swapped
+    shift = _mm256_setr_epi32(4, 4, 4, 4, 0, 0, 0, 0);
+#else
+    shift = _mm256_setr_epi32(0, 0, 0, 0, 4, 4, 4, 4);
+#endif
+  }
+};
+
+// Decode one 32-value group at p into w0..w3 with the legacy lane mapping.
+template <int VAR>
+static __attribute__((always_inline)) inline void decode(const uint8_t* p, const DConst& K, __m256& w0, __m256& w1,
+                                                          __m256& w2, __m256& w3) {
+  __m256i v;
+  if constexpr ((VAR & SPLIT) != 0) {
+    // [raw | raw] -> low lane unchanged, high lane >> 4 per dword; & 0x0F per byte = [lo nibbles | hi nibbles]
+    const __m256i r = _mm256_broadcastsi128_si256(_mm_loadu_si128((const __m128i*)p));
+    v = _mm256_and_si256(_mm256_srlv_epi32(r, K.shift), K.nib);
+  } else {
+    const __m128i raw = _mm_loadu_si128((const __m128i*)p);
+    const __m128i n128 = _mm256_castsi256_si128(K.nib);
+    const __m128i lo = _mm_and_si128(raw, n128);
+    const __m128i hi = _mm_and_si128(_mm_srli_epi16(raw, 4), n128);
+    v = _mm256_set_m128i(hi, lo);
+  }
+  const __m256i bl = _mm256_shuffle_epi8(K.lutlo, v);
+  const __m256i bh = _mm256_shuffle_epi8(K.luthi, v);
+  const __m256i ua = _mm256_unpacklo_epi8(bl, bh);
+  const __m256i ub = _mm256_unpackhi_epi8(bl, bh);
+  w0 = _mm256_castsi256_ps(_mm256_unpacklo_epi16(K.zero, ua));
+  w1 = _mm256_castsi256_ps(_mm256_unpackhi_epi16(K.zero, ua));
+  w2 = _mm256_castsi256_ps(_mm256_unpacklo_epi16(K.zero, ub));
+  w3 = _mm256_castsi256_ps(_mm256_unpackhi_epi16(K.zero, ub));
+}
