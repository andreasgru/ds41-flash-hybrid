+  bool k2p_decode(int k, const int64_t* expert_ids, const float* weights, const void* input, void* output) {
+    if (!(k2p::on(k2p::EPI) || k2p::on(k2p::BAL))) return false;
+    const int kern = avx2kern::kern_mode();
+    const int H = config_.hidden_size, I = config_.intermediate_size;
+    if (!(kern == 1 || kern == 2) || config_.quant_config.group_size != 32 || H % 32 != 0 || I % 32 != 0) return false;
+    if (k > 64) return false;
+    int slot_e[kK2PSlots];
+    int slot_of_j[64];
+    int a = 0;
+    for (int j = 0; j < k; j++) {
+      slot_of_j[j] = -1;
+      if (config_.should_skip_expert(expert_ids[j])) continue;
+      if (a == kK2PSlots) return false;
+      slot_e[a] = (int)expert_ids[j];
+      slot_of_j[j] = a++;
+    }
+    if (!k2p_alloc()) return false;
+#ifdef K2P_TRACE
+    static std::atomic<long> k2p_trace_n{0};
+    if (k2p_trace_n.fetch_add(1) < 3) fprintf(stderr, "[K2P_TRACE] k2p_decode a=%d bal=%d kern=%d\n", a, (int)k2p::on(k2p::BAL), kern);
+#endif
+#if __has_include("../../cpu_backend/moe_timing.h")
+    const bool kt_timing = kt_moe_timing::every() > 0;
+    const uint64_t kt_a = kt_timing ? kt_moe_timing::now_ns() : 0;
+#endif
+    float* out = (float*)output;
+    const bool bal = k2p::on(k2p::BAL);
+    const int G = I / 32;
+    auto pool = config_.pool->get_subpool(tp_part_idx);
+    if (a > 0) {
+      // input once (same bytes as every per-expert from_mat of the legacy path)
+      k2p_xa_.from_mat(1, (const ggml_bf16_t*)input, 0, 1);
+      for (int s = 0; s < a; s++) {
+        k2p_ha_[s].perm_m = 1;
+        k2p_ha_[s].perm_is_q8 = (kern == 2);
+      }
+      if (bal)
+        for (int i = 0; i < a * G; i++) k2p_cnt_[i].store(0, std::memory_order_relaxed);
+    }
+#if __has_include("../../cpu_backend/moe_timing.h")
+    const uint64_t kt_b = kt_timing ? kt_moe_timing::now_ns() : 0;
+#endif
+    if (a > 0) {
+      // ---- gate/up + SwiGLU + down activation ----
+      const int nthr = std::max(1, pool->k2p_worker_count());
+      int T1;
+      if (bal) {
+        const long R = (long)a * I;
+        k2p_bounds(R, nthr, 16, std::max(1L, R / 16), k2p_split(1), k2p_bgu_);
+        T1 = (int)k2p_bgu_.size() - 1;
+        const long* bb = k2p_bgu_.data();
+        pool->do_work_stealing_job(
+            T1, nullptr,
+            [this, bb, I, kern, &slot_e](int t) {
+              static thread_local std::vector<float> tmp;
+              if (tmp.size() < (size_t)2 * I) tmp.resize((size_t)2 * I);
+              long f0 = bb[t];
+              const long f1 = bb[t + 1];
+              while (f0 < f1) {
+                const int s = (int)(f0 / I), r0 = (int)(f0 % I);
+                const int r1 = (int)std::min<long>(I, r0 + (f1 - f0));
+                k2p_gu_rows(s, slot_e[s], r0, r1, kern, tmp.data(), tmp.data() + I);
+                f0 += r1 - r0;
+              }
+            },
+            nullptr);
+      } else {
+        T1 = a * G;
+        pool->do_work_stealing_job(
+            T1, nullptr,
+            [this, G, kern, &slot_e](int t) {
+              float tg[32], tu[32];
+              const int s = t / G, g = t % G;
+              k2p_gu_rows(s, slot_e[s], g * 32, g * 32 + 32, kern, tg, tu);
+            },
+            nullptr);
+      }
+    }
+#if __has_include("../../cpu_backend/moe_timing.h")
+    const uint64_t kt_c = kt_timing ? kt_moe_timing::now_ns() : 0;
+#endif
+    if (a > 0 && bal) {
+      // ---- down by output-row ranges over all experts + weighted sum (same FMA chain over j) ----
+      const int U = H / 8;
+      const int nthr = std::max(1, pool->k2p_worker_count());
+      k2p_bounds(U, nthr, 2, U, k2p_split(2), k2p_bdn_);
+      const int T2 = (int)k2p_bdn_.size() - 1;
+      const long* bd = k2p_bdn_.data();
+      pool->do_work_stealing_job(
+          T2, nullptr,
+          [this, bd, H, I, a, k, out, weights, &slot_e, &slot_of_j](int t) {
+            static thread_local std::vector<float> tmp;
+            static thread_local std::vector<ggml_bf16_t> dob;
+            const int h0 = 8 * (int)bd[t], h1 = 8 * (int)bd[t + 1], n = h1 - h0;
+            if (n <= 0) return;
+            if (tmp.size() < (size_t)n) tmp.resize((size_t)H);
+            if (dob.size() < (size_t)a * n) dob.resize((size_t)kK2PSlots * H);
+            for (int s = 0; s < a; s++) {
+              typename T::BufferB bv = k2p_rows(*down_bb_[slot_e[s]], h0, h1);
+              typename T::BufferC cv(1, n, tmp.data());
+              avx2::gemm_mxfp4(1, n, I, k2p_ha_[s], bv, cv, 0, 1);
+              k2p_to_bf16(tmp.data(), dob.data() + (size_t)s * n, n);
+            }
+            for (int e = 0; e < n; e += 8) {
+              __m256 x0 = _mm256_setzero_ps();
+              for (int j = 0; j < k; j++) {
+                const int s = slot_of_j[j];
+                if (s < 0) continue;
+                __m256 weight = _mm256_set1_ps(weights[j]);
+                __m256 d0 = avx2::load_bf16_to_fp32(dob.data() + (size_t)s * n + e);
+                x0 = _mm256_fmadd_ps(d0, weight, x0);
+              }
+              _mm256_storeu_ps(out + h0 + e, x0);
+            }
+            this->k2p_publish(0, h0, h1);
+          },
+          nullptr);
+    } else if (a > 0) {
+      // ---- EPI only: legacy down split (80 tasks per expert) and legacy serial weighted sum ----
+      const int nth = T::recommended_nth(H);
+      pool->do_work_stealing_job(
+          nth * a, nullptr,
+          [this, nth, H, I, &slot_e](int task_id) {
+            const int s = task_id / nth, ith = task_id % nth;
+            typename T::BufferC cv(1, H, k2p_dt_[s]);
+            avx2::gemm_mxfp4(1, H, I, k2p_ha_[s], *down_bb_[slot_e[s]], cv, ith, nth);
+            cv.to_mat(1, k2p_do_[s], ith, nth);
+          },
+          nullptr);
+    }
+#if __has_include("../../cpu_backend/moe_timing.h")
+    const uint64_t kt_d = kt_timing ? kt_moe_timing::now_ns() : 0;
+#endif
+    if (a == 0 || !bal) {
+      for (int e = 0; e < H; e += 16) {
+        __m256 x0 = _mm256_setzero_ps();
+        __m256 x1 = _mm256_setzero_ps();
+        for (int j = 0; j < k; j++) {
+          const int s = slot_of_j[j];
+          if (s < 0) continue;
+          __m256 weight = _mm256_set1_ps(weights[j]);
+          __m256 d0, d1;
+          avx2::load_16xbf16_to_2x8xfp32(k2p_do_[s] + e, &d0, &d1);
+          x0 = _mm256_fmadd_ps(d0, weight, x0);
+          x1 = _mm256_fmadd_ps(d1, weight, x1);
+        }
+        auto f32out = (__m256*)(out + e);
+        f32out[0] = x0;
+        f32out[1] = x1;
+      }
+      this->k2p_publish(0, 0, H);  // MERGE: whole row range final (serial weighted sum)
+    }
+#if __has_include("../../cpu_backend/moe_timing.h")
+    if (kt_timing) kt_moe_timing::part_done(tp_part_idx, a, kt_a, kt_b, kt_c, kt_d, kt_moe_timing::now_ns());
+#endif
+    return true;
+  }
+
+  // ===========================================================================================================
+  // Batched decode fusion (stage 7): bs 2..9 (forward_prefill, qlen < 10) with the decode scheme. Called after the legacy
+  // buffer assignment and the input from_mat of every expert (gate_up_ba_), so each expert's activation bytes are
+  // exactly the legacy ones. Per expert e with m tokens the kernels are the legacy ones (gemm_mxfp4 with m rows on
+  // row views; m <= 3 KERN path, m >= 4 4-row fp32 path as with K6), same bf16 roundings, same act_fn per token row,
+  // same down activation per token row and 32-group (Q8 for KERN=2 and m <= 3, else permuted fp32), same weighted
+  // sum per token over j. Work split: gate/up = equal row ranges over all experts (all m tokens per row), down =
+  // output-row ranges over all experts, weighted sum of every token in the epilogue, MERGE publish per token.
+  // ===========================================================================================================
+  std::vector<std::atomic<int>> k2p_bcnt_;
+
+  inline void k2p_bs_act_group(int e, int g, int m, int kern) {
+    const int I = config_.intermediate_size;
+    const float lim = config_.swiglu_limit, alpha = config_.swiglu_alpha;
+    typename T::BufferA& ha = *down_ba_[e];
+    for (int mi = 0; mi < m; mi++) {
+      ggml_bf16_t* gp = this->m_local_gate_output_ptr_[e] + (size_t)mi * I + (size_t)g * 32;
+      const ggml_bf16_t* up = this->m_local_up_output_ptr_[e] + (size_t)mi * I + (size_t)g * 32;
+      for (int q = 0; q < 32; q += 8) {
+        __m256 gate_val = avx2::load_bf16_to_fp32(gp + q);
+        __m256 up_val = avx2::load_bf16_to_fp32(up + q);
+        __m256 result = avx2::act_fn(gate_val, up_val, lim, alpha);
+        avx2::store_fp32_to_bf16(gp + q, result);
+      }
+      if (ha.perm_is_q8) {
+        int8_t* q = (int8_t*)ha.perm;
+        float* da = (float*)(q + ha.max_m * ha.k);
+        avx2kern::quant_act_q8(gp, 32, q + (size_t)mi * I + (size_t)g * 32, da + (size_t)mi * (I / 32) + g);
+      } else {
+        avx2kern::permute_act_bf16(gp, ha.perm + (size_t)mi * I + (size_t)g * 32, 32);
+      }
+    }
+  }
+
+  bool k2p_bs(int qlen, int k, const int64_t* expert_ids, const float* weights, void* output, int a) {
+    const int kern = avx2kern::kern_mode();
+    const int H = config_.hidden_size, I = config_.intermediate_size, G = I / 32;
+    if (!(kern == 1 || kern == 2) || config_.quant_config.group_size != 32 || H % 32 != 0 || I % 32 != 0) return false;
+    if (qlen < 1 || qlen >= 10 || a < 1) return false;
+    const int* emap = this->m_expert_id_map_.data();
+    int mmax = 0;
+    for (int s = 0; s < a; s++) {
+      const int e = emap[s];
+      const int m = m_local_num_[e];
+      typename T::BufferA& ha = *down_ba_[e];
+      if (ha.perm == nullptr || gate_up_ba_[e]->perm == nullptr || ha.max_m < (size_t)m) return false;
+      mmax = std::max(mmax, m);
+    }
+    if ((size_t)a * G > k2p_bcnt_.size()) {
+      std::vector<std::atomic<int>> v((size_t)std::max(a, config_.max_len * config_.num_experts_per_tok) * G);
+      k2p_bcnt_.swap(v);
+    }
+    // down activation layout as the legacy from_mat would produce it (flags now, bytes in the gate/up epilogue)
+    for (int s = 0; s < a; s++) {
+      const int e = emap[s];
+      const int m = m_local_num_[e];
+      typename T::BufferA& ha = *down_ba_[e];
+      ha.perm_is_q8 = (kern == 2 && m <= 3);
+      ha.perm_m = m;
+    }
+    for (size_t i = 0; i < (size_t)a * G; i++) k2p_bcnt_[i].store(0, std::memory_order_relaxed);
+#ifdef K2P_TRACE
+    static std::atomic<long> k2p_bs_n{0};
+    if (k2p_bs_n.fetch_add(1) < 3) fprintf(stderr, "[K2P_TRACE] k2p_bs qlen=%d a=%d mmax=%d kern=%d\n", qlen, a, mmax, kern);
+#endif
+    auto pool = config_.pool->get_subpool(tp_part_idx);
+    const int nthr = std::max(1, pool->k2p_worker_count());
+    // ---- gate/up (all m tokens per row) + SwiGLU + down activation per finished 32-group ----
+    {
+      const long R = (long)a * I;
+      k2p_bounds(R, nthr, 16, std::max(1L, R / 16), k2p_split(1), k2p_bgu_);
+      const int T1 = (int)k2p_bgu_.size() - 1;
+      const long* bb = k2p_bgu_.data();
+      pool->do_work_stealing_job(
+          T1, nullptr,
+          [this, bb, I, H, G, kern, emap](int t) {
+            static thread_local std::vector<float> tmp;
+            if (tmp.size() < (size_t)2 * 9 * I) tmp.resize((size_t)2 * 9 * I);
+            long f0 = bb[t];
+            const long f1 = bb[t + 1];
+            while (f0 < f1) {
+              const int s = (int)(f0 / I), r0 = (int)(f0 % I);
+              const int r1 = (int)std::min<long>(I, r0 + (f1 - f0));
+              const int e = emap[s], m = m_local_num_[e], n = r1 - r0;
+              float* tg = tmp.data();
+              float* tu = tmp.data() + (size_t)9 * I;
+              {
+                typename T::BufferB bv = k2p_rows(*gate_bb_[e], r0, r1);
+                typename T::BufferC cv(m, n, tg);
+                avx2::gemm_mxfp4(m, n, H, *gate_up_ba_[e], bv, cv, 0, 1);
+              }
+              {
+                typename T::BufferB bv = k2p_rows(*up_bb_[e], r0, r1);
+                typename T::BufferC cv(m, n, tu);
+                avx2::gemm_mxfp4(m, n, H, *gate_up_ba_[e], bv, cv, 0, 1);
+              }
+              for (int mi = 0; mi < m; mi++) {
+                k2p_to_bf16(tg + (size_t)mi * n, this->m_local_gate_output_ptr_[e] + (size_t)mi * I + r0, n);
+                k2p_to_bf16(tu + (size_t)mi * n, this->m_local_up_output_ptr_[e] + (size_t)mi * I + r0, n);
+              }
+              for (int g = r0 / 32; g <= (r1 - 1) / 32; g++) {
+                const int covered = std::min(r1, g * 32 + 32) - std::max(r0, g * 32);
+                bool last = covered == 32;
+                if (!last)
+                  last = k2p_bcnt_[(size_t)s * G + g].fetch_add(covered, std::memory_order_acq_rel) + covered == 32;
+                if (last) k2p_bs_act_group(e, g, m, kern);
+              }
+              f0 += r1 - r0;
+            }
+          },
+          nullptr);
+    }
+    // ---- down by output-row ranges over all experts, then the weighted sum of every token for these rows ----
+    float* out = (float*)output;
+    {
+      const int U = H / 8;
+      k2p_bounds(U, nthr, 2, U, k2p_split(2), k2p_bdn_);
+      const int T2 = (int)k2p_bdn_.size() - 1;
+      const long* bd = k2p_bdn_.data();
+      pool->do_work_stealing_job(
+          T2, nullptr,
+          [this, bd, H, I, a, k, qlen, out, weights, expert_ids, emap](int t) {
+            static thread_local std::vector<float> tmp;
+            const int h0 = 8 * (int)bd[t], h1 = 8 * (int)bd[t + 1], n = h1 - h0;
+            if (n <= 0) return;
+            if (tmp.size() < (size_t)9 * H) tmp.resize((size_t)9 * H);
+            for (int s = 0; s < a; s++) {
+              const int e = emap[s], m = m_local_num_[e];
+              typename T::BufferB bv = k2p_rows(*down_bb_[e], h0, h1);
+              typename T::BufferC cv(m, n, tmp.data());
+              avx2::gemm_mxfp4(m, n, I, *down_ba_[e], bv, cv, 0, 1);
+              for (int mi = 0; mi < m; mi++)
+                k2p_to_bf16(tmp.data() + (size_t)mi * n, this->m_local_down_output_ptr_[e] + (size_t)mi * H + h0, n);
+            }
+            for (int i = 0; i < qlen; i++) {
+              for (int e8 = h0; e8 < h1; e8 += 8) {
+                __m256 x0 = _mm256_setzero_ps();
+                for (int j = 0; j < k; j++) {
+                  if (config_.should_skip_expert(expert_ids[i * k + j])) continue;
+                  __m256 weight = _mm256_set1_ps(weights[i * k + j]);
+                  __m256 d0 = avx2::load_bf16_to_fp32(this->m_local_down_output_ptr_[expert_ids[i * k + j]] +
+                                                      (size_t)this->m_local_pos_[i][j] * H + e8);
+                  x0 = _mm256_fmadd_ps(d0, weight, x0);
+                }
+                _mm256_storeu_ps(out + (size_t)i * H + e8, x0);
+              }
+              this->k2p_publish(i, h0, h1);
+            }
+          },
+          nullptr);
+    }
+    return true;
+  }
