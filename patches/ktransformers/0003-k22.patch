+  bool k2p_alloc() {
+    if (k2p_mem_ != nullptr) return true;
+    const size_t H = config_.hidden_size, I = config_.intermediate_size, G = I / 32;
+    auto al = [](size_t v) { return (v + 63) & ~(size_t)63; };
+    const size_t xa = al(T::BufferA::required_size(1, H, 32)), ha = al(T::BufferA::required_size(1, I, 32));
+    const size_t per = ha + 2 * al(I * 2) + al(H * 4) + al(H * 2);
+    const size_t cnt = al(sizeof(std::atomic<int>) * kK2PSlots * G);
+    const size_t total = xa + kK2PSlots * per + cnt;
+    k2p_mem_ = (uint8_t*)std::aligned_alloc(64, total);
+    if (k2p_mem_ == nullptr) return false;
+    std::memset(k2p_mem_, 0, total);  // first touch on the calling (part) thread -> NUMA-local
+    uint8_t* p = k2p_mem_;
+    k2p_xa_ = typename T::BufferA(1, H, 32, p);
+    p += xa;
+    for (int s = 0; s < kK2PSlots; s++) {
+      k2p_ha_[s] = typename T::BufferA(1, I, 32, p);
+      p += ha;
+      k2p_g_[s] = (ggml_bf16_t*)p;
+      p += al(I * 2);
+      k2p_u_[s] = (ggml_bf16_t*)p;
+      p += al(I * 2);
+      k2p_dt_[s] = (float*)p;
+      p += al(H * 4);
+      k2p_do_[s] = (ggml_bf16_t*)p;
+      p += al(H * 2);
+    }
+    k2p_cnt_ = (std::atomic<int>*)p;
+    for (size_t i = 0; i < kK2PSlots * G; i++) new (&k2p_cnt_[i]) std::atomic<int>(0);
+    return true;
+  }
