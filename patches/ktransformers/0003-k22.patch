diff -ruN a/kt-kernel/cpu_backend/k2eplus_env.h b/kt-kernel/cpu_backend/k2eplus_env.h
--- a/kt-kernel/cpu_backend/k2eplus_env.h	1970-01-01 01:00:00.000000000 +0100
+++ b/kt-kernel/cpu_backend/k2eplus_env.h	2026-10-18 12:44:34.826834005 +0200
@@ -0,0 +1,61 @@
+/**
+ * CPU expert optimization switches reorganize work without changing the arithmetic
+ * (outputs are bit-identical to the baseline KERN path).
+ *   KT_DS41_MU_K2EPLUS=1            all stages on (unset / 0 = legacy code paths, unchanged)
+ *   KT_DS41_MU_K2EPLUS_STAGES=<hex> diagnostics only: subset of stages (default: all)
+ * Stages (bits): 0 K6 (prefill activation permuted once per expert), 1 decode input quantized once per layer/part,
+ *   2 bs<10 prefill preparation in pool jobs, 3 SwiGLU/Q8 in the gate/up epilogue, 4 balanced tasks + down by
+ *   output rows with the weighted sum, 5 worker pool (no mutex/notify for spinning workers, _mm_pause, rare clock
+ *   reads), 6 TP merge inside the parts (last finisher of a block merges), 7 the decode scheme also for the
+ *   bs 2..9 path (forward_prefill with qlen < 10: gate/up epilogue, balanced tasks, down by rows + weighted sum).
+ * Balanced jobs use guided task sizes (KT_DS41_MU_K2EPLUS_GUIDED=0 restores equal splitting).
+ * Read once per process. No dependencies, usable from cpu_backend and operators.
+ **/
+#ifndef CPUINFER_K2EPLUS_ENV_H
+#define CPUINFER_K2EPLUS_ENV_H
+
+#include <atomic>
+#include <cstdlib>
+
+namespace k2p {
+
+enum : unsigned {
+  K6 = 1u << 0,
+  Q8ONCE = 1u << 1,
+  BSPREP = 1u << 2,
+  EPI = 1u << 3,
+  BAL = 1u << 4,
+  POOL = 1u << 5,
+  MERGE = 1u << 6,
+  BSFUSE = 1u << 7,
+  ALL = 0xFFu,
+};
+
+inline unsigned stages() {
+  static const unsigned s = [] {
+    const char* e = std::getenv("KT_DS41_MU_K2EPLUS");
+    if (e == nullptr || *e == 0 || std::atoi(e) == 0) return 0u;
+    const char* m = std::getenv("KT_DS41_MU_K2EPLUS_STAGES");
+    const unsigned v = (m != nullptr && *m != 0) ? (unsigned)std::strtoul(m, nullptr, 0) : (unsigned)ALL;  // hex ok
+    return v & (unsigned)ALL;
+  }();
+  return s;
+}
+
+inline bool on(unsigned bit) { return (stages() & bit) != 0; }
+
+// Stage 6 (MERGE): TP merge done inside the parts. Every part publishes the output rows it has finished (its fp32
+// weighted sum in y[part]); per (token, block) a counter collects the rows of ALL parts, and the thread that completes
+// a block writes out = bf16(y0 + y1 + ...) for it (same fp32 adds in part order and same bf16 rounding as
+// merge_results). Blocks nobody completed (a part took a legacy path) are covered by the legacy merge afterwards.
+struct MergeCtx {
+  void* output = nullptr;   // bf16 [qlen][hidden]
+  float* y[8] = {};         // per part fp32 [qlen][hidden]
+  int tp_count = 0, hidden = 0, qlen = 0, block = 0, nblk = 0;
+  std::atomic<int>* cnt = nullptr;  // [qlen][nblk]
+  std::atomic<int> merged{0};       // completed blocks
+};
+
+}  // namespace k2p
+
+#endif  // CPUINFER_K2EPLUS_ENV_H
