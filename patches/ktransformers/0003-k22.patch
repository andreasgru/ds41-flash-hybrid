+// Exhaustive check of the decode: every byte value at every one of the 16 positions, VAR vs legacy decode_group<0>.
+// Returns the number of differing 32-bit lanes (0 = identical).
+template <int VAR>
+static long selftest_decode() {
+  static const DConst K;
+  static const avx2kern::KConst L;
+  long bad = 0;
+  alignas(16) uint8_t buf[16];
+  for (int pos = 0; pos < 16; pos++) {
+    for (int val = 0; val < 256; val++) {
+      for (int i = 0; i < 16; i++) buf[i] = (uint8_t)((i * 37 + 11) & 0xFF);
+      buf[pos] = (uint8_t)val;
+      __m256 a0, a1, a2, a3, b0, b1, b2, b3;
+      decode<VAR>(buf, K, a0, a1, a2, a3);
+      avx2kern::decode_group<0>(buf, L, b0, b1, b2, b3);
+      const __m256 av[4] = {a0, a1, a2, a3}, bv[4] = {b0, b1, b2, b3};
+      for (int q = 0; q < 4; q++) {
+        alignas(32) uint32_t x[8], y[8];
+        _mm256_store_si256((__m256i*)x, _mm256_castps_si256(av[q]));
+        _mm256_store_si256((__m256i*)y, _mm256_castps_si256(bv[q]));
+        for (int l = 0; l < 8; l++) bad += x[l] != y[l];
+      }
+    }
+  }
+  return bad;
+}
