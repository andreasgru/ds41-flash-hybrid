+  static inline void k2p_to_bf16(const float* src, ggml_bf16_t* dst, int n) {
+    int j = 0;
+    for (; j + 8 <= n; j += 8) avx2::store_fp32_to_bf16(dst + j, _mm256_loadu_ps(src + j));
+    for (; j < n; j++) {  // same integer rounding as store_fp32_to_bf16 (lane-wise), also for NaN
+      uint32_t u;
+      std::memcpy(&u, src + j, 4);
+      dst[j].bits = (uint16_t)((u + 0x7FFFu + ((u >> 16) & 1u)) >> 16);
+    }
+  }
+  static inline typename T::BufferB k2p_rows(const typename T::BufferB& b, int r0, int r1) {
+    typename T::BufferB v = b;
+    const size_t G = (size_t)b.k_group_count;
+    v.b = b.b + (size_t)r0 * ((size_t)b.k / 2);
+    v.d = b.d + (size_t)r0 * G;
+    v.e8 = b.e8 != nullptr ? b.e8 + (size_t)r0 * G : nullptr;
+    v.n = r1 - r0;
+    return v;
+  }
