+  // gate + up rows [r0, r1) of slot s (expert e), bf16 store, then SwiGLU/down-prep for every 32-group completed now.
+  inline void k2p_gu_rows(int s, int e, int r0, int r1, int kern, float* tg, float* tu) {
+    const int H = config_.hidden_size, n = r1 - r0;
+    {
+      typename T::BufferB bv = k2p_rows(*gate_bb_[e], r0, r1);
+      typename T::BufferC cv(1, n, tg);
+      avx2::gemm_mxfp4(1, n, H, k2p_xa_, bv, cv, 0, 1);
+    }
+    {
+      typename T::BufferB bv = k2p_rows(*up_bb_[e], r0, r1);
+      typename T::BufferC cv(1, n, tu);
+      avx2::gemm_mxfp4(1, n, H, k2p_xa_, bv, cv, 0, 1);
+    }
+    k2p_to_bf16(tg, k2p_g_[s] + r0, n);
+    k2p_to_bf16(tu, k2p_u_[s] + r0, n);
+    const int G = config_.intermediate_size / 32;
+    for (int g = r0 / 32; g <= (r1 - 1) / 32; g++) {
+      const int covered = std::min(r1, g * 32 + 32) - std::max(r0, g * 32);
+      bool last = covered == 32;
+      if (!last) last = k2p_cnt_[(size_t)s * G + g].fetch_add(covered, std::memory_order_acq_rel) + covered == 32;
+      if (last) k2p_act_group(s, g, kern);
+    }
+  }
