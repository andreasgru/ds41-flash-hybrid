diff -ruN a/kt-kernel/operators/avx2/mxfp4-kernel.hpp b/kt-kernel/operators/avx2/mxfp4-kernel.hpp
--- a/kt-kernel/operators/avx2/mxfp4-kernel.hpp	1970-01-01 01:00:00.000000000 +0100
+++ b/kt-kernel/operators/avx2/mxfp4-kernel.hpp	2026-10-03 13:31:08.229047358 +0200
@@ -0,0 +1,363 @@
+/**
+ * @Description: AVX2 MXFP4 single-row decode GEMV kernel for Zen 2.
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * KT_DS41_MU_MXFP4_KERNEL=1: exact path. Per output row the arithmetic is IDENTICAL to the legacy single-row
+ * loop in gemm_mxfp4 (group_size 32): same FP4 -> fp32 values, same column -> lane mapping
+ * (w0 = cols {0,2,4,6|1,3,5,7}, w1 = {8..14|9..15}, w2, w3), same MUL/FMA order inside a group, same
+ * even/odd group accumulators, same hsum. Output is therefore bit-identical for every input.
+ * Differences are only in HOW the values are produced / scheduled:
+ *   - activation permuted once per expert (even/odd split per 8, no shuffles) instead of once per task,
+ *   - several output rows interleaved (independent dependency chains for the out-of-order core),
+ *   - cheaper decode: byte permutation + AND/shift widening instead of 4 x unpack16 (DEC=1/2).
+ **/
+#ifndef CPUINFER_OPERATOR_AVX2_MXFP4_KERN_H
+#define CPUINFER_OPERATOR_AVX2_MXFP4_KERN_H
+
+#include <immintrin.h>
+
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+#include "avx2_bf16_utils.hpp"
+
+namespace avx2kern {
+
+// Env switches, read once per process.
+static inline int env_int(const char* name, int dflt) {
+  const char* s = std::getenv(name);
+  return (s && *s) ? std::atoi(s) : dflt;
+}
+static inline int kern_mode() {
+  static const int m = env_int("KT_DS41_MU_MXFP4_KERNEL", 0);
+  return m;
+}
+// Compact E8M0 copy of the group scales, used only by the KERN path (requires KT_DS41_MU_MXFP4_KERNEL >= 1).
+static inline bool e8m0_mode() {
+  static const bool m = env_int("KT_DS41_MU_MXFP4_E8M0", 0) != 0;
+  return m;
+}
+
+// FP4 E2M1 -> BF16 byte tables (identical to GemmKernelAVX2MXFP4::fp4_bf16_lo/hi)
+alignas(16) static constexpr uint8_t kLutLo[16] = {0x00, 0x00, 0x80, 0xC0, 0x00, 0x40, 0x80, 0xC0,
+                                                   0x00, 0x00, 0x80, 0xC0, 0x00, 0x40, 0x80, 0xC0};
+alignas(16) static constexpr uint8_t kLutHi[16] = {0x00, 0x3F, 0x3F, 0x3F, 0x40, 0x40, 0x40, 0x40,
+                                                   0x80, 0xBF, 0xBF, 0xBF, 0xC0, 0xC0, 0xC0, 0xC0};
+// Byte permutation so that the even/odd word split after unpack8 reproduces the legacy lane mapping.
+alignas(32) static constexpr uint8_t kBytePerm[32] = {0, 4, 1, 5, 2, 6, 3, 7, 8, 12, 9, 13, 10, 14, 11, 15,
+                                                      0, 4, 1, 5, 2, 6, 3, 7, 8, 12, 9, 13, 10, 14, 11, 15};
+
+// BF16 activation -> FP32 in the legacy kGroupPerm order ({0,2,4,6,1,3,5,7} per 8). k % 8 == 0.
+static inline void permute_act_bf16(const ggml_bf16_t* src, float* dst, int k) {
+  const __m256i hm = _mm256_set1_epi32((int)0xFFFF0000u);
+  int i = 0;
+  for (; i + 16 <= k; i += 16) {
+    __m256i x = _mm256_loadu_si256((const __m256i*)(src + i));
+    __m256i ev = _mm256_slli_epi32(x, 16);  // lanes: src 0,2,4,6 | 8,10,12,14
+    __m256i od = _mm256_and_si256(x, hm);   // lanes: src 1,3,5,7 | 9,11,13,15
+    _mm_storeu_si128((__m128i*)(dst + i), _mm256_castsi256_si128(ev));
+    _mm_storeu_si128((__m128i*)(dst + i + 4), _mm256_castsi256_si128(od));
+    _mm_storeu_si128((__m128i*)(dst + i + 8), _mm256_extracti128_si256(ev, 1));
+    _mm_storeu_si128((__m128i*)(dst + i + 12), _mm256_extracti128_si256(od, 1));
+  }
+  for (; i + 8 <= k; i += 8) {
+    __m128i x = _mm_loadu_si128((const __m128i*)(src + i));
+    _mm_storeu_si128((__m128i*)(dst + i), _mm_slli_epi32(x, 16));
+    _mm_storeu_si128((__m128i*)(dst + i + 4), _mm_and_si128(x, _mm256_castsi256_si128(hm)));
+  }
+}
+
+struct KConst {
+  __m256i lutlo, luthi, nib, zero, himask, perm256;
+  __m128i nib128, perm128;
+  KConst() {
+    const __m128i lo = _mm_load_si128((const __m128i*)kLutLo);
+    const __m128i hi = _mm_load_si128((const __m128i*)kLutHi);
+    lutlo = _mm256_broadcastsi128_si256(lo);
+    luthi = _mm256_broadcastsi128_si256(hi);
+    nib = _mm256_set1_epi8(0x0F);
+    nib128 = _mm_set1_epi8(0x0F);
+    zero = _mm256_setzero_si256();
+    himask = _mm256_set1_epi32((int)0xFFFF0000u);
+    perm256 = _mm256_load_si256((const __m256i*)kBytePerm);
+    perm128 = _mm256_castsi256_si128(perm256);
+  }
+};
+
+// Decode one 32-value group at p into w0..w3 (legacy lane mapping). DEC selects the method.
+template <int DEC>
+static __attribute__((always_inline)) inline void decode_group(const uint8_t* p, const KConst& K, __m256& w0, __m256& w1,
+                                                                 __m256& w2, __m256& w3) {
+  if constexpr (DEC == 0) {  // legacy: 9 shuffles
+    const __m128i raw = _mm_loadu_si128((const __m128i*)p);
+    const __m128i lo = _mm_and_si128(raw, K.nib128);
+    const __m128i hi = _mm_and_si128(_mm_srli_epi16(raw, 4), K.nib128);
+    const __m256i v = _mm256_set_m128i(hi, lo);
+    const __m256i bl = _mm256_shuffle_epi8(K.lutlo, v);
+    const __m256i bh = _mm256_shuffle_epi8(K.luthi, v);
+    const __m256i ua = _mm256_unpacklo_epi8(bl, bh);
+    const __m256i ub = _mm256_unpackhi_epi8(bl, bh);
+    w0 = _mm256_castsi256_ps(_mm256_unpacklo_epi16(K.zero, ua));
+    w1 = _mm256_castsi256_ps(_mm256_unpackhi_epi16(K.zero, ua));
+    w2 = _mm256_castsi256_ps(_mm256_unpacklo_epi16(K.zero, ub));
+    w3 = _mm256_castsi256_ps(_mm256_unpackhi_epi16(K.zero, ub));
+  } else {
+    __m256i v;
+    if constexpr (DEC == 1) {  // xmm byte permutation + vinserti128: 6 shuffles
+      const __m128i raw = _mm_shuffle_epi8(_mm_loadu_si128((const __m128i*)p), K.perm128);
+      const __m128i lo = _mm_and_si128(raw, K.nib128);
+      const __m128i hi = _mm_and_si128(_mm_srli_epi16(raw, 4), K.nib128);
+      v = _mm256_set_m128i(hi, lo);
+    } else {  // DEC == 2: broadcast load + blend (no insert), permutation on the index vector: 5 shuffles
+      const __m256i r = _mm256_broadcastsi128_si256(_mm_loadu_si128((const __m128i*)p));
+      const __m256i t = _mm256_blend_epi32(r, _mm256_srli_epi16(r, 4), 0xF0);
+      v = _mm256_shuffle_epi8(_mm256_and_si256(t, K.nib), K.perm256);
+    }
+    const __m256i bl = _mm256_shuffle_epi8(K.lutlo, v);
+    const __m256i bh = _mm256_shuffle_epi8(K.luthi, v);
+    const __m256i ua = _mm256_unpacklo_epi8(bl, bh);
+    const __m256i ub = _mm256_unpackhi_epi8(bl, bh);
+    w0 = _mm256_castsi256_ps(_mm256_slli_epi32(ua, 16));
+    w1 = _mm256_castsi256_ps(_mm256_and_si256(ua, K.himask));
+    w2 = _mm256_castsi256_ps(_mm256_slli_epi32(ub, 16));
+    w3 = _mm256_castsi256_ps(_mm256_and_si256(ub, K.himask));
+  }
+}
+
+// Exact m = 1 GEMV over rows [n0, n1): c[ni] = row(ni) . a  (legacy arithmetic per row).
+//   ap : activation, fp32, legacy-permuted (permute_act_bf16), length k
+//   b  : nibble rows, k/2 bytes each;  d : fp32 group scales, k/32 per row
+//   ROWS rows are processed together (independent chains), PFD = software prefetch distance (bytes, 0 = off)
+template <int ROWS, int DEC, int PFD>
+static void gemv_exact(const float* __restrict ap, const uint8_t* __restrict b, const float* __restrict d, int k, int n0,
+                       int n1, float* __restrict c) {
+  static const KConst K;
+  const int G = k / 32;
+  const size_t rb = (size_t)k / 2;
+  int ni = n0;
+  for (; ni + ROWS <= n1; ni += ROWS) {
+    const uint8_t* br[ROWS];
+    const float* sr[ROWS];
+    __m256 t0[ROWS], t1[ROWS];
+#pragma GCC unroll 8
+    for (int r = 0; r < ROWS; r++) {
+      br[r] = b + (size_t)(ni + r) * rb;
+      sr[r] = d + (size_t)(ni + r) * G;
+      t0[r] = _mm256_setzero_ps();
+      t1[r] = _mm256_setzero_ps();
+    }
+    auto step = [&](int g, __m256* tacc) __attribute__((always_inline)) {
+      const float* a = ap + (size_t)g * 32;
+      const __m256 a0 = _mm256_loadu_ps(a), a1 = _mm256_loadu_ps(a + 8);
+      const __m256 a2 = _mm256_loadu_ps(a + 16), a3 = _mm256_loadu_ps(a + 24);
+#pragma GCC unroll 8
+      for (int r = 0; r < ROWS; r++) {
+        if constexpr (PFD > 0) {
+          if ((g & 3) == 0) _mm_prefetch((const char*)(br[r] + (size_t)g * 16 + PFD), _MM_HINT_T0);
+          if ((g & 15) == 0) _mm_prefetch((const char*)(sr[r] + g + PFD / 4), _MM_HINT_T0);
+        }
+        __m256 w0, w1, w2, w3;
+        decode_group<DEC>(br[r] + (size_t)g * 16, K, w0, w1, w2, w3);
+        __m256 gacc = _mm256_mul_ps(a0, w0);
+        gacc = _mm256_fmadd_ps(a1, w1, gacc);
+        gacc = _mm256_fmadd_ps(a2, w2, gacc);
+        gacc = _mm256_fmadd_ps(a3, w3, gacc);
+        tacc[r] = _mm256_fmadd_ps(gacc, _mm256_broadcast_ss(sr[r] + g), tacc[r]);
+      }
+    };
+    int g = 0;
+    for (; g + 2 <= G; g += 2) {
+      step(g, t0);
+      step(g + 1, t1);
+    }
+    if (g < G) step(g, t0);
+#pragma GCC unroll 8
+    for (int r = 0; r < ROWS; r++) c[ni + r] = avx2::hsum_avx2(_mm256_add_ps(t0[r], t1[r]));
+  }
+  if constexpr (ROWS > 1) {
+    if (ni < n1) gemv_exact<1, DEC, PFD>(ap, b, d, k, ni, n1, c);
+  }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Production kernel: M activation rows (M = 1..3) against weight rows [n0, n1), one weight row at a time,
+// legacy decode (DEC 0), no software prefetch (measured best cold on Zen 2, Block 3).
+// Scales: fp32 (E8 = false, d = float*) or e8m0 exponent bytes (E8 = true, d = uint8_t*, value 2^(e-127)
+// from a table -> the very same fp32 value, so the result stays bit-identical).
+// Per (row, activation) the arithmetic equals the legacy single-row loop of gemm_mxfp4 (used there for m <= 3).
+//   ap : M activation rows, each k fp32 in legacy permuted order, row stride ap_stride
+//   c  : output, c[mi * c_stride + ni]
+struct E8Tab {
+  alignas(64) float v[256];
+  E8Tab() {
+    for (int e = 0; e < 255; e++) {
+      uint32_t bits = e == 0 ? 0x00400000u : ((uint32_t)e << 23);  // e = 0 -> 2^-127 (subnormal), exact
+      std::memcpy(&v[e], &bits, 4);
+    }
+    uint32_t nan = 0x7FC00000u;
+    std::memcpy(&v[255], &nan, 4);
+  }
+};
+static inline const float* e8_table() {
+  static const E8Tab t;
+  return t.v;
+}
+
+template <int M, bool E8>
+static void gemv_m(const float* __restrict ap, size_t ap_stride, const uint8_t* __restrict b, const void* __restrict dv,
+                   int k, int n0, int n1, float* __restrict c, size_t c_stride) {
+  static const KConst K;
+  const float* e8 = e8_table();
+  const int G = k / 32;
+  const size_t rb = (size_t)k / 2;
+  for (int ni = n0; ni < n1; ni++) {
+    const uint8_t* br = b + (size_t)ni * rb;
+    const float* sf = E8 ? nullptr : (const float*)dv + (size_t)ni * G;
+    const uint8_t* se = E8 ? (const uint8_t*)dv + (size_t)ni * G : nullptr;
+    __m256 t0[M], t1[M];
+#pragma GCC unroll 4
+    for (int mi = 0; mi < M; mi++) t0[mi] = t1[mi] = _mm256_setzero_ps();
+    auto step = [&](int g, __m256* tacc) __attribute__((always_inline)) {
+      __m256 w0, w1, w2, w3;
+      decode_group<0>(br + (size_t)g * 16, K, w0, w1, w2, w3);
+      const __m256 sv = E8 ? _mm256_broadcast_ss(e8 + se[g]) : _mm256_broadcast_ss(sf + g);
+#pragma GCC unroll 4
+      for (int mi = 0; mi < M; mi++) {
+        const float* a = ap + mi * ap_stride + (size_t)g * 32;
+        __m256 gacc = _mm256_mul_ps(_mm256_loadu_ps(a), w0);
+        gacc = _mm256_fmadd_ps(_mm256_loadu_ps(a + 8), w1, gacc);
+        gacc = _mm256_fmadd_ps(_mm256_loadu_ps(a + 16), w2, gacc);
+        gacc = _mm256_fmadd_ps(_mm256_loadu_ps(a + 24), w3, gacc);
+        tacc[mi] = _mm256_fmadd_ps(gacc, sv, tacc[mi]);
+      }
+    };
+    int g = 0;
+    for (; g + 2 <= G; g += 2) {
+      step(g, t0);
+      step(g + 1, t1);
+    }
+    if (g < G) step(g, t0);
+#pragma GCC unroll 4
+    for (int mi = 0; mi < M; mi++) c[mi * c_stride + ni] = avx2::hsum_avx2(_mm256_add_ps(t0[mi], t1[mi]));
+  }
+}
+
+// e8m0 exponent byte of an exact power-of-two fp32 scale, or -1 if not representable (fallback fp32).
+static inline int f32_to_e8m0_exact(float f) {
+  uint32_t u;
+  std::memcpy(&u, &f, 4);
+  if (u == 0x00400000u) return 0;                    // 2^-127
+  if ((u & 0x807FFFFFu) != 0) return -1;             // sign or mantissa bits set, subnormal other than 2^-127
+  const int e = (int)(u >> 23);
+  if (e == 0 || e == 255) return -1;                 // zero / inf / nan
+  return e;
+}
