diff -ruN a/kt-kernel/cpu_backend/defer_split.h b/kt-kernel/cpu_backend/defer_split.h
--- a/kt-kernel/cpu_backend/defer_split.h	1970-01-01 01:00:00.000000000 +0100
+++ b/kt-kernel/cpu_backend/defer_split.h	2026-10-03 13:31:08.228234941 +0200
@@ -0,0 +1,70 @@
+/**
+ * Deferral split (KT_DS41_MU_DEFER_MHC): divide the routed top-k of one MoE call into the part that the
+ * CPU computes immediately and the part that is deferred behind the attention of the next layer.
+ *
+ * mode 0 ("all", same rule as BaseMoEWrapper.select_deferred_experts, experts_base.py:388-416):
+ *   per token the (k - d) largest weights are protected; an expert id is protected for the whole call as soon as it
+ *   is protected for ANY token (union over tokens, like protected_flag); every (t, j) whose id is protected stays
+ *   immediate, the rest is deferred. GPU experts may land in `def`; the CPU skips them anyway (should_skip_expert).
+ * mode 1 ("cpu"): like mode 0, but ranking and protection only among the CPU experts of each token (gpu_mask[id] == 0);
+ *   GPU experts always stay immediate (the GPU computes them regardless). Needs gpu_mask.
+ * Ties in the weights: the smaller position j wins protection (deterministic; torch.topk leaves the order open).
+ * Invalid ids (< 0 or >= expert_num) are -1 in both outputs.
+ * Returns the number of deferred (t, j) entries that are CPU experts (gpu_mask == nullptr: all valid deferred ids);
+ * 0 means the deferred call would compute nothing, the caller may zero the output instead.
+ * No CUDA, no allocation except the scratch vector (reused by the caller).
+ */
+#ifndef CPUINFER_DEFER_SPLIT_H
+#define CPUINFER_DEFER_SPLIT_H
+
+#include <cstdint>
+#include <vector>
+
+inline int defer_split(const int64_t* ids, const float* weights, int qlen, int k, int d, int mode, const uint8_t* gpu_mask,
+                       int expert_num, int64_t* imm, int64_t* def, std::vector<uint8_t>& flag) {
+  if (d < 0) d = 0;
+  if (d > k) d = k;
+  flag.assign((size_t)expert_num, 0);
+  auto valid = [&](int64_t e) { return e >= 0 && e < expert_num; };
+  auto is_gpu = [&](int64_t e) { return gpu_mask != nullptr && gpu_mask[e] != 0; };
+  // 1) protection flags (union over tokens)
+  for (int t = 0; t < qlen; ++t) {
+    const int64_t* id = ids + (size_t)t * k;
+    const float* w = weights + (size_t)t * k;
+    int n_cand = 0;
+    for (int j = 0; j < k; ++j)
+      if (valid(id[j]) && (mode == 0 || !is_gpu(id[j]))) ++n_cand;
+    const int keep = n_cand - d;  // protected candidates of this token
+    if (keep <= 0) continue;
+    for (int j = 0; j < k; ++j) {
+      if (!valid(id[j]) || (mode != 0 && is_gpu(id[j]))) continue;
+      // rank of candidate j: number of candidates that beat it (larger weight, or equal weight and smaller position)
+      int rank = 0;
+      for (int m = 0; m < k; ++m) {
+        if (m == j || !valid(id[m]) || (mode != 0 && is_gpu(id[m]))) continue;
+        if (w[m] > w[j] || (w[m] == w[j] && m < j)) ++rank;
+      }
+      if (rank < keep) flag[(size_t)id[j]] = 1;
+    }
+  }
+  // 2) split
+  int n_def_cpu = 0;
+  for (int t = 0; t < qlen; ++t) {
+    for (int j = 0; j < k; ++j) {
+      const size_t p = (size_t)t * k + j;
+      const int64_t e = ids[p];
+      if (!valid(e)) {
+        imm[p] = -1;
+        def[p] = -1;
+        continue;
+      }
+      const bool prot = flag[(size_t)e] != 0 || (mode != 0 && is_gpu(e));
+      imm[p] = prot ? e : -1;
+      def[p] = prot ? -1 : e;
+      if (!prot && !is_gpu(e)) ++n_def_cpu;
+    }
+  }
+  return n_def_cpu;
+}
+
+#endif  // CPUINFER_DEFER_SPLIT_H
diff -ruN a/kt-kernel/cpu_backend/doorbell_core.h b/kt-kernel/cpu_backend/doorbell_core.h
--- a/kt-kernel/cpu_backend/doorbell_core.h	1970-01-01 01:00:00.000000000 +0100
+++ b/kt-kernel/cpu_backend/doorbell_core.h	2026-10-03 13:31:08.228406285 +0200
@@ -0,0 +1,282 @@
+/**
+ * CB-JOIN poller core: CUDA-free part of DoorbellJoin; protocol state uses
+ * plain host flags and the MoE interface.
+ *
+ * Shared doorbell protocol:
+ *   index j = layer + 64 * half (half 1 = second micro-batch), flags go[j] / done[j] / ddone[j] / arrived[j],
+ *   go value = (d << 20) | (buf_id + 1), d = number of deferred experts (0 preserves existing CB-JOIN behavior bit-for-bit).
+ * Poller: immediate jobs first, in the fixed order of positions p = 2*(j mod 64) + (j div 64) starting after the last
+ *   finished job (A_L before B_L before A_{L+1}); after an immediate job with d > 0 its deferred part is queued (FIFO)
+ *   and runs only while no go is set. Deadlock-free: the poller never waits for the stream, and every flag the stream
+ *   waits for belongs to a job posted earlier on the same stream.
+ * Deferred part: defer_split() on the ids/weights of the buffer (same rule as select_deferred_experts), then
+ *   forward(imm ids -> output), done = 1, and later forward(def ids -> def_output) or zero-fill, ddone = 1.
+ */
+#ifndef CPUINFER_DOORBELL_CORE_H
+#define CPUINFER_DOORBELL_CORE_H
+
+#include <immintrin.h>
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <exception>
+#include <memory>
+#include <stdexcept>
+#include <vector>
+
+#include "defer_split.h"
+
+struct alignas(64) DoorbellFlag {
+  volatile uint32_t v;
+  uint32_t pad[15];
+};
+
+template <class Moe>
+class DoorbellCore {
+ public:
+  static constexpr int kHalfStride = 64;
+  static constexpr uint32_t kBufMask = (1u << 20) - 1;
+
+  struct Buf {
+    const int* qlen;
+    int k;
+    const int64_t* ids;
+    const float* weights;
+    const void* input;
+    void* output;
+    void* def_output;  // nullptr: this buffer cannot take deferred jobs
+    int def_row_bytes;  // bytes per token of def_output (hidden * sizeof(bf16)); zero-fill size
+  };
+  struct DeferStats {
+    uint64_t runs = 0, zero = 0, cpu_experts = 0, busy_ns = 0, late = 0;
+  };
+
+  DoorbellCore(int max_layers, int max_bufs, DoorbellFlag* go, DoorbellFlag* done, DoorbellFlag* ddone,
+               DoorbellFlag* arrived, int defer_mode)
+      : max_layers_(max_layers), max_bufs_(max_bufs), go_(go), done_(done), ddone_(ddone), arrived_(arrived),
+        defer_mode_(defer_mode) {
+    if (max_layers <= 0 || max_layers > 2 * kHalfStride || max_bufs <= 0) throw std::invalid_argument("CB-JOIN: sizes");
+    for (int l = 0; l < max_layers_; ++l) go_[l].v = done_[l].v = ddone_[l].v = 0;
+    if (arrived_) for (int l = 0; l < max_layers_; ++l) arrived_[l].v = 0;
+    layers_.resize(max_layers_);
+    echo_.assign(max_layers_, 0);
+    gpu_mask_.assign(max_layers_, nullptr);
+    expert_num_.assign(max_layers_, 0);
+    def_ids_.resize(max_layers_);
+    bufs_.resize(max_bufs_);
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+  }
+
+  static int pos_of(int j) { return 2 * (j % kHalfStride) + j / kHalfStride; }
+  static int idx_of(int p) { return p / 2 + kHalfStride * (p % 2); }
+
+  void check_layer(int j) const {
+    if (j < 0 || j >= max_layers_) throw std::out_of_range("CB-JOIN: layer out of range");
+  }
+
+  void register_layer(int j, std::shared_ptr<Moe> moe, const uint8_t* gpu_mask, int expert_num) {
+    check_layer(j);
+    if (!moe) throw std::invalid_argument("CB-JOIN: null MoE");
+    layers_[j] = moe;
+    gpu_mask_[j] = gpu_mask;
+    expert_num_[j] = expert_num;
+    publish(j);
+  }
+  void register_echo_layer(int j) {
+    check_layer(j);
+    echo_[j] = 1;
+    publish(j);
+  }
+
+  int register_buffer(const int* qlen, int k, const int64_t* ids, const float* weights, const void* input, void* output,
+                      void* def_output, int def_row_bytes) {
+    int id = n_bufs_.load(std::memory_order_relaxed);
+    if (id >= max_bufs_ || id >= (int)kBufMask) {
+      fprintf(stderr, "[CB-JOIN] FATAL: buffer table full (%d entries)\n", max_bufs_);
+      throw std::runtime_error("CB-JOIN: buffer table full");
+    }
+    bufs_[id] = Buf{qlen, k, ids, weights, input, output, def_output, def_row_bytes};
+    const int n = id + 1;
+    n_bufs_.store(n, std::memory_order_release);
+    if ((n & (n - 1)) == 0) {
+      printf("[CB-JOIN] buffer table: n_bufs=%d/%d\n", n, max_bufs_);
+      fflush(stdout);
+    }
+    if (n == max_bufs_ / 2 || n == (int)((long long)max_bufs_ * 9 / 10)) {
+      fprintf(stderr, "[CB-JOIN] WARNING: buffer table at %d%% (n_bufs=%d/%d)\n", n == max_bufs_ / 2 ? 50 : 90, n,
+              max_bufs_);
+      fflush(stderr);
+    }
+    return id;
+  }
+  int n_bufs() const { return n_bufs_.load(std::memory_order_acquire); }
+  int max_bufs() const { return max_bufs_; }
+  uint64_t tasks() const { return tasks_.load(std::memory_order_relaxed); }
+  uint64_t busy_ns() const { return busy_ns_.load(std::memory_order_relaxed); }
+  DeferStats defer_stats() const {
+    DeferStats s;
+    s.runs = d_runs_.load(std::memory_order_relaxed);
+    s.zero = d_zero_.load(std::memory_order_relaxed);
+    s.cpu_experts = d_cpu_.load(std::memory_order_relaxed);
+    s.busy_ns = d_ns_.load(std::memory_order_relaxed);
+    s.late = d_late_.load(std::memory_order_relaxed);
+    return s;
+  }
+
+  // One poller step. Returns true if a job ran.
+  bool poll_once() {
+    const int np = max_pos_.load(std::memory_order_acquire);
+    for (int s = 0; s < np; ++s) {
+      const int p = (next_p_ + s) % np;
+      const int j = idx_of(p);
+      if (j >= max_layers_ || !active_[j].load(std::memory_order_acquire)) continue;
+      const uint32_t v = go_[j].v;
+      if (v == 0) continue;
+      go_[j].v = 0;  // re-armed before done=1, so the next go cannot be lost
+      std::atomic_thread_fence(std::memory_order_acquire);
+      run_immediate(j, (v & kBufMask) - 1, (int)(v >> 20));
+      next_p_ = (p + 1) % np;
+      return true;
+    }
+    if (!defq_.empty()) {
+      const DefEntry e = defq_.front();
+      defq_.pop_front();
+      run_deferred(e);
+      return true;
+    }
+    return false;
+  }
+
+ private:
+  struct DefEntry {
+    int j;
+    uint32_t buf;
+    int qlen;
+    int n_cpu;
+  };
+
+  void publish(int j) {
+    active_[j].store(1, std::memory_order_release);
+    const int p1 = pos_of(j) + 1;
+    int prev = max_pos_.load(std::memory_order_relaxed);
+    while (p1 > prev && !max_pos_.compare_exchange_weak(prev, p1, std::memory_order_release)) {
+    }
+  }
+
+  Moe* moe_or_die(int j, uint32_t buf) {
+    Moe* moe = layers_[j].get();
+    if (moe == nullptr || (int)buf >= n_bufs_.load(std::memory_order_acquire)) {
+      fprintf(stderr, "[CB-JOIN] FATAL: go for layer %d with moe=%p buf=%u\n", j, (void*)moe, buf);
+      std::abort();  // a hang in cuStreamWaitValue32 would be worse than a crash
+    }
+    return moe;
+  }
+
+  template <class F>
+  void guarded(int j, const char* what, F&& f) {
+    try {
+      f();
+    } catch (const std::exception& ex) {
+      fprintf(stderr, "[CB-JOIN] FATAL: layer %d %s threw: %s\n", j, what, ex.what());
+      std::abort();
+    } catch (...) {
+      fprintf(stderr, "[CB-JOIN] FATAL: layer %d %s threw\n", j, what);
+      std::abort();
+    }
+  }
+
+  void signal(DoorbellFlag* f, int j) {
+    std::atomic_thread_fence(std::memory_order_release);
+    _mm_sfence();
+    f[j].v = 1;
+  }
+
+  void run_immediate(int j, uint32_t buf, int d) {
+    if (echo_[j]) {
+      tasks_.fetch_add(1, std::memory_order_relaxed);
+      signal(done_, j);
+      if (d > 0) signal(ddone_, j);
+      return;
+    }
+    Moe* moe = moe_or_die(j, buf);
+    const Buf& b = bufs_[buf];
+    auto t0 = std::chrono::steady_clock::now();
+    if (d == 0) {
+      // Existing path, unchanged: same call, same arrays
+      guarded(j, "forward", [&] { moe->forward(*b.qlen, b.k, b.ids, b.weights, b.input, b.output, false); });
+    } else {
+      if (b.def_output == nullptr) {
+        fprintf(stderr, "[CB-JOIN] FATAL: deferred go for layer %d on buffer %u without def_output\n", j, buf);
+        std::abort();
+      }
+      if (expert_num_[j] <= 0) {
+        fprintf(stderr, "[CB-JOIN] FATAL: deferred go for layer %d without expert_num (register_layer)\n", j);
+        std::abort();
+      }
+      const int qlen = *b.qlen;
+      const size_t n = (size_t)qlen * b.k;
+      imm_ids_.resize(n);
+      def_ids_[j].resize(n);
+      const int n_cpu = defer_split(b.ids, b.weights, qlen, b.k, d, defer_mode_, gpu_mask_[j], expert_num_[j],
+                                    imm_ids_.data(), def_ids_[j].data(), flag_);
+      guarded(j, "forward(imm)", [&] { moe->forward(qlen, b.k, imm_ids_.data(), b.weights, b.input, b.output, false); });
+      defq_.push_back(DefEntry{j, buf, qlen, n_cpu});
+    }
+    busy_ns_.fetch_add(ns_since(t0), std::memory_order_relaxed);
+    tasks_.fetch_add(1, std::memory_order_relaxed);
+    signal(done_, j);
+  }
+
+  void run_deferred(const DefEntry& e) {
+    const Buf& b = bufs_[e.buf];
+    auto t0 = std::chrono::steady_clock::now();
+    if (e.n_cpu == 0) {
+      std::memset(b.def_output, 0, (size_t)e.qlen * (size_t)b.def_row_bytes);
+      d_zero_.fetch_add(1, std::memory_order_relaxed);
+    } else {
+      Moe* moe = moe_or_die(e.j, e.buf);
+      guarded(e.j, "forward(def)",
+              [&] { moe->forward(e.qlen, b.k, def_ids_[e.j].data(), b.weights, b.input, b.def_output, false); });
+    }
+    d_ns_.fetch_add(ns_since(t0), std::memory_order_relaxed);
+    d_runs_.fetch_add(1, std::memory_order_relaxed);
+    d_cpu_.fetch_add((uint64_t)e.n_cpu, std::memory_order_relaxed);
+    if (arrived_ && arrived_[e.j].v != 0) d_late_.fetch_add(1, std::memory_order_relaxed);  // stream already waiting
+    signal(ddone_, e.j);
+  }
+
+  static uint64_t ns_since(std::chrono::steady_clock::time_point t0) {
+    return (uint64_t)std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0)
+        .count();
+  }
+
+  const int max_layers_;
+  const int max_bufs_;
+  DoorbellFlag* go_;
+  DoorbellFlag* done_;
+  DoorbellFlag* ddone_;
+  DoorbellFlag* arrived_;
+  const int defer_mode_;
+  std::vector<std::shared_ptr<Moe>> layers_;
+  std::vector<const uint8_t*> gpu_mask_;
+  std::vector<int> expert_num_;
+  std::vector<int> echo_;
+  std::vector<Buf> bufs_;
+  std::atomic<int> active_[2 * kHalfStride] = {};
+  std::atomic<int> max_pos_{0};
+  std::atomic<int> n_bufs_{0};
+  int next_p_ = 0;
+  std::deque<DefEntry> defq_;
+  std::vector<int64_t> imm_ids_;
+  std::vector<std::vector<int64_t>> def_ids_;
+  std::vector<uint8_t> flag_;
+  std::atomic<uint64_t> tasks_{0}, busy_ns_{0};
+  std::atomic<uint64_t> d_runs_{0}, d_zero_{0}, d_cpu_{0}, d_ns_{0}, d_late_{0};
+};
+
+#endif  // CPUINFER_DOORBELL_CORE_H
diff -ruN a/kt-kernel/cpu_backend/doorbell_join.h b/kt-kernel/cpu_backend/doorbell_join.h
--- a/kt-kernel/cpu_backend/doorbell_join.h	1970-01-01 01:00:00.000000000 +0100
+++ b/kt-kernel/cpu_backend/doorbell_join.h	2026-10-03 13:31:08.228318613 +0200
@@ -0,0 +1,234 @@
+/**
+ * CB-JOIN: CPU<->GPU join per MoE layer without
+ * cudaLaunchHostFunc.
+ *
+ * The stock path puts two host nodes per layer on the stream
+ * (CPUInfer::submit_with_cuda_stream / sync_with_cuda_stream). Each one goes
+ * through the CUDA driver's callback thread, and the task hand-off adds two
+ * condition-variable wake-ups (TaskQueue::enqueue -> worker, worker ->
+ * sync_ callback). Decode is layer-serial, so all of that sits on the critical
+ * path 40 times per token.
+ *
+ * Here the stream itself signals and waits through stream memory operations on
+ * mapped pinned flags (one cache line per flag):
+ *   submit(l, buf): WriteValue32(done[l] = 0); WriteValue32(go[l] = buf + 1)
+ *   wait(l):        WaitValue32(done[l] == 1)
+ * and ONE spinning poller thread (no TaskQueue, no driver callback thread)
+ *   sees go[l] != 0 -> go[l] = 0 -> MoE_Interface::forward(...) -> done[l] = 1.
+ * Both memops are ordinary stream work, so they are recorded into CUDA graphs
+ * as memop nodes; the flag addresses are fixed for the life of the process.
+ * The arithmetic is exactly MoE_Interface::forward(qlen, k, ...,
+ * incremental=false), i.e. the same call the TaskQueue worker makes today:
+ * outputs must be bit-identical.
+ *
+ * Poller logic lives in
+ * doorbell_core.h (CUDA-free protocol state). Optional features (d = 0 and the old signatures remain bit-identical):
+ *   - deferral (KT_DS41_MU_DEFER_MHC): submit_defer(l, buf, d) -> ddone[l] = 0, [arrived[l] = 0], done[l] = 0, go = d<<20|buf+1;
+ *     the poller splits the top-k (defer_split.h), runs the immediate part -> done, later the deferred part into the
+ *     buffer's def_output -> ddone; wait_deferred(l) -> [arrived[l] = 1], WaitValue32(ddone[l] == 1).
+ *   - Dual micro-batching: index l = layer + 64 * half; the poller serves A_L before B_L before A_{L+1}.
+ */
+#ifndef CPUINFER_DOORBELL_JOIN_H
+#define CPUINFER_DOORBELL_JOIN_H
+
+#if defined(KTRANSFORMERS_USE_CUDA)
+
+#include <cuda.h>
+#include <cuda_runtime.h>
+#include <immintrin.h>
+#include <pthread.h>
+#include <sched.h>
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <exception>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <thread>
+#include <tuple>
+#include <vector>
+
+#include "../operators/common.hpp"
+#include "doorbell_core.h"
+
+class DoorbellJoin {
+ public:
+  using Flag = DoorbellFlag;
+
+  // defer_mode: 0 = lowest-d of all top-k (like select_deferred_experts), 1 = lowest-d CPU experts only.
+  // defer_stats: 1 = arrived flags (stream marks "waiting for ddone") + one [CB-JOIN-DEFER] line per 60 s.
+  DoorbellJoin(int max_layers, int max_bufs, int poll_cpu, int defer_mode = 0, int defer_stats = 0)
+      : max_layers_(max_layers), poll_cpu_(poll_cpu), defer_stats_(defer_stats != 0) {
+    if (max_layers <= 0 || max_bufs <= 0) throw std::invalid_argument("CB-JOIN: sizes must be positive");
+    alloc_flags(&go_host_, &go_dev_);
+    alloc_flags(&done_host_, &done_dev_);
+    alloc_flags(&ddone_host_, &ddone_dev_);
+    if (defer_stats_) alloc_flags(&arrived_host_, &arrived_dev_);
+    core_ = std::make_unique<DoorbellCore<MoE_Interface>>(max_layers, max_bufs, go_host_, done_host_, ddone_host_,
+                                                          arrived_host_, defer_mode);
+    poller_ = std::thread(&DoorbellJoin::poll_loop, this);
+    printf("[CB-JOIN] poller started: max_layers=%d max_bufs=%d poll_cpu=%d (defer_mode=%d, defer_stats=%d)\n",
+           max_layers, max_bufs, poll_cpu_, defer_mode, (int)defer_stats_);
+    fflush(stdout);
+  }
+
+  ~DoorbellJoin() {
+    stop_.store(true, std::memory_order_release);
+    if (poller_.joinable()) poller_.join();
+    cudaFreeHost((void*)go_host_);
+    cudaFreeHost((void*)done_host_);
+    cudaFreeHost((void*)ddone_host_);
+    if (arrived_host_) cudaFreeHost((void*)arrived_host_);
+  }
+
+  DoorbellJoin(const DoorbellJoin&) = delete;
+  DoorbellJoin& operator=(const DoorbellJoin&) = delete;
+
+  // Called from Python before the layer's first submit (eager warm-up or graph capture). Keeps the MoE object alive.
+  // gpu_mask (uint8 per expert, 1 = GPU expert) and expert_num are needed only for deferred jobs.
+  void register_layer(int layer, std::shared_ptr<MoE_Interface> moe, intptr_t gpu_mask = 0, int expert_num = 0) {
+    core_->register_layer(layer, moe, (const uint8_t*)gpu_mask, expert_num);
+  }
+
+  // Toy/latency test only: a layer whose task does nothing (no MoE).
+  void register_echo_layer(int layer) { core_->register_echo_layer(layer); }
+
+  // One entry per pinned buffer slot (KExpertsCPUBuffer). Append-only (Python runs ahead of the stream, graphs bake
+  // ids). def_output/def_row_bytes: second output for deferred jobs (0 = buffer takes no deferred jobs).
+  int register_buffer(intptr_t qlen, int k, intptr_t ids, intptr_t weights, intptr_t input, intptr_t output,
+                      intptr_t def_output = 0, int def_row_bytes = 0) {
+    return core_->register_buffer((const int*)qlen, k, (const int64_t*)ids, (const float*)weights, (const void*)input,
+                                  (void*)output, (void*)def_output, def_row_bytes);
+  }
+
+  int n_bufs() const { return core_->n_bufs(); }
+  int max_bufs() const { return core_->max_bufs(); }
+
+  // Enqueue on `stream` AFTER the D2H copies of input/ids/weights.
+  void submit(intptr_t stream, int layer, int buf_id) { submit_defer(stream, layer, buf_id, 0); }
+
+  // d > 0: the poller defers the d lowest-weight experts (defer_split.h) into the buffer's def_output.
+  void submit_defer(intptr_t stream, int layer, int buf_id, int d) {
+    core_->check_layer(layer);
+    if (buf_id < 0 || buf_id >= core_->n_bufs()) throw std::invalid_argument("CB-JOIN: unknown buffer id");
+    if (d < 0 || d > 7) throw std::invalid_argument("CB-JOIN: defer count must be 0..7");
+    CUstream s = (CUstream)stream;
+    // default flags = system-wide memory barrier before the write, so the
+    // preceding D2H copies are visible before the CPU can see go[layer].
+    if (d > 0) {
+      check(cuStreamWriteValue32(s, flag_dev(ddone_dev_, layer), 0, CU_STREAM_WRITE_VALUE_DEFAULT),
+            "cuStreamWriteValue32(ddone=0)");
+      if (defer_stats_)
+        check(cuStreamWriteValue32(s, flag_dev(arrived_dev_, layer), 0, CU_STREAM_WRITE_VALUE_DEFAULT),
+              "cuStreamWriteValue32(arrived=0)");
+    }
+    check(cuStreamWriteValue32(s, flag_dev(done_dev_, layer), 0, CU_STREAM_WRITE_VALUE_DEFAULT),
+          "cuStreamWriteValue32(done=0)");
+    check(cuStreamWriteValue32(s, flag_dev(go_dev_, layer), ((cuuint32_t)d << 20) | (cuuint32_t)(buf_id + 1),
+                               CU_STREAM_WRITE_VALUE_DEFAULT),
+          "cuStreamWriteValue32(go)");
+  }
+
+  // Enqueue on `stream` BEFORE the H2D copy of the CPU output.
+  void wait(intptr_t stream, int layer) {
+    core_->check_layer(layer);
+    check(cuStreamWaitValue32((CUstream)stream, flag_dev(done_dev_, layer), 1, CU_STREAM_WAIT_VALUE_EQ),
+          "cuStreamWaitValue32(done==1)");
+  }
+
+  // Enqueue on `stream` BEFORE the H2D copy of the deferred output (attention hc_post of the next layer).
+  void wait_deferred(intptr_t stream, int layer) {
+    core_->check_layer(layer);
+    if (defer_stats_)
+      check(cuStreamWriteValue32((CUstream)stream, flag_dev(arrived_dev_, layer), 1, CU_STREAM_WRITE_VALUE_DEFAULT),
+            "cuStreamWriteValue32(arrived=1)");
+    check(cuStreamWaitValue32((CUstream)stream, flag_dev(ddone_dev_, layer), 1, CU_STREAM_WAIT_VALUE_EQ),
+          "cuStreamWaitValue32(ddone==1)");
+  }
+
+  uint64_t tasks() const { return core_->tasks(); }
+  uint64_t busy_ns() const { return core_->busy_ns(); }
+  // (runs, zero-filled, deferred CPU experts, busy ns, late = stream was already waiting)
+  std::tuple<uint64_t, uint64_t, uint64_t, uint64_t, uint64_t> defer_stats() const {
+    auto s = core_->defer_stats();
+    return {s.runs, s.zero, s.cpu_experts, s.busy_ns, s.late};
+  }
+
+ private:
+  static void check(CUresult r, const char* what) {
+    if (r != CUDA_SUCCESS) {
+      const char* s = nullptr;
+      cuGetErrorString(r, &s);
+      throw std::runtime_error(std::string("CB-JOIN ") + what + ": " + (s ? s : "unknown CUDA error"));
+    }
+  }
+
+  static CUdeviceptr flag_dev(CUdeviceptr base, int layer) { return base + (CUdeviceptr)layer * sizeof(Flag); }
+
+  void alloc_flags(Flag** host, CUdeviceptr* dev) {
+    void* p = nullptr;
+    cudaError_t e = cudaHostAlloc(&p, sizeof(Flag) * (size_t)max_layers_, cudaHostAllocMapped | cudaHostAllocPortable);
+    if (e != cudaSuccess) throw std::runtime_error(std::string("CB-JOIN cudaHostAlloc: ") + cudaGetErrorString(e));
+    void* d = nullptr;
+    e = cudaHostGetDevicePointer(&d, p, 0);
+    if (e != cudaSuccess) throw std::runtime_error(std::string("CB-JOIN cudaHostGetDevicePointer: ") + cudaGetErrorString(e));
+    *host = (Flag*)p;
+    *dev = (CUdeviceptr)(uintptr_t)d;
+  }
+
+  void poll_loop() {
+    if (poll_cpu_ >= 0) {
+      cpu_set_t set;
+      CPU_ZERO(&set);
+      CPU_SET(poll_cpu_, &set);
+      pthread_setaffinity_np(pthread_self(), sizeof(set), &set);
+    }
+    pthread_setname_np(pthread_self(), "kt_cb_join");
+    auto last = std::chrono::steady_clock::now();
+    auto last_log = last;
+    uint64_t logged_runs = 0;
+    while (!stop_.load(std::memory_order_acquire)) {
+      if (core_->poll_once()) {
+        last = std::chrono::steady_clock::now();
+      } else {
+        _mm_pause();
+        // Spin like the pool workers (50 ms), then poll every 20 us while idle.
+        auto now = std::chrono::steady_clock::now();
+        if (now - last > std::chrono::milliseconds(50)) std::this_thread::sleep_for(std::chrono::microseconds(20));
+        if (defer_stats_ && now - last_log > std::chrono::seconds(60)) {
+          last_log = now;
+          auto s = core_->defer_stats();
+          if (s.runs != logged_runs) {
+            logged_runs = s.runs;
+            printf("[CB-JOIN-DEFER] runs=%lu zero=%lu cpu_experts_per_run=%.3f def_us_mean=%.1f late=%.2f%%\n",
+                   (unsigned long)s.runs, (unsigned long)s.zero, s.runs ? (double)s.cpu_experts / s.runs : 0.0,
+                   s.runs ? (double)s.busy_ns / s.runs / 1000.0 : 0.0, s.runs ? 100.0 * s.late / s.runs : 0.0);
+            fflush(stdout);
+          }
+        }
+      }
+    }
+  }
+
+  const int max_layers_;
+  const int poll_cpu_;
+  const bool defer_stats_;
+  Flag* go_host_ = nullptr;
+  Flag* done_host_ = nullptr;
+  Flag* ddone_host_ = nullptr;
+  Flag* arrived_host_ = nullptr;
+  CUdeviceptr go_dev_ = 0;
+  CUdeviceptr done_dev_ = 0;
+  CUdeviceptr ddone_dev_ = 0;
+  CUdeviceptr arrived_dev_ = 0;
+  std::unique_ptr<DoorbellCore<MoE_Interface>> core_;
+  std::atomic<bool> stop_{false};
+  std::thread poller_;
+};
+
+#endif  // KTRANSFORMERS_USE_CUDA
+#endif  // CPUINFER_DOORBELL_JOIN_H
