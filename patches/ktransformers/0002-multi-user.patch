+inline void put_e8m0(uint8_t* dst, const uint8_t* e8, const float* d, size_t off, size_t cnt) {
+  if (e8 != nullptr) {
+    std::memcpy(dst, e8 + off, cnt);
+    return;
+  }
+  ggml_bf16_t tmp[256];
+  for (size_t i = 0; i < cnt; i += 256) {
+    const size_t n = std::min<size_t>(256, cnt - i);
+    ggml_fp32_to_bf16_row(d + off + i, tmp, (int64_t)n);
+    for (size_t j = 0; j < n; j++) dst[i + j] = (uint8_t)((tmp[j].bits >> 7) & 0xFF);
+  }
+}
