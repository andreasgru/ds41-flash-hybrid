+
+// =============================================================================================
+// KERN=2 (KT_DS41_MU_MXFP4_KERNEL=2): Q8 activation (int8 per 32-block, fp32 block scale amax/127) and int8
+// weights via LUT (FP4 E2M1 x 2), vpsignb / vpmaddubsw / vpmaddwd like llama.cpp mxfp4 x q8_0.
+// NOT bit-identical to the fp32 path (activation is quantized, as in the GPU W4A8 path); gates needed.
+// Layout of the quantized activation per 32-group: bytes 0..15 = cols 0,2,..,30, bytes 16..31 = cols 1,3,..,31
+// (matches the natural nibble split lo | hi of the weight bytes), plus da_half[g] = amax / 127 * 0.5.
+alignas(16) static constexpr int8_t kLutI8[16] = {0, 1, 2, 3, 4, 6, 8, 12, 0, -1, -2, -3, -4, -6, -8, -12};
+
+static inline void quant_act_q8(const ggml_bf16_t* src, int k, int8_t* q, float* da_half) {
+  const __m256i hm = _mm256_set1_epi32((int)0xFFFF0000u);
+  const __m256 absm = _mm256_castsi256_ps(_mm256_set1_epi32(0x7FFFFFFF));
+  const __m256i pidx = _mm256_setr_epi32(0, 4, 1, 5, 2, 6, 3, 7);
+  const int G = k / 32;
+  for (int g = 0; g < G; g++) {
+    const __m256i xa = _mm256_loadu_si256((const __m256i*)(src + (size_t)g * 32));
+    const __m256i xb = _mm256_loadu_si256((const __m256i*)(src + (size_t)g * 32 + 16));
+    const __m256 ea = _mm256_castsi256_ps(_mm256_slli_epi32(xa, 16));
+    const __m256 oa = _mm256_castsi256_ps(_mm256_and_si256(xa, hm));
+    const __m256 eb = _mm256_castsi256_ps(_mm256_slli_epi32(xb, 16));
+    const __m256 ob = _mm256_castsi256_ps(_mm256_and_si256(xb, hm));
+    __m256 m = _mm256_max_ps(_mm256_max_ps(_mm256_and_ps(ea, absm), _mm256_and_ps(oa, absm)),
+                             _mm256_max_ps(_mm256_and_ps(eb, absm), _mm256_and_ps(ob, absm)));
+    m = _mm256_max_ps(m, _mm256_permute2f128_ps(m, m, 1));
+    m = _mm256_max_ps(m, _mm256_shuffle_ps(m, m, 0x4E));
+    m = _mm256_max_ps(m, _mm256_shuffle_ps(m, m, 0xB1));
+    const float amax = _mm256_cvtss_f32(m);
+    if (!(amax > 0.0f)) {
+      _mm256_storeu_si256((__m256i*)(q + (size_t)g * 32), _mm256_setzero_si256());
+      da_half[g] = 0.0f;
+      continue;
+    }
+    const __m256 inv = _mm256_div_ps(_mm256_set1_ps(127.0f), m);
+    const __m256i qea = _mm256_cvtps_epi32(_mm256_mul_ps(ea, inv));
+    const __m256i qoa = _mm256_cvtps_epi32(_mm256_mul_ps(oa, inv));
+    const __m256i qeb = _mm256_cvtps_epi32(_mm256_mul_ps(eb, inv));
+    const __m256i qob = _mm256_cvtps_epi32(_mm256_mul_ps(ob, inv));
+    const __m256i pe = _mm256_packs_epi32(qea, qeb);
+    const __m256i po = _mm256_packs_epi32(qoa, qob);
+    const __m256i b = _mm256_permutevar8x32_epi32(_mm256_packs_epi16(pe, po), pidx);
+    _mm256_storeu_si256((__m256i*)(q + (size_t)g * 32), b);
+    da_half[g] = amax / 127.0f * 0.5f;
+  }
+}
+
+// M activation rows (q8 + da_half, row strides k bytes / k/32 floats) against weight rows [n0, n1).
+template <int M, bool E8>
+static void gemv_q8(const int8_t* __restrict q, const float* __restrict da, const uint8_t* __restrict b,
+                    const void* __restrict dv, int k, int n0, int n1, float* __restrict c, size_t c_stride) {
+  const __m256i lut = _mm256_broadcastsi128_si256(_mm_load_si128((const __m128i*)kLutI8));
+  const __m128i nib = _mm_set1_epi8(0x0F);
+  const __m256i ones = _mm256_set1_epi16(1);
+  const float* e8 = e8_table();
+  const int G = k / 32;
+  const size_t rb = (size_t)k / 2;
+  for (int ni = n0; ni < n1; ni++) {
+    const uint8_t* br = b + (size_t)ni * rb;
+    const float* sf = E8 ? nullptr : (const float*)dv + (size_t)ni * G;
+    const uint8_t* se = E8 ? (const uint8_t*)dv + (size_t)ni * G : nullptr;
+    __m256 acc[M][4];
+#pragma GCC unroll 4
+    for (int mi = 0; mi < M; mi++)
+      for (int j = 0; j < 4; j++) acc[mi][j] = _mm256_setzero_ps();
+    auto step = [&](int g, int j) __attribute__((always_inline)) {
+      const __m128i raw = _mm_loadu_si128((const __m128i*)(br + (size_t)g * 16));
+      const __m256i v = _mm256_set_m128i(_mm_and_si128(_mm_srli_epi16(raw, 4), nib), _mm_and_si128(raw, nib));
+      const __m256i w8 = _mm256_shuffle_epi8(lut, v);
+      const __m256i aw = _mm256_sign_epi8(w8, w8);
+      const __m256 ws = E8 ? _mm256_broadcast_ss(e8 + se[g]) : _mm256_broadcast_ss(sf + g);
+#pragma GCC unroll 4
+      for (int mi = 0; mi < M; mi++) {
+        const __m256i qa = _mm256_loadu_si256((const __m256i*)(q + (size_t)mi * k + (size_t)g * 32));
+        const __m256i p16 = _mm256_maddubs_epi16(aw, _mm256_sign_epi8(qa, w8));
+        const __m256 f = _mm256_cvtepi32_ps(_mm256_madd_epi16(p16, ones));
+        // Combined scale first: da * ws is exact (ws is a power of two), so the result is a single rounding
+        // acc + f * da * ws. Written as fma(f, sc, acc) so -ffast-math cannot re-associate it differently
+        // per instantiation. The former order (mul(f, da), then fma(., ws, .)) was folded differently by GCC for M / E8.
+        const __m256 sc = _mm256_mul_ps(_mm256_broadcast_ss(da + (size_t)mi * G + g), ws);
+        acc[mi][j] = _mm256_fmadd_ps(f, sc, acc[mi][j]);
+      }
+    };
+    int g = 0;
+    for (; g + 4 <= G; g += 4) {
+      step(g, 0);
+      step(g + 1, 1);
+      step(g + 2, 2);
+      step(g + 3, 3);
+    }
+    for (int j = 0; g < G; g++, j++) step(g, j);
+    // Fixed reduction order ((a0 + a1) + (a2 + a3)); the empty asm pins each partial sum so that -ffast-math
+    // cannot re-associate the 4-way sum differently per instantiation (M, E8), which otherwise made results batch-dependent.
+#pragma GCC unroll 4
+    for (int mi = 0; mi < M; mi++) {
+      __m256 s01 = _mm256_add_ps(acc[mi][0], acc[mi][1]);
+      __asm__("" : "+x"(s01));
+      __m256 s23 = _mm256_add_ps(acc[mi][2], acc[mi][3]);
+      __asm__("" : "+x"(s23));
+      __m256 s = _mm256_add_ps(s01, s23);
+      __asm__("" : "+x"(s));
+      c[mi * c_stride + ni] = avx2::hsum_avx2(s);
+    }
+  }
+}
