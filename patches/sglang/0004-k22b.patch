+# SGLANG_DS41_MU_A1_B12X_DECODE=1: the resident slots hold the SM120 b12x w4a16
+# packed layout, not the CUTLASS MXFP4 layout. Every published expert is then
+# packed *inside the slot*, with the very functions the first load uses
+# (Mxfp4FlashinferCutlassMoEMethod.process_weights_after_loading), so the
+# prepared views the b12x runner holds stay valid across a swap. Unset or 0:
+# Nothing below runs when disabled; the CUTLASS landing-pad permutation stays.
+_B12X_ON = os.environ.get("SGLANG_DS41_MU_A1_B12X_DECODE", "0") != "0"
+_B12X_TILES = (16, 64, 8)  # _PACKED_TILE_SIZE, _PACKED_TILE_N_SIZE, _PACK_FACTOR_4BIT
+
+
+def _b12x_pack_ops():
+    """The vendored pack primitives, with their tile constants checked."""
+    from flashinfer.fused_moe.cute_dsl.blackwell_sm12x.moe_w4a16_prepare import (
+        _PACKED_TILE_N_SIZE,
+        _PACKED_TILE_SIZE,
+        _PACK_FACTOR_4BIT,
+        _pack_e8m0_k32_scales,
+        _repack_4bit_no_perm,
+    )
+
+    got = (_PACKED_TILE_SIZE, _PACKED_TILE_N_SIZE, _PACK_FACTOR_4BIT)
+    if got != _B12X_TILES:
+        raise RuntimeError(f"A1_B12X: FlashInfer pack tile constants changed: {got}")
+    return _repack_4bit_no_perm, _pack_e8m0_k32_scales
+
+
+def b12x_scratch(K: int, N: int, device) -> Dict[str, torch.Tensor]:
+    """Preallocated int32 scratch of the weight repack.
+
+    ``_repack_4bit_no_perm`` and the transpose in front of it need three
+    int32 buffers per projection; they are allocated once per copy stream
+    (the swap path runs on one stream, so one set per device is enough).
+    """
+    k13, n13 = K // 16, (2 * N) // 64
+    k2, n2 = N // 16, K // 64
+    return {
+        "q13": torch.empty((K // 8, 2 * N), dtype=torch.int32, device=device),
+        "f13": torch.empty((k13, n13, 128), dtype=torch.int32, device=device),
+        "g13": torch.empty((k13, n13, 128), dtype=torch.int32, device=device),
+        "q2": torch.empty((N // 8, K), dtype=torch.int32, device=device),
+        "f2": torch.empty((k2, n2, 128), dtype=torch.int32, device=device),
+        "g2": torch.empty((k2, n2, 128), dtype=torch.int32, device=device),
+    }
+
+
+def b12x_pack_slots_(w13, w2, s13, s2, K: int, N: int, scratch: Dict[str, torch.Tensor]) -> None:
+    """Pack one expert's raw fp4 weights and E8M0/K32 scales in place (b12x layout).
+
+    ``w13``/``w2``/``s13``/``s2`` are the flat uint8 views of one expert's four
+    slot regions, already holding the checkpoint bytes: w13 as ``[up; gate]``
+    (2N rows), w2 as ``[K, N/2]``, the scales as ``[rows, K/32]`` E8M0. The
+    weights are rotated, transposed and repacked through the preallocated
+    scratch, the scales through the vendored pack with reuse_input_storage=True.
+    Every mismatch raises: a half-packed slot must never be published.
+    """
+    repack_4bit, pack_scales = _b12x_pack_ops()
+    if w13.numel() != K * N or w2.numel() != K * N // 2:
+        raise RuntimeError(
+            f"A1_B12X: slot bytes {int(w13.numel())}/{int(w2.numel())} "
+            f"!= {K * N}/{K * N // 2}"
+        )
+    src13 = w13.view(torch.int32).view(2 * N, K // 8)
+    scratch["q13"][:, :N].copy_(src13[N:].T)
+    scratch["q13"][:, N:].copy_(src13[:N].T)
+    repack_4bit(
+        scratch["q13"],
+        size_k=K,
+        size_n=2 * N,
+        out=w13.view(torch.int32).view(K // 16, (2 * N) // 64, 128),
+        flat_scratch=scratch["f13"],
+        gather_scratch=scratch["g13"],
+    )
+    src2 = w2.view(torch.int32).view(K, N // 8)
+    scratch["q2"].copy_(src2.T)
+    repack_4bit(
+        scratch["q2"],
+        size_k=N,
+        size_n=K,
+        out=w2.view(torch.int32).view(N // 16, K // 64, 128),
+        flat_scratch=scratch["f2"],
+        gather_scratch=scratch["g2"],
+    )
+    packed13 = pack_scales(
+        s13.view(1, 2 * N, K // 32),
+        size_k=K,
+        size_n=2 * N,
+        row_rotation=N,
+        reuse_input_storage=True,
+    )
+    packed2 = pack_scales(
+        s2.view(1, K, N // 32),
+        size_k=N,
+        size_n=K,
+        reuse_input_storage=True,
+    )
+    if int(packed13.data_ptr()) != int(s13.data_ptr()):
+        raise RuntimeError("A1_B12X: w13 scale pack left the slot storage")
+    if int(packed2.data_ptr()) != int(s2.data_ptr()):
+        raise RuntimeError("A1_B12X: w2 scale pack left the slot storage")
 
 
