+"""FlashInfer b12x w4a16 MoE fused func for the resident experts under A1.
+
+The A1 expert cache keeps the resident GPU experts' MXFP4
+weights and their E8M0/K32 scales in the *b12x packed* layout: the start set
+is packed in ``Mxfp4FlashinferCutlassMoEMethod.process_weights_after_loading``
+and every swap reproduces the same layout in ``a1_exec.copy_slot_``. The
+per-layer ``W4A16PackedWeights`` handed through the quant info therefore only
+*views* the resident slot tensors; nothing is repacked at run time.
+
+Correctness requirements:
+
+* a real int32 identity ``expert_map`` -- it is what switches
+  ``zero_fc2_output`` on, so the ``-1`` rows of CPU-bound experts cannot leak
+  their FC1 intermediates into the top-k sum (without it bs8/M8 is wrong), and
+* ``swiglu_limit`` forwarded explicitly -- ``B12xMoEWrapper``'s production
+  dispatch drops it on the way to the w4a16 kernel.
+
+This module is only imported when ``SGLANG_DS41_MU_A1_B12X_DECODE`` is on.
+"""
+
+from __future__ import annotations
+
+import logging
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Optional
+
+import torch
+
+from sglang.srt.layers.moe.moe_runner.base import (
+    DispatchMoeRunnerCore,
+    MoeQuantInfo,
+    MoeRunnerConfig,
+    register_fused_func,
+)
+from sglang.srt.layers.moe.moe_runner.runner import register_moe_runner_core
+from sglang.srt.layers.moe.utils import MoeRunnerBackend
+
+if TYPE_CHECKING:
+    from sglang.srt.layers.moe.token_dispatcher import CombineInput, DispatchOutput
+
+logger = logging.getLogger(__name__)
+
+# Backend name of this runner. ``MoeRunnerBackend.FLASHINFER_B12X_W4A16`` holds
+# the same string; the enum member exists so ``register_fused_func`` accepts it.
+B12X_W4A16_BACKEND = MoeRunnerBackend.FLASHINFER_B12X_W4A16.value
+
+_identity_maps: dict[tuple[int, str], torch.Tensor] = {}
+
+
+def _identity_expert_map(num_experts: int, device: torch.device) -> torch.Tensor:
+    """The identity map that turns Zero-FC2 on (one tensor per count/device)."""
+    key = (int(num_experts), str(device))
+    m = _identity_maps.get(key)
+    if m is None:
+        m = torch.arange(int(num_experts), device=device, dtype=torch.int32)
+        _identity_maps[key] = m
+    return m
+
+
+def prewarm_identity_map(num_experts: int, device: torch.device) -> None:
+    """Build the identity expert map before the decode CUDA graphs are captured.
+
+    The first call allocates ``torch.arange``; doing that inside a capture would
+    grow the graph-private pool with a tensor nobody frees. The map never
+    changes, so the pre-capture hook builds it once per (count, device).
+    """
+    _identity_expert_map(num_experts, device)
+
+
+@dataclass
+class FlashInferB12xW4A16MoeQuantInfo(MoeQuantInfo):
+    """Payload for the b12x w4a16 fused MoE."""
+
+    # Views into the resident slot tensors, already in the b12x packed layout.
+    prepared: object  # W4A16PackedWeights
+    num_experts: int
+    top_k: int
+    hidden_size: int
+    intermediate_size: int
+    # Model SwiGLU clamp (DSv4: 10.0). Forwarded to the kernel on every call.
+    swiglu_limit: Optional[float] = None
+
+
+def w4a16_workspace(
+    *,
+    num_experts: int,
+    hidden_size: int,
+    intermediate_size: int,
+    top_k: int,
+    max_routed_rows: int,
+    device: torch.device,
+):
+    """The process-wide cached b12x w4a16 workspace of FlashInfer.
+
+    Allocated here (before the decode CUDA graphs are captured) and reused by
+    every call; FlashInfer grows it outside capture if a caller needs more.
+    """
+    from flashinfer.fused_moe.cute_dsl.blackwell_sm12x.moe_dispatch import (
+        _get_cached_workspace,
+    )
+
+    return _get_cached_workspace(
+        backend="w4a16",
+        state_E=int(num_experts),
+        weight_E=int(num_experts),
+        routed_rows=int(max_routed_rows),
+        k=int(hidden_size),
+        n=int(intermediate_size),
+        num_topk=int(top_k),
+        device=device,
+        quant_mode="w4a16",
+        activation="silu",
+    )
+
+
+def _run_b12x_w4a16(
+    quant_info: FlashInferB12xW4A16MoeQuantInfo,
+    x: torch.Tensor,
+    topk_ids: torch.Tensor,
+    topk_weights: torch.Tensor,
+    output: torch.Tensor,
+) -> None:
+    """One b12x w4a16 MoE call over the resident slots. Fail-closed on mismatch."""
+    from flashinfer.fused_moe.cute_dsl.blackwell_sm12x.moe_w4a16_kernel import (
+        run_w4a16_moe,
+    )
+
+    prepared = quant_info.prepared
+    num_experts = int(quant_info.num_experts)
+    if int(getattr(prepared, "num_experts", -1)) != num_experts:
+        raise ValueError(
+            "B12X_W4A16: prepared.num_experts "
+            f"({getattr(prepared, 'num_experts', None)}) != num_experts "
+            f"({num_experts})"
+        )
+    if int(x.size(1)) != int(quant_info.hidden_size):
+        raise ValueError(
+            f"B12X_W4A16: x hidden {int(x.size(1))} != {quant_info.hidden_size}"
+        )
+    if int(topk_ids.size(1)) != int(quant_info.top_k):
+        raise ValueError(
+            f"B12X_W4A16: top_k {int(topk_ids.size(1))} != {quant_info.top_k}"
+        )
+    # A device->host sync (.item()) is forbidden while a CUDA graph is being
+    # captured, so the id range check runs outside capture only: the uncaptured
+    # warmup calls and an uncaptured validation probe drive it. During capture the ids come from
+    # A1 itself (slots or -1), and the shape/dtype checks above stay active.
+    if not torch.cuda.is_current_stream_capturing():
+        highest = int(topk_ids.max())
+        if highest >= num_experts and bool((topk_ids >= 0).any()):
+            raise ValueError(
+                f"B12X_W4A16: topk id {highest} >= num_experts {num_experts} "
+                "(ids must be slots or -1)"
+            )
+    if x.dtype != torch.bfloat16 or output.dtype != torch.bfloat16:
+        raise TypeError(
+            f"B12X_W4A16: bf16 in/out required, got x={x.dtype} out={output.dtype}"
+        )
+
+    ws = w4a16_workspace(
+        num_experts=num_experts,
+        hidden_size=int(quant_info.hidden_size),
+        intermediate_size=int(quant_info.intermediate_size),
+        top_k=int(quant_info.top_k),
+        max_routed_rows=int(x.size(0)) * int(quant_info.top_k),
+        device=x.device,
+    )
+    run_w4a16_moe(
+        x,
+        prepared,
+        topk_weights,
+        topk_ids,
+        activation="silu",
+        swiglu_limit=quant_info.swiglu_limit,
+        intermediate_cache13=ws.intermediate_cache13,
+        intermediate_cache2=ws.intermediate_cache2,
+        output=output,
+        fc1_c_tmp=ws.fc1_c_tmp,
+        fc2_c_tmp=ws.fc2_c_tmp,
+        packed_route_indices=ws.packed_route_indices,
+        block_expert_ids=ws.block_expert_ids,
+        packed_route_count=ws.packed_route_count,
+        expert_offsets=ws.expert_offsets,
+        expert_map=_identity_expert_map(num_experts, x.device),
+    )
+
+
+def b12x_w4a16_moe(
+    quant_info: FlashInferB12xW4A16MoeQuantInfo,
+    x: torch.Tensor,
+    topk_ids: torch.Tensor,
+    topk_weights: torch.Tensor,
+) -> torch.Tensor:
+    """Allocate (or take the provided) bf16 output and run one b12x w4a16 MoE call.
+
+    Mirrors the neighbouring fused funcs: the per-forward MoE output buffer the
+    forward scope offers is used when it fits, otherwise the buffer is allocated
+    under ``use_symmetric_memory`` when the run allocates symmetrically.
+    """
+    from sglang.srt.layers.dp_attention import is_allocation_symmetric
+    from sglang.srt.distributed import get_tp_group
+    from sglang.srt.distributed.device_communicators.pynccl_allocator import (
+        use_symmetric_memory,
+    )
+    from sglang.srt.runtime_context import get_forward
+
+    num_tokens = int(x.shape[0])
+    hidden = int(quant_info.hidden_size)
+    if x.dtype != torch.bfloat16:
+        raise TypeError(f"B12X_W4A16: bf16 input required, got {x.dtype}")
+    provided = get_forward().moe_output_buffer
+    if (
+        provided is not None
+        and tuple(provided.shape) == (num_tokens, hidden)
+        and provided.dtype == torch.bfloat16
+        and provided.device == x.device
+    ):
+        output = provided
+    else:
+        with use_symmetric_memory(
+            get_tp_group(), disabled=not is_allocation_symmetric()
+        ):
+            output = torch.empty(
+                (num_tokens, hidden), dtype=torch.bfloat16, device=x.device
+            )
+    _run_b12x_w4a16(quant_info, x, topk_ids, topk_weights, output)
+    return output
+
+
+def _standard_topk(dispatch_output):
+    """topk_ids (int32) and topk_weights from a standard dispatch output."""
+    from sglang.srt.layers.moe.topk import TopKOutputChecker
+
+    topk_output = dispatch_output.topk_output
+    if TopKOutputChecker.format_is_bypassed(topk_output):
+        topk_output = topk_output.to_standard()
+    return topk_output.topk_ids.to(torch.int32), topk_output.topk_weights
+
+
+@register_fused_func("none", B12X_W4A16_BACKEND)
+def fused_experts_none_to_flashinfer_b12x_w4a16(
+    dispatch_output, quant_info: MoeQuantInfo, runner_config: MoeRunnerConfig
+):
+    """Run the resident experts on the SM120 b12x w4a16 kernel."""
+    from sglang.srt.layers.moe.token_dispatcher.standard import StandardCombineInput
+
+    if not isinstance(quant_info, FlashInferB12xW4A16MoeQuantInfo):
+        raise TypeError(
+            "flashinfer_b12x_w4a16 expects FlashInferB12xW4A16MoeQuantInfo, "
+            f"got {type(quant_info)}"
+        )
+    if runner_config.apply_router_weight_on_input:
+        raise ValueError(
+            "apply_router_weight_on_input is not supported for flashinfer_b12x_w4a16"
+        )
+
+    x = dispatch_output.hidden_states
+    topk_ids, topk_weights = _standard_topk(dispatch_output)
+    out = b12x_w4a16_moe(quant_info, x, topk_ids, topk_weights)
+    return StandardCombineInput(hidden_states=out)
+
+
+class B12xW4A16RunnerCore(DispatchMoeRunnerCore):
+    """Runner core of the b12x w4a16 backend.
+
+    The backend only runs the fused func; the core exists so ``MoeRunner``
+    resolves the backend name (the fused func alone is not enough, because the
+    built-in backend chain has no branch for a shipped-out-of-tree name).
+    """
+
+    @property
+    def runner_backend(self) -> MoeRunnerBackend:
+        return MoeRunnerBackend.FLASHINFER_B12X_W4A16
+
+    def run_from_dispatch(
+        self,
+        dispatch_output: "DispatchOutput",
+        quant_info: MoeQuantInfo,
+        runner_config: MoeRunnerConfig,
+        hooks=None,
+    ) -> "CombineInput":
+        return fused_experts_none_to_flashinfer_b12x_w4a16(
+            dispatch_output, quant_info, runner_config
+        )
