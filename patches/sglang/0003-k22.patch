diff -ruN a/python/sglang/srt/layers/quantization/ds41_mu_b12x.py b/python/sglang/srt/layers/quantization/ds41_mu_b12x.py
--- a/python/sglang/srt/layers/quantization/ds41_mu_b12x.py	1970-01-01 01:00:00.000000000 +0100
+++ b/python/sglang/srt/layers/quantization/ds41_mu_b12x.py	2026-10-18 12:44:34.836657556 +0200
@@ -0,0 +1,237 @@
+"""Decode (small M) block-FP8 GEMMs on FlashInfer ``mm_mxfp8`` backend b12x (SM120).
+
+Opt-in via ``SGLANG_DS41_MU_MXFP8_B12X=1``; with the default ``0`` this module is never consulted and
+the FP8 linear dispatch is unchanged.
+
+Why it is exact on the weight side: DeepSeek-V4.1 stores dense FP8 weights with 32x32 blocks and
+power-of-two (ue8m0) scales. Repeating each block scale over its 32 rows gives the MXFP8 per-row
+[N, K/32] e8m0 layout byte for byte (``fp8_utils.block_fp8_scale_to_mxfp8_e8m0``); the FP8 weight
+bytes are used unchanged. Activations are quantized by the per-token-group (32, ue8m0) quantizer
+itself (a separate JIT copy ``per_token_group_quant_8bit_v2_swz`` whose only change is that the e8m0
+scale byte is stored at its 128x4-swizzled position), so the FP8 activation bytes are those of the
+Triton path by construction. The GEMM accumulation order differs from the Triton kernel, so outputs are
+not guaranteed bit-identical; numerical agreement requires a separate check.
+
+Settings (environment, read once):
+  SGLANG_DS41_MU_MXFP8_B12X         "0" (off, default) | "1" (on); anything else is an error
+  SGLANG_DS41_MU_MXFP8_B12X_SHAPES  comma list "NxK" of weight shapes routed to b12x
+                                 (default: the six decode shapes measured faster than Triton)
+  SGLANG_DS41_MU_MXFP8_B12X_MAX_M   rows per call routed to b12x, 1..8 (default 1); larger M -> Triton
+  SGLANG_DS41_MU_MXFP8_B12X_DUMP    optional directory: for each shape, the eager M == 1 inputs of the FIRST layer
+                                 object seen with that shape are saved (one row per decode step, up to DUMP_N),
+                                 as bf16 tensors (diagnostics only, never inside a graph capture)
+  SGLANG_DS41_MU_MXFP8_B12X_DUMP_N  number of dumped rows per shape (default 64)
+
+Fail-closed: when switched on, a missing FlashInfer b12x runner or a non-SM12x device raises at
+first use instead of silently running Triton. A layer whose scales cannot be mapped (not a positive
+power of two, wrong block size, kernel cannot implement the shape) stays on Triton, logged with a
+reason and counted in ``STATS``.
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+from functools import lru_cache
+from typing import Dict, FrozenSet, NamedTuple, Optional, Tuple
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+ENV_ON = "SGLANG_DS41_MU_MXFP8_B12X"
+ENV_SHAPES = "SGLANG_DS41_MU_MXFP8_B12X_SHAPES"
+ENV_MAX_M = "SGLANG_DS41_MU_MXFP8_B12X_MAX_M"
+ENV_DUMP = "SGLANG_DS41_MU_MXFP8_B12X_DUMP"
+ENV_DUMP_N = "SGLANG_DS41_MU_MXFP8_B12X_DUMP_N"
+DEFAULT_SHAPES = "32768x1280,5120x8192,4608x5120,5120x2304,25600x6144,4096x1280"
+# (mma_tiler_mn, cluster_shape_mn, swap_ab, use_prefetch, kernel_type, use_tma_store):
+# FlashInfer 0.6.18 b12x default plan for M == 1 and the fastest tile in the shape benchmark sweep.
+TACTIC = ((16, 64), (1, 1), False, False, "sm120", None)
+
+STATS: Dict[str, int] = {"allowed": 0, "ready": 0, "failed": 0, "extra_bytes": 0}
+_path_logged: set = set()
+_dump_count: Dict[Tuple[int, int], int] = {}
+_dump_layer: Dict[Tuple[int, int], int] = {}  # id() of the first layer object per shape -> one row per decode step
+
+
+class Settings(NamedTuple):
+    shapes: FrozenSet[Tuple[int, int]]
+    max_m: int
+    dump_dir: Optional[str]
+    dump_n: int
+
+
+def parse_shapes(text: str) -> FrozenSet[Tuple[int, int]]:
+    out = []
+    for raw in text.split(","):
+        item = raw.strip()
+        if not item:
+            raise ValueError(f"{ENV_SHAPES}: empty entry in {text!r}")
+        parts = item.lower().split("x")
+        if len(parts) != 2 or not all(p.isdigit() for p in parts):
+            raise ValueError(f"{ENV_SHAPES}: entry {item!r} is not NxK")
+        n, k = int(parts[0]), int(parts[1])
+        if n <= 0 or k <= 0 or n % 32 or k % 32:
+            raise ValueError(f"{ENV_SHAPES}: {item!r} must be positive multiples of 32")
+        if (n, k) in out:
+            raise ValueError(f"{ENV_SHAPES}: duplicate {item!r}")
+        out.append((n, k))
+    return frozenset(out)
+
+
+def parse_settings(env=None) -> Optional[Settings]:
+    env = os.environ if env is None else env
+    on = env.get(ENV_ON, "0")
+    if on == "0":
+        return None
+    if on != "1":
+        raise ValueError(f"{ENV_ON} must be 0 or 1, got {on!r}")
+    shapes = parse_shapes(env.get(ENV_SHAPES, DEFAULT_SHAPES))
+    max_m_text = env.get(ENV_MAX_M, "1")
+    if not max_m_text.isdigit() or not 1 <= int(max_m_text) <= 8:
+        raise ValueError(f"{ENV_MAX_M} must be an integer 1..8, got {max_m_text!r}")
+    dump_dir = env.get(ENV_DUMP) or None
+    dump_n_text = env.get(ENV_DUMP_N, "64")
+    if not dump_n_text.isdigit() or int(dump_n_text) < 1:
+        raise ValueError(f"{ENV_DUMP_N} must be a positive integer, got {dump_n_text!r}")
+    if dump_dir is not None and not os.path.isdir(dump_dir):
+        raise ValueError(f"{ENV_DUMP} {dump_dir!r} is not an existing directory")
+    return Settings(shapes, int(max_m_text), dump_dir, int(dump_n_text))
+
+
+@lru_cache(maxsize=1)
+def settings() -> Optional[Settings]:
+    s = parse_settings()
+    if s is not None:
+        logger.info("[MXFP8-B12X] on: shapes=%s max_m=%d tactic=%s dump=%s",
+                    sorted(s.shapes), s.max_m, TACTIC, s.dump_dir)
+    return s
+
+
+@lru_cache(maxsize=1)
+def _runtime():
+    """Fail-closed runtime check; returns (runner, can_implement_fn, quantize_fn)."""
+    if not torch.cuda.is_available():
+        raise RuntimeError(f"{ENV_ON}=1 but CUDA is not available")
+    major, minor = torch.cuda.get_device_capability()
+    if major != 12:
+        raise RuntimeError(f"{ENV_ON}=1 needs an SM12x GPU, found sm_{major}{minor}")
+    import cutlass  # noqa: F401  (nvidia-cutlass-dsl, required by b12x)
+    from flashinfer.gemm.gemm_mm_mxfp8_cute_dsl import _b12x_gemm_mxfp8_runner
+    from flashinfer.gemm.kernels.dense_blockscaled_gemm_sm120_b12x import (
+        Sm120B12xBlockScaledDenseGemmKernel,
+    )
+
+    from sglang.kernels.ops.quantization.per_token_group_quant_8bit_v2_swz import (
+        per_token_group_quant_fp8_swz128x4 as quantize,
+    )
+
+    runner = _b12x_gemm_mxfp8_runner(major, minor, True, torch.bfloat16)
+
+    def can_implement(n: int, k: int) -> bool:
+        return bool(
+            Sm120B12xBlockScaledDenseGemmKernel.can_implement(
+                cutlass.Float8E4M3FN, cutlass.Float8E8M0FNU, 32, cutlass.BFloat16,
+                TACTIC[0], TACTIC[1], n, k, 1, "k", "k", "n", swap_ab=TACTIC[2],
+            )
+        )
+
+    return runner, can_implement, quantize
+
+
+def prepare_layer(layer: torch.nn.Module, weight_block_size, scale_fmt) -> None:
+    """Called after weight loading for block-quantized FP8 linears when the switch is on."""
+    s = settings()
+    if s is None:
+        return
+    layer.ds41_mu_b12x_ready = False
+    n, k = layer.weight.shape
+    if (n, k) not in s.shapes:
+        return
+    STATS["allowed"] += 1
+    from sglang.srt.layers.quantization.fp8_utils import block_fp8_scale_to_mxfp8_e8m0
+
+    try:
+        if list(weight_block_size or []) != [32, 32]:
+            raise ValueError(f"weight_block_size {weight_block_size} != [32, 32]")
+        if scale_fmt != "ue8m0":
+            raise ValueError(f"scale_fmt {scale_fmt!r} != 'ue8m0'")
+        if layer.weight.dtype != torch.float8_e4m3fn:
+            raise ValueError(f"weight dtype {layer.weight.dtype} != float8_e4m3fn")
+        _, can_implement, _ = _runtime()
+        if not can_implement(n, k):
+            raise ValueError(f"b12x tile {TACTIC[0]} cannot implement N={n} K={k}")
+        scale_u8 = block_fp8_scale_to_mxfp8_e8m0(layer.weight_scale_inv.data, (n, k), [32, 32])
+        from flashinfer import block_scale_interleave
+
+        swz = block_scale_interleave(scale_u8.contiguous()).contiguous()
+    except ValueError as e:
+        STATS["failed"] += 1
+        logger.warning("[MXFP8-B12X] layer N=%d K=%d stays on Triton: %s (failed=%d)", n, k, e, STATS["failed"])
+        return
+    layer.ds41_mu_b12x_scale_swz = torch.nn.Parameter(swz, requires_grad=False)
+    layer.ds41_mu_b12x_ready = True
+    STATS["ready"] += 1
+    STATS["extra_bytes"] += swz.numel() * swz.element_size()
+    logger.info("[MXFP8-B12X] layer N=%d K=%d ready (allowed=%d ready=%d failed=%d extra=%.1f MiB)",
+                n, k, STATS["allowed"], STATS["ready"], STATS["failed"], STATS["extra_bytes"] / 2**20)
+
+
+def _log_path_once(n: int, k: int, m: int, path: str, why: str = "") -> None:
+    key = (n, k, m, path)
+    if key not in _path_logged:
+        _path_logged.add(key)
+        logger.info("[MXFP8-B12X] N=%d K=%d M=%d path=%s%s", n, k, m, path, f" ({why})" if why else "")
+
+
+def wants(layer: torch.nn.Module, x) -> bool:
+    """True when this call goes to b12x; logs (once per shape/M) why an allowed layer does not."""
+    if not getattr(layer, "ds41_mu_b12x_ready", False):
+        return False
+    n, k = layer.weight.shape
+    if not torch.is_tensor(x):
+        _log_path_once(n, k, -1, "triton", "pre-quantized tuple input")
+        return False
+    m = x.numel() // x.shape[-1]
+    if x.dtype != torch.bfloat16:
+        _log_path_once(n, k, m, "triton", f"input dtype {x.dtype}")
+        return False
+    if m > settings().max_m or m == 0:
+        _log_path_once(n, k, m, "triton", f"M={m} outside 1..{settings().max_m}")
+        return False
+    return True
+
+
+def _maybe_dump(x2: torch.Tensor, n: int, k: int, layer: torch.nn.Module) -> None:
+    s = settings()
+    if s is None or s.dump_dir is None or x2.shape[0] != 1:
+        return
+    if torch.cuda.is_available() and torch.cuda.is_current_stream_capturing():
+        return
+    first = _dump_layer.setdefault((n, k), id(layer))
+    if first != id(layer):
+        return
+    c = _dump_count.get((n, k), 0)
+    if c >= s.dump_n:
+        return
+    _dump_count[(n, k)] = c + 1
+    torch.save(x2.detach().to("cpu", copy=True), os.path.join(s.dump_dir, f"act_N{n}_K{k}_{c:04d}.pt"))
+
+
+def linear(layer: torch.nn.Module, x: torch.Tensor, bias: Optional[torch.Tensor]) -> torch.Tensor:
+    runner, _, quantize = _runtime()
+    n, k = layer.weight.shape
+    x2 = x.reshape(-1, x.shape[-1])
+    m = x2.shape[0]
+    if not x2.is_contiguous():
+        x2 = x2.contiguous()
+    _maybe_dump(x2, n, k, layer)
+    q, a_sf = quantize(x2)  # per-token-group quantizer, scales as swizzled e8m0 bytes
+    out = torch.empty((m, n), dtype=torch.bfloat16, device=x2.device)
+    runner(inputs=[q, layer.weight.t(), a_sf, layer.ds41_mu_b12x_scale_swz, torch.bfloat16, out, None],
+           tactic=TACTIC)
+    _log_path_once(n, k, m, "b12x", f"tactic={TACTIC}")
+    if bias is not None:
+        out = out + bias
+    return out.view(*x.shape[:-1], n)
