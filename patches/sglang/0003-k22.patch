+// Swizzled scale output: derived from per_token_group_quant_8bit_v2.cuh.
+// Row-major ue8m0 activation scales are written as e8m0 bytes directly into the
+// 128x4-swizzled scale-factor layout read by FlashInfer mm_mxfp8 (b12x/cutlass on SM120).
+// The quantization math (absmax, ceil-pow2 scale, fp8 conversion) matches the baseline code path;
+// only the scale store differs. A separate namespace and JIT module leave the baseline kernel unchanged.
+//
+// JIT port of the AOT sgl_per_token_group_quant_8bit_v2 (sgl-kernel).
+//
+// Same math as the AOT v2 kernel (256-bit vectorized loads, 8 threads/128-group,
+// PDL, NaiveScheduler + MaskedLayoutScheduler, ue8m0/float scales, fp8/int8
+// output, fused silu+mul) so it is a drop-in replacement; the only changes vs the
+// AOT source are the launcher (tvm::ffi::TensorView + TensorMatcher + the JIT
+// LaunchKernel/PDL helpers) and the FP8 type alias.
+#include <sgl_kernel/tensor.h>  // TensorMatcher, SymbolicSize/Device
+#include <sgl_kernel/utils.h>   // RuntimeCheck, Panic
+
+#include <sgl_kernel/utils.cuh>  // LaunchKernel, fp8_e4m3_t, SGL_DEVICE, device::PDLWaitPrimary/TriggerSecondary
+#include <sgl_kernel/warp.cuh>   // device::warp::reduce_max
+
+#include <tvm/ffi/container/tensor.h>
+
+#include <cstdint>
+#include <cuda_fp8.h>
+#include <type_traits>
+
+namespace sglang {
+namespace ds41_mu_swz {
+
+// FlashInfer v0.6.18 csrc/nv_internal/tensorrt_llm/kernels/quantization_utils.cuh:995 (get_sf_out_offset_128x4)
+SGL_DEVICE int64_t sf_offset_128x4(int m_idx, int k_idx, int num_col_vecs) {
+  const int32_t inner_k = k_idx % 4;
+  const int32_t inner_m = (m_idx % (32 * 4)) / 32;
+  const int32_t outer_m = m_idx % 32;
+  const int32_t k_tile = k_idx / 4;
+  const int32_t num_k_tiles = (num_col_vecs + 4 - 1) / 4;
+  const int32_t m_tile = m_idx / (32 * 4);
+  return static_cast<int64_t>(m_tile) * num_k_tiles * 512 + static_cast<int64_t>(k_tile) * 512 + outer_m * 16 +
+         inner_m * 4 + inner_k;
+}
+
+constexpr float LOCAL_ABSMAX_ABS = 1e-10f;
+constexpr uint32_t INPUT_PRIMARY_VEC_NUM_BYTES = 32;
+
+template <int THREADS_PER_SUBWARP>
+SGL_DEVICE float GroupReduceMax(float val) {
+  static_assert(
+      (THREADS_PER_SUBWARP & (THREADS_PER_SUBWARP - 1)) == 0 && THREADS_PER_SUBWARP <= 16 && THREADS_PER_SUBWARP >= 1,
+      "THREADS_PER_SUBWARP must be 1, 2, 4, 8, or 16");
+  // Reduce within this thread's contiguous THREADS_PER_SUBWARP-lane subgroup via
+  // the shared warp primitive, but pass an explicit subgroup mask instead of its
+  // default 0xffffffff: the block can be < 32 lanes (subwarps_per_block *
+  // THREADS_PER_SUBWARP, e.g. 1..16), where a full-warp mask names non-existent
+  // lanes and is UB / can hang.
+  constexpr device::warp::mask_t kSub = (device::warp::mask_t{1} << THREADS_PER_SUBWARP) - 1;
+  const device::warp::mask_t mask = kSub << (THREADS_PER_SUBWARP * ((threadIdx.x % 32) / THREADS_PER_SUBWARP));
+  return device::warp::reduce_max<THREADS_PER_SUBWARP>(val, mask);
+}
+
+SGL_DEVICE float silu(const float& val) {
+  // Match the AOT v2 kernel: tanh-based silu on SM100+ (Blackwell), exp-based
+  // elsewhere, so the fused silu+mul output stays bit-identical to the AOT op.
+#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 1000)
+  float half = 0.5f * val;
+  float t = __tanhf(half);
+  return half * (1.0f + t);
+#else
+  return val / (1.0f + __expf(-val));
+#endif
+}
+
+SGL_DEVICE float2 fmul2_rn(float2 a, float2 b) {
+  // Match the AOT v2 kernel: use the __fmul2_rn intrinsic on SM100+.
+#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 1000)
+  return __fmul2_rn(a, b);
+#else
+  float2 result;
+  result.x = a.x * b.x;
+  result.y = a.y * b.y;
+  return result;
+#endif
+}
+
+// Copied from DeepEP.
+SGL_DEVICE float fast_pow2(int x) {
+  uint32_t bits_x = (x + 127) << 23;
+  return __uint_as_float(bits_x);  // type-safe bit cast (no strict-aliasing UB)
+}
+SGL_DEVICE int fast_log2_ceil(float x) {
+  auto bits_x = __float_as_uint(x);  // type-safe bit cast (no strict-aliasing UB)
+  auto exp_x = (bits_x >> 23) & 0xff;
+  auto man_bits = bits_x & ((1 << 23) - 1);
+  return exp_x - 127 + (man_bits != 0);
+}
+
+template <typename T>
+struct DtypeInfo;
+template <>
+struct DtypeInfo<int8_t> {
+  static constexpr float MIN = -128;
+  static constexpr float MAX = 127;
+};
+template <>
+struct DtypeInfo<fp8_e4m3_t> {
+  static constexpr float MIN = -448;
+  static constexpr float MAX = 448;
+};
+
+template <bool ROUND_SCALE, typename dtype_info>
+SGL_DEVICE void calculate_fp8_scales(float amax, float& scale, float& scale_inv) {
+  constexpr float MAX_8BIT_INV = 1.0f / dtype_info::MAX;
+  if constexpr (ROUND_SCALE) {
+    auto exp_scale_inv = fast_log2_ceil(amax * MAX_8BIT_INV);
+    scale = fast_pow2(-exp_scale_inv);
+    scale_inv = fast_pow2(exp_scale_inv);
+  } else {
+    scale_inv = amax * MAX_8BIT_INV;
+    scale = dtype_info::MAX / amax;
+  }
+}
+
+template <bool SCALE_UE8M0, typename OUT_DTYPE_T = std::conditional_t<SCALE_UE8M0, uint8_t, float>>
+SGL_DEVICE OUT_DTYPE_T extract_required_scale_format(float value) {
+  if constexpr (SCALE_UE8M0) {
+    return static_cast<uint8_t>(__float_as_uint(value) >> 23);
+  } else {
+    return value;
+  }
+}
+
+template <bool FUSE_SILU_AND_MUL>
+SGL_DEVICE int compute_input_group_start_offset(
+    int expert_idx,
+    int token_idx,
+    int hidden_dim_group_idx,
+    int hidden_size,
+    int num_tokens_per_expert,
+    int group_size) {
+  return expert_idx * num_tokens_per_expert * hidden_size * (FUSE_SILU_AND_MUL ? 2 : 1) +
+         token_idx * hidden_size * (FUSE_SILU_AND_MUL ? 2 : 1) + hidden_dim_group_idx * group_size;
+}
+
+struct NaiveScheduler {
+  static void compute_exec_config(
+      int threads_per_subwarp,
+      int num_local_experts,
+      int hidden_dim_num_groups,
+      int num_groups,
+      int& subwarps_per_block,
+      dim3& grid,
+      dim3& block) {
+    subwarps_per_block = (num_groups % 16 == 0)  ? 16
+                         : (num_groups % 8 == 0) ? 8
+                         : (num_groups % 4 == 0) ? 4
+                         : (num_groups % 2 == 0) ? 2
+                                                 : 1;
+    grid = dim3(num_groups / subwarps_per_block);
+    block = dim3(subwarps_per_block * threads_per_subwarp);
+  }
+
+  template <bool FUSE_SILU_AND_MUL, int GROUP_SIZE, int THREADS_PER_SUBWARP, typename FUNC>
+  SGL_DEVICE static void execute(
+      const int subwarps_per_block,
+      const int hidden_dim_num_groups,
+      const int32_t* masked_m,
+      const int num_tokens_per_expert,
+      FUNC fn) {
+    constexpr int expert_idx = 0;
+    const int64_t subwarp_id = threadIdx.x / THREADS_PER_SUBWARP;
+    const int lane_id = threadIdx.x % THREADS_PER_SUBWARP;
+    const int64_t group_id = static_cast<int64_t>(blockIdx.x) * subwarps_per_block + subwarp_id;
+
+    int64_t input_group_start_offset;
+    if constexpr (!FUSE_SILU_AND_MUL) input_group_start_offset = group_id * GROUP_SIZE;
+    const int token_idx = group_id / hidden_dim_num_groups;
+    const int hidden_dim_group_idx = group_id % hidden_dim_num_groups;
+    if constexpr (FUSE_SILU_AND_MUL) {
+      const int hidden_size = hidden_dim_num_groups * GROUP_SIZE;
+      input_group_start_offset = compute_input_group_start_offset<FUSE_SILU_AND_MUL>(
+          expert_idx, token_idx, hidden_dim_group_idx, hidden_size, num_tokens_per_expert, GROUP_SIZE);
+    }
+    fn(expert_idx, token_idx, hidden_dim_group_idx, lane_id, input_group_start_offset);
+  }
+};
+
+struct MaskedLayoutScheduler {
+  static constexpr int TOKEN_DIM_BLOCK_NUM_PER_EXPERT = 1024;
+  static constexpr int SUBWARPS_PER_BLOCK = 16;
+
+  static void compute_exec_config(
+      int threads_per_subwarp,
+      int num_local_experts,
+      int hidden_dim_num_groups,
+      int num_groups,
+      int& subwarps_per_block,
+      dim3& grid,
+      dim3& block) {
+    subwarps_per_block = SUBWARPS_PER_BLOCK;
+    host::RuntimeCheck(hidden_dim_num_groups % subwarps_per_block == 0, "hidden_dim_num_groups not divisible by 16");
+    grid = dim3(hidden_dim_num_groups / subwarps_per_block, TOKEN_DIM_BLOCK_NUM_PER_EXPERT, num_local_experts);
+    block = dim3(subwarps_per_block * threads_per_subwarp);
+  }
+
+  template <bool FUSE_SILU_AND_MUL, int GROUP_SIZE, int THREADS_PER_SUBWARP, typename FUNC>
+  SGL_DEVICE static void execute(
+      const int subwarps_per_block,
+      const int hidden_dim_num_groups,
+      const int32_t* masked_m,
+      const int num_tokens_per_expert,
+      FUNC fn) {
+    const int64_t subwarp_id = threadIdx.x / THREADS_PER_SUBWARP;
+    const int lane_id = threadIdx.x % THREADS_PER_SUBWARP;
+    const int expert_idx = blockIdx.z;
+    const int token_idx_start = blockIdx.y;
+    const int64_t hidden_dim_group_idx = static_cast<int64_t>(blockIdx.x) * SUBWARPS_PER_BLOCK + subwarp_id;
+    const int curr_expert_token_num = masked_m[expert_idx];
+    for (int token_idx = token_idx_start; token_idx < curr_expert_token_num;
+         token_idx += TOKEN_DIM_BLOCK_NUM_PER_EXPERT) {
+      const int hidden_size = hidden_dim_num_groups * GROUP_SIZE;
+      const int64_t input_group_start_offset = compute_input_group_start_offset<FUSE_SILU_AND_MUL>(
+          expert_idx, token_idx, hidden_dim_group_idx, hidden_size, num_tokens_per_expert, GROUP_SIZE);
+      fn(expert_idx, token_idx, hidden_dim_group_idx, lane_id, input_group_start_offset);
+    }
+  }
+};
+
+template <
+    typename SCHEDULER,
+    int GROUP_SIZE,
+    int THREADS_PER_SUBWARP,
+    typename T,
+    typename DST_DTYPE,
+    bool IS_COLUMN_MAJOR,
+    bool SCALE_UE8M0,
+    bool FUSE_SILU_AND_MUL,
+    bool kUsePDL,
+    bool SWZ128X4,
+    typename scale_packed_t = std::conditional_t<SCALE_UE8M0 && IS_COLUMN_MAJOR, uint32_t, float>>
+__global__ void per_token_group_quant_8bit_v2_swz_kernel(
+    const T* __restrict__ input,
+    DST_DTYPE* __restrict__ output_q,
+    scale_packed_t* __restrict__ output_s,
+    const int32_t* __restrict__ masked_m,
+    const int subwarps_per_block,
+    const int hidden_dim_num_groups,
+    const int scale_expert_stride,
+    const int scale_hidden_stride,
+    const int num_tokens_per_expert) {
+  using dst_dtype_info = DtypeInfo<DST_DTYPE>;
+  using scale_element_t = std::conditional_t<SCALE_UE8M0 && IS_COLUMN_MAJOR, uint8_t, float>;
+  static_assert(sizeof(scale_packed_t) % sizeof(scale_element_t) == 0);
+  static_assert(!SWZ128X4 || (SCALE_UE8M0 && !IS_COLUMN_MAJOR && !FUSE_SILU_AND_MUL),
+                "SWZ128X4 is only defined for row-major ue8m0 scales without silu");
+
+  device::PDLWaitPrimary<kUsePDL>();
+
+  SCHEDULER::template execute<FUSE_SILU_AND_MUL, GROUP_SIZE, THREADS_PER_SUBWARP>(
+      subwarps_per_block,
+      hidden_dim_num_groups,
+      masked_m,
+      num_tokens_per_expert,
+      [&](const int expert_idx,
+          const int token_idx,
+          const int hidden_dim_group_idx,
+          const int lane_id,
+          const int input_group_start_offset) {
+        constexpr uint32_t INPUT_PRIMARY_VEC_SIZE = INPUT_PRIMARY_VEC_NUM_BYTES / sizeof(T);
+        constexpr uint32_t INPUT_PRIMARY_INT4_SIZE = INPUT_PRIMARY_VEC_NUM_BYTES / sizeof(int4);
+
+        const int offset_num_groups = expert_idx * num_tokens_per_expert * hidden_dim_num_groups +
+                                      token_idx * hidden_dim_num_groups + hidden_dim_group_idx;
+
+        int4 input_primary_int4[INPUT_PRIMARY_INT4_SIZE];
+        T* input_primary_vec = reinterpret_cast<T*>(input_primary_int4);
+        int4 input_secondary_int4[INPUT_PRIMARY_INT4_SIZE];
+        T* input_secondary_vec = reinterpret_cast<T*>(input_secondary_int4);
+
+#pragma unroll
+        for (uint32_t j = 0; j < INPUT_PRIMARY_INT4_SIZE; ++j) {
+          // Ordinary 128-bit vectorized load (LDG.128); .nc gave no measurable
+          // gain on this streaming read-once kernel, so no inline asm.
+          input_primary_int4[j] =
+              reinterpret_cast<const int4*>(input + input_group_start_offset + lane_id * INPUT_PRIMARY_VEC_SIZE)[j];
+        }
+        if constexpr (FUSE_SILU_AND_MUL) {
+          const int secondary_offset = hidden_dim_num_groups * GROUP_SIZE;
+#pragma unroll
+          for (uint32_t j = 0; j < INPUT_PRIMARY_INT4_SIZE; ++j) {
+            input_secondary_int4[j] = reinterpret_cast<const int4*>(
+                input + input_group_start_offset + lane_id * INPUT_PRIMARY_VEC_SIZE + secondary_offset)[j];
+          }
+        }
+
+        constexpr int num_elems_per_pack = static_cast<int>(sizeof(scale_packed_t) / sizeof(scale_element_t));
+        scale_element_t* scale_output;
+        if constexpr (IS_COLUMN_MAJOR) {
+          constexpr int scale_token_stride = 1;
+          const int hidden_idx_packed = hidden_dim_group_idx / num_elems_per_pack;
+          const int pack_idx = hidden_dim_group_idx % num_elems_per_pack;
+          scale_output = reinterpret_cast<scale_element_t*>(output_s) +
+                         (expert_idx * scale_expert_stride * num_elems_per_pack +
+                          hidden_idx_packed * scale_hidden_stride * num_elems_per_pack +
+                          token_idx * scale_token_stride * num_elems_per_pack + pack_idx);
+        } else {
+          static_assert(!SCALE_UE8M0 || std::is_same_v<scale_packed_t, float>);
+          scale_output = reinterpret_cast<scale_element_t*>(output_s) + offset_num_groups;
+        }
+
+        if constexpr (IS_COLUMN_MAJOR and SCALE_UE8M0) {
+          const int remainder_num_groups = hidden_dim_num_groups % num_elems_per_pack;
+          if ((remainder_num_groups != 0) and (hidden_dim_group_idx == hidden_dim_num_groups - 1) and
+              (lane_id < num_elems_per_pack - remainder_num_groups)) {
+            const int shift = 1 + lane_id;
+            *(scale_output + shift) = 0;
+          }
+        }
+
+        float local_absmax = LOCAL_ABSMAX_ABS;
+#pragma unroll
+        for (uint32_t j = 0; j < INPUT_PRIMARY_VEC_SIZE; ++j) {
+          float val;
+          if constexpr (FUSE_SILU_AND_MUL) {
+            T val_lowprec = static_cast<T>(silu(static_cast<float>(input_primary_vec[j]))) * input_secondary_vec[j];
+            val = static_cast<float>(val_lowprec);
+            input_primary_vec[j] = val_lowprec;
+          } else {
+            val = static_cast<float>(input_primary_vec[j]);
+          }
+          local_absmax = fmaxf(local_absmax, fabsf(val));
+        }
+
+        local_absmax = GroupReduceMax<THREADS_PER_SUBWARP>(local_absmax);
+
+        float y_scale, y_scale_inv;
+        // When SCALE_UE8M0, always quantize with the rounded (power-of-2) scale
+        // — not with the exact scale followed by post-hoc rounding.
+        // This matches the official DeepSeek-V4 kernel.py act_quant(scale_fmt="ue8m0")
+        // and avoids a scale mismatch between quantization and downstream GEMM dequant,
+        // which otherwise amplifies error ~14x and degrades EAGLE accept rate on Blackwell.
+        calculate_fp8_scales<SCALE_UE8M0, dst_dtype_info>(local_absmax, y_scale, y_scale_inv);
+        if (lane_id == 0) {
+          if constexpr (SWZ128X4) {
+            // e8m0 byte = exponent field of the power-of-two scale (same as extract_required_scale_format<true>)
+            uint8_t* sf = reinterpret_cast<uint8_t*>(output_s);
+            sf[sf_offset_128x4(token_idx, hidden_dim_group_idx, hidden_dim_num_groups)] =
+                static_cast<uint8_t>(__float_as_uint(y_scale_inv) >> 23);
+            // the last real row also zeroes the padding rows below it (up to the next multiple of 128)
+            if (token_idx == num_tokens_per_expert - 1) {
+              const int rows_padded = ((num_tokens_per_expert + 127) / 128) * 128;
+              for (int r = num_tokens_per_expert; r < rows_padded; ++r) {
+                sf[sf_offset_128x4(r, hidden_dim_group_idx, hidden_dim_num_groups)] = 0;
+                if (hidden_dim_group_idx == hidden_dim_num_groups - 1) {
+                  for (int c = hidden_dim_num_groups; c < ((hidden_dim_num_groups + 3) / 4) * 4; ++c) {
+                    sf[sf_offset_128x4(r, c, hidden_dim_num_groups)] = 0;
+                  }
+                }
+              }
+            }
+            // the last group of each row also zeroes the padding columns to the next multiple of 4
+            if (hidden_dim_group_idx == hidden_dim_num_groups - 1) {
+              const int cols_padded = ((hidden_dim_num_groups + 3) / 4) * 4;
+              for (int c = hidden_dim_num_groups; c < cols_padded; ++c) {
+                sf[sf_offset_128x4(token_idx, c, hidden_dim_num_groups)] = 0;
+              }
+            }
+          } else {
+            *scale_output = extract_required_scale_format < SCALE_UE8M0 && IS_COLUMN_MAJOR > (y_scale_inv);
+          }
+        }
+        float2 y_scale_repeated = {y_scale, y_scale};
+
+        int4 output_buf;
+        if constexpr (std::is_same_v<DST_DTYPE, fp8_e4m3_t>) {
+          const auto output_buf_ptr = reinterpret_cast<__nv_fp8x2_storage_t*>(&output_buf);
+#pragma unroll
+          for (uint32_t j = 0; j < INPUT_PRIMARY_VEC_SIZE; j += 2) {
+            float2 inputx2 = {static_cast<float>(input_primary_vec[j]), static_cast<float>(input_primary_vec[j + 1])};
+            float2 outputx2 = fmul2_rn(inputx2, y_scale_repeated);
+            outputx2.x = fminf(fmaxf(outputx2.x, dst_dtype_info::MIN), dst_dtype_info::MAX);
+            outputx2.y = fminf(fmaxf(outputx2.y, dst_dtype_info::MIN), dst_dtype_info::MAX);
+            output_buf_ptr[j / 2] = __nv_cvt_float2_to_fp8x2(outputx2, __NV_SATFINITE, __NV_E4M3);
+          }
+        } else {
+          const auto output_buf_ptr = reinterpret_cast<DST_DTYPE*>(&output_buf);
+#pragma unroll
+          for (uint32_t j = 0; j < INPUT_PRIMARY_VEC_SIZE; ++j) {
+            float val = static_cast<float>(input_primary_vec[j]);
+            float q_val = fminf(fmaxf(val * y_scale, dst_dtype_info::MIN), dst_dtype_info::MAX);
+            output_buf_ptr[j] = DST_DTYPE(q_val);
+          }
+        }
+
+        // Ordinary 128-bit vectorized store (STG.128); no inline asm.
+        *reinterpret_cast<int4*>(output_q + offset_num_groups * GROUP_SIZE + lane_id * INPUT_PRIMARY_VEC_SIZE) =
+            output_buf;
+      });
+
+  device::PDLTriggerSecondary<kUsePDL>();
+}
+
+// ----------------------------------------------------------------------------
+// Launcher (JIT), swizzled scale output only: row-major input [num_tokens, hidden], group 32, ue8m0, no silu,
+// no masked layout. output_s is a uint8 buffer of round_up(num_tokens,128) * round_up(hidden/32,4) bytes.
+// ----------------------------------------------------------------------------
+template <typename T, typename DST_DTYPE, bool kUsePDL>
+struct PerTokenGroupQuant8bitV2SwzKernel {
+  static void
+  run(tvm::ffi::TensorView input,
+      tvm::ffi::TensorView output_q,
+      tvm::ffi::TensorView output_s,
+      int64_t group_size,
+      int64_t num_groups,
+      int64_t hidden_dim_num_groups,
+      int64_t num_tokens) {
+    if (group_size != 32) {
+      host::Panic("swizzled quantization: group_size must be 32, got ", group_size);
+    }
+    if (num_groups != num_tokens * hidden_dim_num_groups) {
+      host::Panic("swizzled quantization: num_groups mismatch");
+    }
+    constexpr int GS = 32;
+    constexpr int TPS = GS / 16;
+    static_assert((GS / 16) * INPUT_PRIMARY_VEC_NUM_BYTES == GS * static_cast<int>(sizeof(T)));
+    int subwarps_per_block;
+    dim3 grid, block;
+    NaiveScheduler::compute_exec_config(
+        TPS, 1, static_cast<int>(hidden_dim_num_groups), static_cast<int>(num_groups), subwarps_per_block, grid, block);
+    auto kernel = per_token_group_quant_8bit_v2_swz_kernel<
+        NaiveScheduler,
+        GS,
+        TPS,
+        T,
+        DST_DTYPE,
+        /*IS_COLUMN_MAJOR=*/false,
+        /*SCALE_UE8M0=*/true,
+        /*FUSE_SILU_AND_MUL=*/false,
+        kUsePDL,
+        /*SWZ128X4=*/true>;
+    host::LaunchKernel(grid, block, input.device())
+        .enable_pdl(kUsePDL)(
+            kernel,
+            static_cast<const T*>(input.data_ptr()),
+            static_cast<DST_DTYPE*>(output_q.data_ptr()),
+            static_cast<float*>(output_s.data_ptr()),
+            static_cast<const int32_t*>(nullptr),
+            subwarps_per_block,
+            static_cast<int>(hidden_dim_num_groups),
+            0,
+            0,
+            static_cast<int>(num_tokens));
+  }
+};
+
+}  // swizzled quantization namespace
+}  // namespace sglang
diff -ruN a/python/sglang/kernels/ops/quantization/per_token_group_quant_8bit_v2_swz.py b/python/sglang/kernels/ops/quantization/per_token_group_quant_8bit_v2_swz.py
--- a/python/sglang/kernels/ops/quantization/per_token_group_quant_8bit_v2_swz.py	1970-01-01 01:00:00.000000000 +0100
+++ b/python/sglang/kernels/ops/quantization/per_token_group_quant_8bit_v2_swz.py	2026-10-18 12:44:34.830186434 +0200
@@ -0,0 +1,63 @@
+"""Per-token-group (32, ue8m0) FP8 quantizer with the activation scales written
+directly as e8m0 bytes into the 128x4-swizzled layout of FlashInfer ``mm_mxfp8``.
+
+Separate JIT module (``gemm/per_token_group_quant_8bit_v2_swz.cuh``, a copy of the original kernel with one
+extra scale-store flavour), so the original ``per_token_group_quant_8bit_v2`` used by every other path is
+untouched. The FP8 bytes are produced by the original quantization code path; tests compare them with
+``sglang_per_token_group_quant_fp8(x, 32, scale_ue8m0=True)`` byte for byte.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Tuple
+
+import torch
+
+from sglang.kernels.jit.utils import cache_once, is_arch_support_pdl, load_jit, make_cpp_args
+
+if TYPE_CHECKING:
+    from tvm_ffi.module import Module
+
+GROUP = 32
+
+
+@cache_once
+def _jit_module(in_dtype: torch.dtype, out_dtype: torch.dtype, use_pdl: bool) -> Module:
+    args = make_cpp_args(in_dtype, out_dtype, use_pdl)
+    return load_jit(
+        "per_token_group_quant_8bit_v2_swz",
+        *args,
+        cuda_files=["gemm/per_token_group_quant_8bit_v2_swz.cuh"],
+        cuda_wrappers=[
+            (
+                "per_token_group_quant_8bit_v2_swz",
+                f"ds41_mu_swz::PerTokenGroupQuant8bitV2SwzKernel<{args}>::run",
+            )
+        ],
+        # identical flags to the original module, so the quantization math compiles the same way
+        extra_cuda_cflags=["--use_fast_math"],
+    )
+
+
+def swz_scale_numel(m: int, k: int) -> int:
+    """Bytes of the 128x4-swizzled e8m0 scale buffer for an [m, k] activation (group 32)."""
+    if k % GROUP:
+        raise ValueError(f"K={k} must be a multiple of {GROUP}")
+    return ((m + 127) // 128) * 128 * ((k // GROUP + 3) // 4) * 4
+
+
+def per_token_group_quant_fp8_swz128x4(x: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor]:
+    """x: [M, K] bf16, contiguous, K % 32 == 0 -> (q [M, K] float8_e4m3fn, sf uint8 [swz_scale_numel])."""
+    if x.dim() != 2 or not x.is_contiguous():
+        raise ValueError("x must be a contiguous 2D tensor")
+    if x.dtype != torch.bfloat16:
+        raise ValueError(f"x must be bfloat16, got {x.dtype}")
+    m, k = x.shape
+    if k % GROUP:
+        raise ValueError(f"K={k} must be a multiple of {GROUP}")
+    q = torch.empty((m, k), dtype=torch.float8_e4m3fn, device=x.device)
+    sf = torch.empty((swz_scale_numel(m, k),), dtype=torch.uint8, device=x.device)
+    if m > 0:
+        module = _jit_module(x.dtype, q.dtype, is_arch_support_pdl())
+        module.per_token_group_quant_8bit_v2_swz(x, q, sf, GROUP, m * (k // GROUP), k // GROUP, m)
+    return q, sf
diff -ruN a/python/sglang/srt/layers/moe/a1_cache.py b/python/sglang/srt/layers/moe/a1_cache.py
--- a/python/sglang/srt/layers/moe/a1_cache.py	1970-01-01 01:00:00.000000000 +0100
+++ b/python/sglang/srt/layers/moe/a1_cache.py	2026-10-18 12:44:34.835324539 +0200
@@ -0,0 +1,231 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Dynamic GPU expert cache for the KT EP wrapper.
+
+Switch ``SGLANG_DS41_MU_A1_CACHE=1`` (default off: kt_ep_wrapper.py then runs its old code and never imports this
+module). With the switch on, two tables replace the constant split "physical id < num_gpu_experts runs on the GPU":
+
+* ``phys2slot`` (device, int64, one per layer): physical expert id -> GPU slot, or -1 for a CPU expert. The GPU
+  path gathers the slot ids from it instead of masking ids >= num_gpu_experts.
+* the KT mask (pinned host bool tensor owned by kt-kernel, read live by the C++ kernels and the completion doorbell):
+  True = the expert runs on the GPU, so the CPU skips it.
+
+kt-kernel skips masked experts when it loads (TP_MOE<AVX2_MXFP4_MOE_TP>::load_weights and build_e8m0), so an
+expert that starts on the GPU would have no CPU weights once it is evicted. With the switch on, KT therefore loads
+with an empty mask (every expert gets its CPU copy) and the start mask is copied into KT's mask afterwards.
+
+Budget 0 without ``SGLANG_DS41_MU_A1_SWAP``: both tables keep their start value (GPU slot s = physical id s for
+s < num_gpu_experts), which is exactly the old split, so the outputs must stay bit-identical.
+``SGLANG_DS41_MU_A1_SWAP=1`` adds the step hook and the swap machinery of a1_exec.py; a budget > 0 is only
+accepted together with it. Budget 0 with the switch runs the swap machinery without a single swap (bit-identical too).
+"""
+from __future__ import annotations
+
+import logging
+import os
+import re
+from dataclasses import dataclass
+from typing import Mapping, Optional, Tuple
+
+import torch
+
+try:  # inside the fork tree
+    from sglang.srt.layers.moe.a1_policy import PolicyConfig
+except ImportError:  # the offline tests load the file directly: make the sibling importable first
+    import os as _os
+    import sys as _sys
+
+    _here = _os.path.dirname(_os.path.abspath(__file__))
+    if _here not in _sys.path:
+        _sys.path.insert(0, _here)
+    from a1_policy import PolicyConfig  # type: ignore
+
+logger = logging.getLogger(__name__)
+
+ENV_SWITCH = "SGLANG_DS41_MU_A1_CACHE"
+ENV_BUDGET = "SGLANG_DS41_MU_A1_BUDGET"
+ENV_SWAP = "SGLANG_DS41_MU_A1_SWAP"
+ENV_HYSTERESE = "SGLANG_DS41_MU_A1_HYSTERESIS"
+ENV_MIN_RESIDENZ = "SGLANG_DS41_MU_A1_MIN_RESIDENCY"
+ENV_RING = "SGLANG_DS41_MU_A1_RING"
+ENV_STAGER = "SGLANG_DS41_MU_A1_STAGER"
+BUDGETS = ("0", "1", "2", "4")
+_DECIMAL_RX = re.compile(r"[0-9]+(?:\.[0-9]+)?")
+_WHOLE_RX = re.compile(r"[0-9]+")
+RING_DEFAULT = 8       # staging entries = copies in flight at the same time; configurable up to 32
+STAGER_DEFAULT = 1     # stager threads; configurable up to 4
+RING_MIN, RING_MAX = 1, 32
+STAGER_MIN, STAGER_MAX = 1, 4
+HYSTERESE_MIN, HYSTERESE_MAX = 1.0, 10.0
+RESIDENZ_MIN, RESIDENZ_MAX = 0.0, 3600.0
+
+__all__ = [
+    "ENV_SWITCH",
+    "ENV_BUDGET",
+    "ENV_SWAP",
+    "ENV_HYSTERESE",
+    "ENV_MIN_RESIDENZ",
+    "ENV_RING",
+    "ENV_STAGER",
+    "Knobs",
+    "check_env",
+    "knobs",
+    "mask_noop",
+    "start_phys2slot",
+    "start_kt_mask",
+    "kt_load_mask",
+    "apply_start_mask",
+    "check_invariant",
+    "gather_slots_",
+]
+
+
+@dataclass(frozen=True)
+class Knobs:
+    """Runtime settings: hysteresis and minimum residency of the policy, ring size and number of
+    stager threads of the executor. Unset keys keep the defaults below."""
+
+    hysteresis: float = PolicyConfig.hysteresis
+    min_residency_s: float = PolicyConfig.min_residency_s
+    ring: int = RING_DEFAULT
+    stagers: int = STAGER_DEFAULT
+
+
+def _number(env: Mapping[str, str], key: str, default: float, lo: float, hi: float) -> float:
+    """A plain decimal number from the environment (fail-closed): unset or empty -> default; anything that is not
+    exactly digits[.digits] (no sign, no blank, no underscore, no exponent) or lies outside the range raises."""
+    raw = env.get(key)
+    if raw is None or raw.strip() == "":   # a blank value counts as unset, " 32 " below does not
+        return default
+    if not _DECIMAL_RX.fullmatch(raw):
+        raise ValueError(f"A1_ENV: {key}={raw!r} is not a plain decimal number")
+    v = float(raw)
+    if not (lo <= v <= hi):
+        raise ValueError(f"A1_ENV: {key}={raw!r} outside [{lo}, {hi}]")
+    return v
+
+
+def _count(env: Mapping[str, str], key: str, default: int, lo: int, hi: int) -> int:
+    """A whole number from the environment (fail-closed): unset or empty -> default; only digits pass, so a sign, a
+    blank, an underscore or a decimal is rejected instead of being silently accepted by int()."""
+    raw = env.get(key)
+    if raw is None or raw.strip() == "":
+        return default
+    if not _WHOLE_RX.fullmatch(raw):
+        raise ValueError(f"A1_ENV: {key}={raw!r} is not a whole number")
+    v = int(raw, 10)
+    if not (lo <= v <= hi):
+        raise ValueError(f"A1_ENV: {key}={raw!r} outside [{lo}, {hi}]")
+    return v
+
+
+def knobs(environ: Optional[Mapping[str, str]] = None) -> Knobs:
+    """Parse runtime settings (fail-closed): every set key must hold a number inside its range, unset keys keep the
+    default. A typo raises instead of starting with a value nobody meant."""
+    env = os.environ if environ is None else environ
+    k = Knobs(
+        hysteresis=_number(env, ENV_HYSTERESE, PolicyConfig.hysteresis, HYSTERESE_MIN, HYSTERESE_MAX),
+        min_residency_s=_number(env, ENV_MIN_RESIDENZ, PolicyConfig.min_residency_s, RESIDENZ_MIN, RESIDENZ_MAX),
+        ring=_count(env, ENV_RING, RING_DEFAULT, RING_MIN, RING_MAX),
+        stagers=_count(env, ENV_STAGER, STAGER_DEFAULT, STAGER_MIN, STAGER_MAX),
+    )
+    if k.hysteresis < 1.0:  # PolicyConfig.validate repeats this; the message names the environment key
+        raise ValueError(f"A1_ENV: {ENV_HYSTERESE}={k.hysteresis} must be >= 1.0")
+    return k
+
+
+def check_env(environ: Optional[Mapping[str, str]] = None) -> Tuple[int, bool]:
+    """Validate the A1 environment for a switched-on start and return (budget, swap) (fail-closed).
+
+    The switch must be exactly "1"; the budget unset or one of BUDGETS; the swap switch unset, "0" or "1"; a budget
+    > 0 needs swap "1". Anything else raises ValueError, so a typo can never start a half-configured cache."""
+    env = os.environ if environ is None else environ
+    switch = env.get(ENV_SWITCH)
+    if switch != "1":
+        raise ValueError(f"A1_ENV: {ENV_SWITCH} must be '1' when the A1 path is taken, got {switch!r}")
+    budget = env.get(ENV_BUDGET, "0")
+    if budget not in BUDGETS:
+        raise ValueError(f"A1_ENV: {ENV_BUDGET} must be one of {BUDGETS}, got {budget!r}")
+    swap = env.get(ENV_SWAP, "0")
+    if swap not in ("0", "1"):
+        raise ValueError(f"A1_ENV: {ENV_SWAP} must be '0' or '1', got {swap!r}")
+    if budget != "0" and swap != "1":
+        raise ValueError(f"A1_ENV: {ENV_BUDGET}={budget} needs {ENV_SWAP}=1")
+    return int(budget), swap == "1"
+
+
+def mask_noop(topk_ids: torch.Tensor, num_gpu_experts: int) -> torch.Tensor:
+    """Stands in for kt_ep_wrapper.mask_cpu_expert_ids under A1: the gather already set every CPU expert to -1 and
+    left every GPU slot id < num_gpu_experts, so the old masking kernel changed nothing."""
+    return topk_ids
+
+
+def start_phys2slot(num_experts: int, num_gpu_experts: int, device=None) -> torch.Tensor:
+    """Start table: physical ids 0..num_gpu_experts-1 sit in GPU slots 0..num_gpu_experts-1, the rest is -1."""
+    if not (isinstance(num_experts, int) and isinstance(num_gpu_experts, int)):
+        raise TypeError("A1: num_experts and num_gpu_experts must be int")
+    if not (0 <= num_gpu_experts <= num_experts) or num_experts <= 0:
+        raise ValueError(f"A1: bad split num_gpu_experts={num_gpu_experts} num_experts={num_experts}")
+    t = torch.full((num_experts,), -1, dtype=torch.int64)
+    t[:num_gpu_experts] = torch.arange(num_gpu_experts, dtype=torch.int64)
+    return t if device is None else t.to(device)
+
+
+def start_kt_mask(num_experts: int, num_gpu_experts: int) -> torch.Tensor:
+    """Start KT mask (CPU bool): True for physical ids 0..num_gpu_experts-1 (the same mask kt_ep_wrapper builds)."""
+    p2s = start_phys2slot(num_experts, num_gpu_experts)
+    return p2s >= 0
+
+
+def kt_load_mask(gpu_mask: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor]:
+    """create_weights hook: return (mask KT loads with = all False, start mask = a copy of the old mask)."""
+    if gpu_mask.dtype != torch.bool or gpu_mask.dim() != 1:
+        raise ValueError(f"A1: KT mask must be a 1-D bool tensor, got {gpu_mask.dtype} {tuple(gpu_mask.shape)}")
+    return torch.zeros_like(gpu_mask), gpu_mask.clone()
+
+
+def apply_start_mask(kt_mask: torch.Tensor, start_mask: torch.Tensor, layer_idx: int) -> None:
+    """After KT loaded every expert: copy the start mask into KT's own (shared, pinned) mask in place.
+
+    Fail-closed when KT did not load with the empty mask (some expert would lack its CPU copy), when the shapes or
+    dtypes differ. copy_ writes into the existing buffer, whose address the C++ configuration and completion
+    signaling retain."""
+    if kt_mask.dtype != torch.bool or start_mask.dtype != torch.bool:
+        raise RuntimeError(f"A1_KT_MASK layer {layer_idx}: dtype {kt_mask.dtype}/{start_mask.dtype}, need bool")
+    if kt_mask.shape != start_mask.shape:
+        raise RuntimeError(f"A1_KT_MASK layer {layer_idx}: shape {tuple(kt_mask.shape)} != {tuple(start_mask.shape)}")
+    if bool(kt_mask.any()):
+        raise RuntimeError(
+            f"A1_KT_MASK_NOT_EMPTY layer {layer_idx}: KT loaded with {int(kt_mask.sum())} masked experts, "
+            "so those experts have no CPU weights"
+        )
+    kt_mask.copy_(start_mask)
+
+
+def check_invariant(phys2slot: torch.Tensor, kt_mask: torch.Tensor, num_slots: int) -> None:
+    """Host-side invariant on CPU copies: every physical id is either on the GPU (slot >= 0 and mask True) or on
+    the CPU (slot -1 and mask False); GPU slots are in range and used at most once. Raises RuntimeError."""
+    p = phys2slot.detach().to("cpu", torch.int64)
+    m = kt_mask.detach().to("cpu", torch.bool)
+    if p.dim() != 1 or m.dim() != 1 or p.numel() != m.numel():
+        raise RuntimeError(f"A1_INVARIANT shapes {tuple(p.shape)} / {tuple(m.shape)}")
+    on_gpu = p >= 0
+    if bool((p < -1).any()):
+        raise RuntimeError("A1_INVARIANT: slot ids below -1")
+    if not torch.equal(on_gpu, m):
+        bad = torch.nonzero(on_gpu != m).flatten()[:8].tolist()
+        raise RuntimeError(f"A1_INVARIANT: phys2slot and KT mask disagree for physical ids {bad}")
+    slots = p[on_gpu]
+    if slots.numel() and (int(slots.max()) >= num_slots):
+        raise RuntimeError(f"A1_INVARIANT: slot {int(slots.max())} >= {num_slots} GPU slots")
+    if slots.numel() != torch.unique(slots).numel():
+        raise RuntimeError("A1_INVARIANT: a GPU slot holds more than one expert")
+
+
+def gather_slots_(topk_ids: torch.Tensor, phys2slot: torch.Tensor) -> torch.Tensor:
+    """In place: physical expert id -> GPU slot (or -1 for a CPU expert); negative ids stay as they are.
+
+    Same contract as kt_ep_wrapper.mask_cpu_expert_ids (in place, same dtype and shape), with the table taking the
+    place of the constant split. kt_ep_wrapper compiles it like mask_cpu_expert_ids."""
+    slots = phys2slot[topk_ids.clamp(min=0).long()]
+    topk_ids.copy_(torch.where(topk_ids >= 0, slots, topk_ids.long()))
+    return topk_ids
diff -ruN a/python/sglang/srt/layers/moe/a1_exec.py b/python/sglang/srt/layers/moe/a1_exec.py
--- a/python/sglang/srt/layers/moe/a1_exec.py	1970-01-01 01:00:00.000000000 +0100
+++ b/python/sglang/srt/layers/moe/a1_exec.py	2026-10-18 12:44:34.835617165 +0200
@@ -0,0 +1,670 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Device executor of the dynamic GPU expert cache.
+
+Active only with SGLANG_DS41_MU_A1_CACHE=1 and SGLANG_DS41_MU_A1_SWAP=1 (a1_cache.check_env). Pieces:
+
+* per-layer device tables with fixed addresses (CUDA graphs read them on every replay; they are only ever written
+  in place): ``phys2slot`` (gather in the wrapper), a device mirror of KT's mask, ``phys2virt`` (stream prefill) and
+  an int32 routing counter (``index_add_`` captured in the decode graphs);
+* ``step_hook(forward_batch)``, called by ModelRunner.forward before every forward on the scheduler's forward
+  stream: reads finished counter snapshots, feeds decode intervals to SwapController (a1_swap.py), writes the table
+  changes stream-ordered (H2D into the tables, D2H from the device mask into KT's pinned mask: KT reads the mask only
+  after the stream's doorbell), records the read-done event of unpublished slots and hands the
+  copy jobs to the stager;
+* the stager (one thread): copy directly from the checkpoint (np.memmap of the safetensors files), GIL-free
+  ctypes.memmove into a pinned ring entry ([up; gate] like the resident w13), H2D on its own stream after the slot's
+  read-done event, scales through a fixed permutation (= flashinfer.block_scale_interleave, derived and checked at
+  start), canary samples read back before the copy-done event;
+* start self-test (fail-closed, A1_SELFTEST_MISMATCH): checkpoint bytes of resident experts equal the resident slots;
+* event trace (jsonl, SGLANG_DS41_MU_A1_TRACE=<path>) and the A1_STAT window line (SGLANG_DS41_MU_A1_STAT_S).
+
+Optional statistics, policy and staging settings; unset keys retain the default behaviour:
+* Window statistics in ``a1_stat.WindowStats``: interval per ``SGLANG_DS41_MU_A1_STAT_S`` (default 60 s), hit rate OF THE
+  WINDOW with the cumulative value next to it, layers without a CPU expert per decode step, backlog/queue/transit;
+* Policy knobs (``SGLANG_DS41_MU_A1_HYSTERESIS``, ``SGLANG_DS41_MU_A1_MIN_RESIDENCY``) go into the policy; the minimum residency
+  is counted from the moment a slot is PUBLISHED (a1_swap marks it), the clock of the hook is handed down;
+* Staging throughput: ``SGLANG_DS41_MU_A1_RING`` staging entries (default 8, supports up to 32), ``SGLANG_DS41_MU_A1_STAGER``
+  stager threads (default 1, supports up to 4) and, per staged part, the page-cache share (mincore) and the duration.
+"""
+from __future__ import annotations
+
+import ctypes
+import json
+import logging
+import os
+import queue
+import re
+import struct
+import threading
+import time
+from pathlib import Path
+from typing import Dict, List, Optional
+
+import numpy as np
+import torch
+
+try:  # inside the fork tree
+    from sglang.srt.layers.moe.a1_cache import check_env, knobs
+    from sglang.srt.layers.moe.a1_policy import PolicyConfig
+    from sglang.srt.layers.moe.a1_stat import WindowStats, resident_pages, stat_interval_s
+    from sglang.srt.layers.moe.a1_swap import SwapController
+except ImportError:  # the offline tests load the file directly (moe directory on sys.path)
+    from a1_cache import check_env, knobs  # type: ignore
+    from a1_policy import PolicyConfig  # type: ignore
+    from a1_stat import WindowStats, resident_pages, stat_interval_s  # type: ignore
+    from a1_swap import SwapController  # type: ignore
+
+logger = logging.getLogger(__name__)
+
+ENV_TRACE = "SGLANG_DS41_MU_A1_TRACE"
+SNAP_RING = 8          # pinned counter snapshots
+DRAIN_TIMEOUT_S = 60.0
+CANARY = 4096          # bytes per sample, 3 samples per region
+
+# checkpoint names of one routed expert: layers.<l>.ffn.experts.<e>.<w1|w2|w3>.<weight|scale>
+_NAME = re.compile(r"^(?:model\.)?layers\.(\d+)\.(?:ffn|mlp)\.experts\.(\d+)\.(w1|w2|w3)\.(weight|scale)$")
+_PART = {("w1", "weight"): "gate_w", ("w3", "weight"): "up_w", ("w2", "weight"): "down_w",
+         ("w1", "scale"): "gate_s", ("w3", "scale"): "up_s", ("w2", "scale"): "down_s"}
+
+_RT: Optional["A1Runtime"] = None
+
+
+def runtime() -> "A1Runtime":
+    global _RT
+    if _RT is None:
+        _RT = A1Runtime()
+    return _RT
+
+
+def route_count_(topk_ids: torch.Tensor, counts: torch.Tensor, one: torch.Tensor) -> None:
+    """Decode-graph routing counter (captured): counts[physical id] += 1 per routed entry; negative ids (no expert)
+    add nothing. ``one`` (shape (1,), dtype of ``counts``) carries the dtype; counts wrap like int32."""
+    ids = topk_ids.reshape(-1)
+    counts.index_add_(0, ids.clamp(min=0).to(torch.int64), (ids >= 0).to(one.dtype))
+
+
+def counts_delta(now: np.ndarray, prev: np.ndarray) -> np.ndarray:
+    """Per-interval counts from two cumulative int32 snapshots (int64 arrays of the int32 values): the counters wrap
+    at 2**32, an interval never holds 2**31 or more routings of one expert."""
+    d = (now.astype(np.int64) - prev.astype(np.int64)) & 0xFFFFFFFF
+    return d
+
+
+def scatter_tables_(p2s: torch.Tensor, mask: torch.Tensor, ups: torch.Tensor) -> None:
+    """In place on the [layers, experts] tables: rows (layer_idx, phys, slot) set phys2slot[layer_idx, phys] = slot
+    and mask = slot >= 0 (slot -1 = unpublish). Same device for all three; addresses never change."""
+    if ups.dim() != 2 or ups.shape[1] != 3 or ups.dtype != torch.int64:
+        raise RuntimeError(f"A1_EXEC: bad update rows {tuple(ups.shape)} {ups.dtype}")
+    E = p2s.shape[1]
+    flat = ups[:, 0] * E + ups[:, 1]
+    p2s.view(-1).index_copy_(0, flat, ups[:, 2])
+    mask.view(-1).index_copy_(0, flat, ups[:, 2] >= 0)
+
+
+def plan_updates(plan, order) -> list:
+    """Table rows (layer_idx, phys, slot) of one hook plan: unpublish rows carry slot -1. A (layer, phys) pair occurs
+    at most once (index_copy_ with repeated indices is undefined on the GPU), checked here on the host."""
+    ups = [(order[li], p, -1) for li, p, _s in plan.unpublish] + [(order[li], p, s) for li, p, s in plan.publish]
+    if len({(a, b) for a, b, _ in ups}) != len(ups):
+        raise RuntimeError(f"A1_EXEC: hook {plan.hook} changes one expert twice: {ups[:8]}")
+    return ups
+
+
+def virtual_ids(physical_ids: torch.Tensor, p2v_row: torch.Tensor) -> torch.Tensor:
+    """Stream prefill: physical ids -> virtual CPU ids n..E-1 (GPU experts -1, negative ids kept), same dtype; a new
+    tensor."""
+    return torch.where(physical_ids >= 0, p2v_row[physical_ids.clamp(min=0).long()],
+                       physical_ids.long()).to(physical_ids.dtype)
+
+
+def ring_layout(N: int, K: int):
+    """Byte layout of one staging entry: [up_w; gate_w] (= w13 rows of the slot), down_w, [up_s; gate_s], down_s."""
+    off, o = {}, 0
+    for part, nb in (("up_w", N * K // 2), ("gate_w", N * K // 2), ("down_w", K * N // 2),
+                     ("up_s", N * K // 32), ("gate_s", N * K // 32), ("down_s", K * N // 32)):
+        off[part] = (o, nb)
+        o += nb
+    return off, o
+
+
+def canary_offsets(n: int):
+    """Three CANARY-byte samples of a region of n bytes: start, 64-aligned middle (never past n - CANARY), end."""
+    if n < CANARY:
+        raise RuntimeError(f"A1_EXEC: region of {n} bytes < canary {CANARY}")
+    return (0, min((n // 2) & ~63, n - CANARY), n - CANARY)
+
+
+def copy_slot_(dsts, host: torch.Tensor, off: dict, perm: dict, land13: torch.Tensor, land2: torch.Tensor,
+               canary: torch.Tensor) -> None:
+    """The copy of one staged expert into a slot (dsts = w13, w2, w13 scales, w2 scales as flat uint8 views), on
+    the current stream: weights direct, scales through the landing pads and the interleave permutation, then the
+    canary samples of all four destinations into ``canary`` (read back before the copy counts as done)."""
+    w13, w2, s13, s2 = dsts
+    o_w13, n_w13 = off["up_w"][0], 2 * off["up_w"][1]
+    o_w2, n_w2 = off["down_w"]
+    o_s13, n_s13 = off["up_s"][0], 2 * off["up_s"][1]
+    o_s2, n_s2 = off["down_s"]
+    w13.copy_(host[o_w13:o_w13 + n_w13], non_blocking=True)
+    w2.copy_(host[o_w2:o_w2 + n_w2], non_blocking=True)
+    land13.copy_(host[o_s13:o_s13 + n_s13], non_blocking=True)
+    land2.copy_(host[o_s2:o_s2 + n_s2], non_blocking=True)
+    torch.index_select(land13, 0, perm["w13"], out=s13)
+    torch.index_select(land2, 0, perm["w2"], out=s2)
+    k = 0
+    for dst in (w13, w2, s13, s2):
+        for a in canary_offsets(dst.numel()):
+            canary[k:k + CANARY].copy_(dst[a:a + CANARY], non_blocking=True)
+            k += CANARY
+
+
+def canary_expected(host: np.ndarray, off: dict, perm_host: dict) -> np.ndarray:
+    """What copy_slot_ must read back for a staged entry (host bytes): weight samples as staged, scale samples
+    through the permutation."""
+    o_w13, n_w13 = off["up_w"][0], 2 * off["up_w"][1]
+    o_w2, n_w2 = off["down_w"]
+    o_s13, n_s13 = off["up_s"][0], 2 * off["up_s"][1]
+    o_s2, n_s2 = off["down_s"]
+    want = []
+    for o, n in ((o_w13, n_w13), (o_w2, n_w2)):
+        for a in canary_offsets(n):
+            want.append(host[o + a:o + a + CANARY])
+    for o, n, name in ((o_s13, n_s13, "w13"), (o_s2, n_s2, "w2")):
+        src = host[o:o + n]
+        for a in canary_offsets(n):
+            want.append(src[perm_host[name][a:a + CANARY]])
+    return np.concatenate(want)
+
+
+def step_hook(forward_batch) -> None:
+    """ModelRunner.forward entry (A1 swap on). Every error raises: fatal for the run, no numbers (fail-closed)."""
+    rt = _RT
+    if rt is None or not rt.layers:
+        return
+    rt.hook(forward_batch)
+
+
+# ---------------------------------------------------------------------------------------------- checkpoint bytes
+class CheckpointExperts:
+    """Byte ranges of every routed expert in the safetensors checkpoint, served from np.memmap (page cache)."""
+
+    def __init__(self, model_dir: str, N: int, K: int):
+        root = Path(model_dir)
+        index = root / "model.safetensors.index.json"
+        if index.is_file():
+            wmap = json.loads(index.read_text())["weight_map"]
+            files = sorted(set(wmap.values()))
+        else:
+            files = sorted(p.name for p in root.glob("*.safetensors"))
+        if not files:
+            raise RuntimeError(f"A1_CKPT: no safetensors files under {root}")
+        self.sizes = {"gate_w": N * K // 2, "up_w": N * K // 2, "down_w": K * N // 2,
+                      "gate_s": N * K // 32, "up_s": N * K // 32, "down_s": K * N // 32}
+        self.page_size = int(os.sysconf("SC_PAGE_SIZE"))
+        self.maps: Dict[str, np.memmap] = {}
+        self.parts: Dict[tuple, Dict[str, tuple]] = {}
+        for f in files:
+            path = root / f
+            with open(path, "rb") as fh:
+                n = struct.unpack("<Q", fh.read(8))[0]
+                hdr = json.loads(fh.read(n))
+            mm = None
+            for name, meta in hdr.items():
+                m = _NAME.match(name)
+                if m is None:
+                    continue
+                part = _PART[(m.group(3), m.group(4))]
+                a, b = meta["data_offsets"]
+                if b - a != self.sizes[part]:
+                    raise RuntimeError(f"A1_CKPT: {name} has {b - a} bytes, expected {self.sizes[part]}")
+                if mm is None:
+                    mm = self.maps.setdefault(f, np.memmap(path, dtype=np.uint8, mode="r"))
+                key = (int(m.group(1)), int(m.group(2)))
+                if part in self.parts.setdefault(key, {}):
+                    raise RuntimeError(f"A1_CKPT: {name} twice")
+                self.parts[key][part] = (f, 8 + n + a, b - a)
+        for key, d in self.parts.items():
+            if len(d) != 6:
+                raise RuntimeError(f"A1_CKPT: layer {key[0]} expert {key[1]} has parts {sorted(d)}")
+        if not self.parts:
+            raise RuntimeError("A1_CKPT: no routed expert tensors found (name pattern)")
+
+    def addr(self, layer: int, expert: int, part: str):
+        try:
+            f, off, nbytes = self.parts[(layer, expert)][part]
+        except KeyError:
+            raise RuntimeError(f"A1_CKPT: no {part} for layer {layer} expert {expert}") from None
+        return self.maps[f].ctypes.data + off, nbytes
+
+    def resident_share(self, layer: int, expert: int, part: str) -> float:
+        """Share of the part's pages that sat in the page cache before the copy (mincore on the mapping): 1.0 =
+        the whole part comes from the page cache, 0.0 = every page has to be read from the device."""
+        addr, nbytes = self.addr(layer, expert, part)
+        resident, total = resident_pages(addr, nbytes, self.page_size)
+        return resident / total
+
+
+# ---------------------------------------------------------------------------------------------- runtime
+class _Job:
+    __slots__ = ("job", "ev_read", "entry", "copy_done", "enqueued", "error", "t_issue", "t_staged", "parts")
+
+    def __init__(self, job, ev_read):
+        self.job, self.ev_read = job, ev_read
+        self.entry = None
+        self.copy_done = None
+        self.enqueued = threading.Event()
+        self.error: Optional[BaseException] = None
+        self.t_issue = time.perf_counter()
+        self.t_staged = 0.0
+        self.parts = ()  # (part, page-cache share, ms) of every staged part, fed to the window statistics
+
+
+class A1Runtime:
+    def __init__(self):
+        budget, swap = check_env()
+        if not swap:
+            raise RuntimeError("A1_EXEC: the runtime needs SGLANG_DS41_MU_A1_SWAP=1")
+        self.knobs = knobs()
+        self.budget = budget
+        self.layers: Dict[int, tuple] = {}     # layer_idx -> (method, layer module)
+        self.tables = None
+        self.ctl: Optional[SwapController] = None
+        self.ready = False
+        self.trace = None
+        self._jobs: Dict[int, _Job] = {}
+        self._slot_ev: Dict[tuple, torch.cuda.Event] = {}
+        self._snaps: List[tuple] = []            # (hook, mode_decode, event, buf idx)
+        self._snap_prev: Optional[np.ndarray] = None
+        self._snap_prev_meta = (-1, False)
+        self._virt_dirty: set = set()
+        self._snap_i = 0
+        self._last_hook = -1
+        self._last_decode = False
+        self._stat = {"drains": 0}
+        self.stat = self._new_stat(time.monotonic())
+        self._q: "queue.Queue" = queue.Queue()
+        self._free: "queue.Queue" = queue.Queue()
+        self._threads: List[threading.Thread] = []
+        self._fatal: Optional[BaseException] = None
+
+    def _new_stat(self, now: float) -> WindowStats:
+        """Window statistics with the interval from SGLANG_DS41_MU_A1_STAT_S (default 60 s).
+        Tags record the policy settings used for this run."""
+        k = self.knobs
+        return WindowStats(stat_interval_s(), now, tags={"ring": k.ring, "stagers": k.stagers, "budget": self.budget,
+                                                         "hyst": k.hysteresis, "resid": k.min_residency_s})
+
+    # ------------------------------------------------------------------ tables (wrapper, before graph capture)
+    def alloc_layer(self, method) -> None:
+        """create_weights/process_weights time: device rows for this layer (views into [layers, experts] tensors
+        with fixed addresses; a second call for the same layer is refused: A1_RELOAD_UNSUPPORTED)."""
+        L = int(method.kt_config.num_layers or 0)
+        E = int(method.global_num_experts)
+        n = int(method.num_gpu_experts)
+        li = int(method.kt_config.layer_idx)
+        if L <= li:
+            raise RuntimeError(f"A1_EXEC: num_layers {L} <= layer_idx {li}")
+        if self.tables is None:
+            dev = torch.device("cuda", torch.cuda.current_device())
+            p2s = torch.full((L, E), -1, dtype=torch.int64, device=dev)
+            p2s[:, :n] = torch.arange(n, dtype=torch.int64, device=dev)
+            p2v = torch.full((L, E), -1, dtype=torch.int64, device=dev)
+            p2v[:, n:] = torch.arange(n, E, dtype=torch.int64, device=dev)
+            self.tables = {
+                "L": L, "E": E, "n": n, "dev": dev,
+                "p2s": p2s, "p2v": p2v,
+                "mask": p2s >= 0,
+                "counts": torch.zeros((L, E), dtype=torch.int32, device=dev),
+                "one": torch.ones((1,), dtype=torch.int32, device=dev),
+                "rows": set(),
+                "snap": [torch.zeros((L, E), dtype=torch.int32).pin_memory() for _ in range(SNAP_RING)],
+            }
+        t = self.tables
+        if (L, E, n) != (t["L"], t["E"], t["n"]):
+            raise RuntimeError(f"A1_EXEC: layer {li} shape {(L, E, n)} != {(t['L'], t['E'], t['n'])}")
+        if li in t["rows"]:
+            raise RuntimeError(f"A1_RELOAD_UNSUPPORTED: layer {li} allocated twice (weights reloaded under A1)")
+        t["rows"].add(li)
+        method._a1_phys2slot = t["p2s"][li]
+        method._a1_counts = t["counts"][li]
+        method._a1_one = t["one"]
+
+    def register_layer(self, method, layer) -> None:
+        """After KT loaded every expert and the start mask is in place (process_weights_after_loading)."""
+        li = int(method.kt_config.layer_idx)
+        if li in self.layers:
+            raise RuntimeError(f"A1_RELOAD_UNSUPPORTED: layer {li} registered twice")
+        self.layers[li] = (method, layer)
+
+    def to_virtual(self, physical_ids: torch.Tensor, layer_idx: int) -> torch.Tensor:
+        """Stream prefill: physical ids -> virtual CPU ids (GPU experts -1), same dtype; the step was drained."""
+        if self.ctl is not None and int((self.ctl.slot_pub[self._li[layer_idx]] < 0).sum()):
+            raise RuntimeError(f"A1_VIRT_TRANSIT layer {layer_idx}: stream prefill with slots in transit")
+        if self.ctl is not None and self._li[layer_idx] in self._virt_dirty:
+            raise RuntimeError(f"A1_VIRT_STALE layer {layer_idx}: phys2virt not refreshed after a change")
+        return virtual_ids(physical_ids, self.tables["p2v"][layer_idx])
+
+    def virt_to_phys(self, method, experts: List[int]) -> List[int]:
+        """kt_stream_prefill writer: virtual CPU ids of a group -> physical ids of this layer."""
+        if self.ctl is None:
+            return experts
+        li = self._li[int(method.kt_config.layer_idx)]
+        v2p = self._v2p[li]
+        n = self.tables["n"]
+        return [int(v2p[v - n]) for v in experts]
+
+    # ------------------------------------------------------------------ start
+    def _start(self) -> None:
+        t = self.tables
+        order = sorted(self.layers)
+        if not order or set(order) != t["rows"]:
+            raise RuntimeError(f"A1_EXEC: registered layers {order} != allocated rows {sorted(t['rows'])}")
+        from sglang.srt.eplb.expert_location_dispatch import get_global_expert_location_metadata
+
+        p2l_all = get_global_expert_location_metadata().physical_to_logical_map_cpu
+        p2l = np.stack([np.asarray(p2l_all[li].numpy(), dtype=np.int64) for li in order])
+        self._order = order
+        self._li = {li: i for i, li in enumerate(order)}
+        k = self.knobs
+        self.ctl = SwapController(p2l, t["n"], PolicyConfig(budget=float(self.budget), hysteresis=k.hysteresis,
+                                                            min_residency_s=k.min_residency_s),
+                                  max_inflight=k.ring, history=1024)
+        self._v2p = [self.ctl.virt_row(i)[1] for i in range(len(order))]
+        m0, layer0 = self.layers[order[0]]
+        self.N = int(layer0.intermediate_size_per_partition)
+        self.K = int(layer0.hidden_size)
+        self.ckpt = CheckpointExperts(m0.kt_config.weight_path, self.N, self.K)
+        self.copy_stream = torch.cuda.Stream(device=t["dev"], priority=0)
+        self._make_perms()
+        self._make_ring()
+        self._selftest()
+        for i in range(k.stagers):
+            thread = threading.Thread(target=self._stager_loop, name=f"a1-stager-{i}", daemon=True)
+            self._threads.append(thread)
+            thread.start()
+        path = os.environ.get(ENV_TRACE)
+        if path:
+            self.trace = open(path, "x", buffering=1 << 20)
+        self.ready = True
+        logger.info("A1_P2_READY layers=%d slots=%d budget=%s ring=%d stagers=%d hyst=%s resid=%s ckpt_experts=%d",
+                    len(order), t["n"], self.budget, k.ring, k.stagers, k.hysteresis, k.min_residency_s,
+                    len(self.ckpt.parts))
+
+    def _make_perms(self) -> None:
+        """Byte permutation of flashinfer.block_scale_interleave for one expert's w13 and w2 scale matrix, derived
+        from three byte planes of an index tensor (the interleave moves bytes, it does not change them)."""
+        from flashinfer import block_scale_interleave
+
+        N, K, dev = self.N, self.K, self.tables["dev"]
+        self.perm = {}
+        for name, shape in (("w13", (1, 2 * N, K // 32)), ("w2", (1, K, N // 32))):
+            cnt = int(np.prod(shape))
+            idx = torch.arange(cnt, dtype=torch.int64, device=dev)
+            planes = []
+            for b in range(3):
+                pl = ((idx >> (8 * b)) & 0xFF).to(torch.uint8).view(shape)
+                planes.append(block_scale_interleave(pl).reshape(-1).to(torch.int64))
+            perm = planes[0] | (planes[1] << 8) | (planes[2] << 16)
+            if not torch.equal(torch.sort(perm).values, idx):
+                raise RuntimeError(f"A1_SELFTEST_MISMATCH: interleave of {name} scales is not a permutation")
+            self.perm[name] = perm
+        self.perm_host = {k: v.cpu().numpy() for k, v in self.perm.items()}
+
+    def _make_ring(self) -> None:
+        N, K, dev = self.N, self.K, self.tables["dev"]
+        self.off, o = ring_layout(N, K)
+        self.entry_bytes = o
+        self.ring = []
+        for i in range(self.knobs.ring):
+            self.ring.append({
+                "host": torch.empty(o, dtype=torch.uint8).pin_memory(),
+                "land13": torch.empty(2 * N * K // 32, dtype=torch.uint8, device=dev),
+                "land2": torch.empty(K * N // 32, dtype=torch.uint8, device=dev),
+                "canary": torch.empty(4 * 3 * CANARY, dtype=torch.uint8).pin_memory(),
+                "i": i,
+            })
+            self._free.put(i)
+
+    def _stage_host(self, e: dict, layer_idx: int, logical: int) -> None:
+        """Copy the six byte ranges of one expert out of the checkpoint into the staging entry (GIL released during
+        memmove) and note per part how much of it sat in the page cache and how long the copy took."""
+        base = e["host"].data_ptr()
+        parts = []
+        for part, (o, nb) in self.off.items():
+            src, n = self.ckpt.addr(layer_idx, logical, part)
+            if n != nb:
+                raise RuntimeError(f"A1_CKPT: {part} {n} bytes != {nb}")
+            share = self.ckpt.resident_share(layer_idx, logical, part)   # before the copy: cache or device
+            t0 = time.perf_counter()
+            ctypes.memmove(base + o, src, nb)  # GIL released; page cache or NVMe
+            parts.append((part, share, (time.perf_counter() - t0) * 1e3))
+        e["parts"] = tuple(parts)
+
+    def _dst(self, layer_idx: int, slot: int):
+        _, layer = self.layers[layer_idx]
+        return (layer.w13_weight.data[slot].view(torch.uint8).view(-1),
+                layer.w2_weight.data[slot].view(torch.uint8).view(-1),
+                layer.w13_weight_scale_inv.data[slot].view(torch.uint8).view(-1),
+                layer.w2_weight_scale_inv.data[slot].view(torch.uint8).view(-1))
+
+    def _enqueue_copy(self, e: dict, layer_idx: int, slot: int, ev_read) -> torch.cuda.Event:
+        """On the copy stream: wait read-done, H2D weights into the slot, scales via the landing pad + permutation,
+        canary samples D2H; returns the copy-done event."""
+        cs = self.copy_stream
+        with torch.cuda.stream(cs):
+            cs.wait_event(ev_read)
+            copy_slot_(self._dst(layer_idx, slot), e["host"], self.off, self.perm, e["land13"], e["land2"],
+                       e["canary"])
+            done = torch.cuda.Event()
+            done.record(cs)
+        return done
+
+    def _canary_ok(self, e: dict) -> bool:
+        return np.array_equal(canary_expected(e["host"].numpy(), self.off, self.perm_host), e["canary"].numpy())
+
+    def _selftest(self) -> None:
+        """Checkpoint bytes of three resident experts (first, middle, last KT layer; slots 0, n/2, n-1) through the real copy path
+        into a scratch landing slot must equal the resident slot bytes. Fail-closed."""
+        t = self.tables
+        e = self.ring[0]
+        n = t["n"]
+        bad = []
+        for li, s in ((self._order[0], 0), (self._order[len(self._order) // 2], n // 2), (self._order[-1], n - 1)):
+            logical = int(self.ctl.p2l[self._li[li], s])
+            self._stage_host(e, li, logical)
+            res = [x.clone() for x in self._dst(li, s)]
+            # land into a scratch copy of the slot, never into the live slot
+            scratch = [torch.empty_like(x) for x in res]
+            with torch.cuda.stream(self.copy_stream):
+                copy_slot_(scratch, e["host"], self.off, self.perm, e["land13"], e["land2"], e["canary"])
+            self.copy_stream.synchronize()
+            if not self._canary_ok(e):
+                bad.append(f"layer {li} slot {s}: canary of the self-test copy differs")
+            for name, a, b in zip(("w13", "w2", "s13", "s2"), scratch, res):
+                if not torch.equal(a, b):
+                    bad.append(f"layer {li} slot {s} expert {logical} {name}: {int((a != b).sum())} bytes differ")
+        if bad:
+            raise RuntimeError("A1_SELFTEST_MISMATCH: " + "; ".join(bad))
+        logger.info("A1_SELFTEST ok: 3 resident experts, checkpoint bytes == resident slots (w13, w2, scales)")
+
+    # ------------------------------------------------------------------ stager threads
+    def _stager_loop(self) -> None:
+        """One stager thread: wait for a copy job, stage its bytes into a free ring entry, hand it to the copy
+        stream. Several threads (SGLANG_DS41_MU_A1_STAGER, 1..4) overlap the host-side reads of different experts."""
+        try:
+            torch.cuda.set_device(self.tables["dev"])
+            while True:
+                jb = self._q.get()
+                if jb is None:
+                    return
+                i = self._free.get()
+                e = self.ring[i]
+                t0 = time.perf_counter()
+                self._stage_host(e, jb.job.layer_idx, jb.job.logical)
+                jb.t_staged = time.perf_counter() - t0
+                jb.parts = e["parts"]
+                jb.entry = i
+                jb.copy_done = self._enqueue_copy(e, jb.job.layer_idx, jb.job.slot, jb.ev_read)
+                jb.enqueued.set()
+        except BaseException as ex:  # surfaced in the next hook (fatal)
+            self._fatal = ex
+            logger.error("A1 stager failed", exc_info=True)
+
+    # ------------------------------------------------------------------ hook
+    def hook(self, forward_batch) -> None:
+        if torch.cuda.is_current_stream_capturing():
+            return
+        if self._fatal is not None:
+            raise RuntimeError("A1_STAGER_FAILED") from self._fatal
+        if not self.ready:
+            self._start()
+        mode = forward_batch.forward_mode
+        decode = bool(mode.is_decode())
+        tokens = int(forward_batch.input_ids.shape[0]) if getattr(forward_batch, "input_ids", None) is not None else 0
+        ctl, t = self.ctl, self.tables
+        cur = torch.cuda.current_stream(t["dev"])
+        # 1. finished counter snapshots -> decode intervals -> policy
+        while self._snaps and self._snaps[0][2].query():
+            self._consume()
+        # 2. drain before a streamed prefill (its groups need every slot published)
+        from sglang.srt.layers.moe.kt_stream_prefill import STREAM_THRESHOLD
+
+        drain = not decode and STREAM_THRESHOLD > 0 and tokens >= STREAM_THRESHOLD
+        plans = []
+        if drain:
+            self._stat["drains"] += 1
+            for _ in range(64):
+                if ctl.transit() == 0:
+                    break
+                deadline = time.time() + DRAIN_TIMEOUT_S
+                for jb in list(self._jobs.values()):
+                    if not jb.enqueued.wait(max(0.0, deadline - time.time())):
+                        raise RuntimeError("A1_DRAIN_TIMEOUT: a copy was not staged in time")
+                    jb.copy_done.synchronize()
+                plans.append(self._begin(cur, allow_unpublish=False))
+            else:
+                raise RuntimeError("A1_DRAIN_TIMEOUT: slots still in transit")
+            self._refresh_virt(cur)
+        else:
+            plans.append(self._begin(cur, allow_unpublish=True))
+        # 3. counter snapshot (counts up to the previous step); never overwrite an unread one
+        while len(self._snaps) >= SNAP_RING - 1:
+            self._snaps[0][2].synchronize()
+            self._consume()
+        bi = self._snap_i % SNAP_RING
+        self._snap_i += 1
+        t["snap"][bi].copy_(t["counts"], non_blocking=True)
+        ev = torch.cuda.Event()
+        ev.record(cur)
+        self._snaps.append((ctl.hook, decode, ev, bi))
+        self._maybe_stat(ctl, time.monotonic())
+
+    def _consume(self) -> None:
+        """Oldest finished snapshot k: counts up to step k-1 minus counts up to step k-2 = step k-1, which ran with
+        the tables of the previous entry's hook and in its forward mode."""
+        h, was_decode, _ev, bi = self._snaps.pop(0)
+        now = self.tables["snap"][bi].numpy().astype(np.int64)
+        if self._snap_prev is not None:
+            d = counts_delta(now, self._snap_prev)
+            ph, pdec = self._snap_prev_meta
+            counters = self.ctl.account(d[self._order].astype(np.float64), pdec, mask_hook=ph,
+                                        now=time.monotonic())
+            self.stat.step(time.monotonic(), pdec, counters.sel, counters.hits, counters.no_cpu_layers,
+                           counters.active_layers)
+        self._snap_prev = now
+        self._snap_prev_meta = (h, was_decode)
+
+    def _begin(self, cur, allow_unpublish: bool):
+        ctl, t = self.ctl, self.tables
+        now = time.monotonic()
+        done = []
+        for seq, jb in list(self._jobs.items()):
+            if jb.enqueued.is_set() and jb.copy_done.query():
+                if not self._canary_ok(self.ring[jb.entry]):
+                    raise RuntimeError(f"A1_CANARY_MISMATCH: copy {jb.job} landed different bytes")
+                self._free.put(jb.entry)
+                for part, share, ms in jb.parts:   # stage time per source (page cache / device)
+                    self.stat.stage_time(part, share, ms)
+                self.stat.stage_job(jb.t_staged * 1e3)   # duration of one complete staged copy
+                done.append(seq)
+                del self._jobs[seq]
+                self._trace("done", jb.job.layer_idx, jb.job.slot, jb.job.phys)
+        plan = ctl.begin_hook(done, allow_unpublish=allow_unpublish, now=now)
+        if plan.unpublish or plan.publish:
+            self._apply(plan, cur)
+        if plan.record_read_done:
+            ev = torch.cuda.Event()
+            ev.record(cur)  # end of the previous step: the last reader of every slot unpublished here
+            for li, _p, s in plan.unpublish:
+                self._slot_ev[(li, s)] = ev
+        for job in plan.copies:
+            li = self._order[job.layer]
+            xj = _XJob(job.seq, li, job.slot, job.phys, int(ctl.p2l[job.layer, job.phys]))
+            ev_read = self._slot_ev.get((job.layer, job.slot))
+            if ev_read is None:
+                raise RuntimeError(f"A1_EXEC: no read-done event for {xj}")
+            jb = _Job(xj, ev_read)
+            self._jobs[job.seq] = jb
+            self._q.put(jb)
+            self._trace("copy", li, job.slot, job.phys)
+        for li, p, s in plan.unpublish:
+            self._trace("unpublish", self._order[li], s, p)
+        for li, p, s in plan.publish:
+            self._trace("publish", self._order[li], s, p)
+        return plan
+
+    def _apply(self, plan, cur) -> None:
+        """Stream-ordered table writes for this hook: phys2slot and the device mask by one H2D + scatter, KT's
+        pinned mask by one D2H per changed layer, phys2virt rows of changed layers without slots in transit."""
+        t, ctl = self.tables, self.ctl
+        arr = torch.tensor(plan_updates(plan, self._order), dtype=torch.int64).pin_memory()
+        scatter_tables_(t["p2s"], t["mask"], arr.to(t["dev"], non_blocking=True))
+        for li in plan.changed_layers:
+            layer_idx = self._order[li]
+            method, _ = self.layers[layer_idx]
+            method.wrapper.gpu_experts_mask.copy_(t["mask"][layer_idx], non_blocking=True)
+            self._virt_dirty.add(li)
+        self._refresh_virt(cur)
+
+    def _refresh_virt(self, cur) -> None:
+        """phys2virt rows (device) and virt->phys (host) of changed layers, once no slot of the layer is in transit.
+        The pinned sources stay alive through torch's host allocator until their copy ran."""
+        t, ctl = self.tables, self.ctl
+        for li in sorted(self._virt_dirty):
+            if (ctl.slot_pub[li] < 0).any():
+                continue
+            p2v, v2p = ctl.virt_row(li)
+            t["p2v"][self._order[li]].copy_(torch.from_numpy(p2v).pin_memory(), non_blocking=True)
+            self._v2p[li] = v2p
+            self._virt_dirty.discard(li)
+
+    # ------------------------------------------------------------------ trace / stats
+    def _trace(self, what, layer_idx, slot, phys) -> None:
+        if self.trace is not None:
+            self.trace.write(json.dumps({"t": time.time_ns(), "hook": self.ctl.hook, "ev": what, "layer": layer_idx,
+                                         "slot": slot, "phys": phys}) + "\n")
+
+    def _maybe_stat(self, ctl, now: float) -> None:
+        """Emit the statistics line when its window is over: hit rate OF THE WINDOW, cumulative rate next to it,
+        the layer picture, the queue and the stage times split by source."""
+        st = ctl.stats
+        self.stat.state(len(ctl.queue) + len(ctl.inflight), len(ctl.queue), len(self._jobs), ctl.transit(),
+                        self._stat["drains"])
+        line = self.stat.line(now, st["live_hits"], st["live_sel"], ctl.policy.total_hits /
+                              max(ctl.policy.total_selections, 1.0),
+                              cum={"policy_swaps": st["policy_swaps"], "copies": st["copies"],
+                                   "published": st["published"], "dropped": st["dropped"]})
+        if line is None:
+            return
+        logger.info("%s", line)
+        if self.trace is not None:
+            self.trace.flush()
+
+
+class _XJob:
+    __slots__ = ("seq", "layer_idx", "slot", "phys", "logical")
+
+    def __init__(self, seq, layer_idx, slot, phys, logical):
+        self.seq, self.layer_idx, self.slot, self.phys, self.logical = seq, layer_idx, slot, phys, logical
+
+    def __repr__(self):
+        return f"copy(seq={self.seq}, layer={self.layer_idx}, slot={self.slot}, phys={self.phys})"
