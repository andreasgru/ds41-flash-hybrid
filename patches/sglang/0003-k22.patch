--- a/python/sglang/srt/layers/moe/a1_policy.py	1970-01-01 01:00:00.000000000 +0100
+++ b/python/sglang/srt/layers/moe/a1_policy.py	2026-10-18 12:44:34.835468062 +0200
@@ -0,0 +1,234 @@
+"""Dynamic GPU expert cache policy (A1): decayed LFU with hysteresis and a per-token swap budget.
+
+Pure library: numpy only, no torch. One `ExpertCachePolicy` instance holds, per MoE layer,
+  * a permutation physical -> logical expert (`p2l`); physical slots 0..slots-1 are the GPU slots,
+    physical slots slots..num_experts-1 are CPU positions (same convention as the fork's
+    `--init-expert-location` / `physical_to_logical_map`),
+  * a decayed routing score per logical expert,
+  * a swap credit per layer.
+
+Per decode step the caller passes routing counts (layers x num_experts, how often each logical expert was
+selected in this step, summed over the batch rows) and receives a list of `Swap`s that respect the budget.
+The policy commits the swaps to its own map immediately; the caller is responsible for copying the
+weights and publishing the new map only after the copy event.
+
+Policy update semantics:
+  score *= 0.5 ** (1 / half_life); score += counts
+  credit = min(credit + budget / layers, credit_cap)
+  up to `max_rounds` rounds: for every layer with credit >= 1, admit the best uncached expert and evict the
+  worst cached one if score_admit > score_evict * hysteresis + margin (strict), credit -= 1.
+"""
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+
+import numpy as np
+
+__all__ = ["Swap", "StepResult", "ExpertCachePolicy", "PolicyConfig"]
+
+
+@dataclass(frozen=True)
+class Swap:
+    """One expert exchange in one layer.
+
+    `gpu_slot` (physical index < slots) changes its content from `evict` to `admit`;
+    `cpu_slot` (physical index >= slots) that held `admit` now holds `evict`.
+    """
+
+    layer: int
+    gpu_slot: int
+    cpu_slot: int
+    evict: int
+    admit: int
+
+
+@dataclass(frozen=True)
+class StepResult:
+    swaps: tuple[Swap, ...]
+    hits: float       # routed selections that hit a GPU-resident expert (map before this step's swaps)
+    selections: float  # all routed selections in this step
+
+
+@dataclass(frozen=True)
+class PolicyConfig:
+    half_life: float = 512.0   # decode tokens; math.inf = no decay
+    hysteresis: float = 1.25
+    margin: float = 0.05
+    budget: float = 2.0        # swaps per decode step summed over all layers (credit budget/layers per layer)
+    credit_cap: float = 3.0
+    max_rounds: int = 3
+    min_residency_s: float = 0.0   # an expert admitted to a slot is protected for that many seconds (0 = off)
+
+    def validate(self) -> None:
+        if not (isinstance(self.half_life, (int, float)) and self.half_life > 0) or math.isnan(self.half_life):
+            raise ValueError(f"half_life must be > 0, got {self.half_life!r}")
+        for name in ("hysteresis", "margin", "budget", "credit_cap", "min_residency_s"):
+            v = getattr(self, name)
+            if not isinstance(v, (int, float)) or not math.isfinite(v):
+                raise ValueError(f"{name} must be a finite number, got {v!r}")
+        if self.hysteresis < 1.0:
+            raise ValueError(f"hysteresis must be >= 1.0, got {self.hysteresis}")
+        if self.margin < 0.0:
+            raise ValueError(f"margin must be >= 0, got {self.margin}")
+        if self.budget < 0.0:
+            raise ValueError(f"budget must be >= 0, got {self.budget}")
+        if self.credit_cap < 1.0:
+            raise ValueError(f"credit_cap must be >= 1, got {self.credit_cap}")
+        if self.min_residency_s < 0.0:
+            raise ValueError(f"min_residency_s must be >= 0, got {self.min_residency_s}")
+        if not isinstance(self.max_rounds, int) or self.max_rounds < 1:
+            raise ValueError(f"max_rounds must be an int >= 1, got {self.max_rounds!r}")
+
+    @property
+    def decay(self) -> float:
+        return 1.0 if math.isinf(self.half_life) else 0.5 ** (1.0 / self.half_life)
+
+
+class ExpertCachePolicy:
+    def __init__(self, p2l, slots: int, config: PolicyConfig | None = None, score0=None):
+        """p2l: (layers, num_experts) permutation physical -> logical; the first `slots` entries per layer are
+        the GPU-resident experts at start. score0: optional (layers, num_experts) start scores indexed by
+        logical expert; default 1.0 for GPU-resident experts, 0.0 otherwise."""
+        self.cfg = config or PolicyConfig()
+        self.cfg.validate()
+        p2l = np.asarray(p2l)
+        if p2l.ndim != 2 or p2l.shape[0] < 1 or p2l.shape[1] < 2:
+            raise ValueError(f"p2l must be 2-D (layers, experts), got shape {p2l.shape}")
+        if not np.issubdtype(p2l.dtype, np.integer):
+            raise ValueError(f"p2l must be integer, got {p2l.dtype}")
+        self.layers, self.num_experts = int(p2l.shape[0]), int(p2l.shape[1])
+        expect = np.arange(self.num_experts)
+        if not (np.sort(p2l, axis=1) == expect[None, :]).all():
+            raise ValueError("p2l rows must be permutations of 0..num_experts-1")
+        if not isinstance(slots, (int, np.integer)) or not (1 <= int(slots) < self.num_experts):
+            raise ValueError(f"slots must be an int in [1, {self.num_experts - 1}], got {slots!r}")
+        self.slots = int(slots)
+        self.p2l = p2l.astype(np.int64).copy()
+        self.l2p = np.empty_like(self.p2l)
+        np.put_along_axis(self.l2p, self.p2l, np.broadcast_to(expect, self.p2l.shape), axis=1)
+        self.mask = self.l2p < self.slots  # (layers, experts) by logical id
+        if score0 is None:
+            self.score = self.mask.astype(np.float64)
+        else:
+            s = np.asarray(score0, dtype=np.float64)
+            if s.shape != self.mask.shape or not np.isfinite(s).all() or (s < 0).any():
+                raise ValueError("score0 must be finite, >= 0 and of shape (layers, experts)")
+            self.score = s.copy()
+        self.credit = np.zeros(self.layers)
+        # Time an expert was last admitted to a slot (seconds of the caller's clock); -inf = settled (the start
+        # placement), so a fresh cache is evictable right away. Read only while min_residency_s > 0.
+        self.t_admit = np.full(self.mask.shape, -np.inf, dtype=np.float64)
+        self._lay = np.arange(self.layers)
+        self.steps = 0
+        self.total_swaps = 0
+        self.total_hits = 0.0
+        self.total_selections = 0.0
+
+    # ------------------------------------------------------------------ inputs
+    def counts_from_topk(self, topk_ids) -> np.ndarray:
+        """(rows, layers, k) logical expert ids -> (layers, experts) counts. Invalid ids (< 0 or >= experts)
+        raise: a silent drop would bias the hit rate."""
+        ids = np.asarray(topk_ids)
+        if ids.ndim == 2:
+            ids = ids[None]
+        if ids.ndim != 3 or ids.shape[1] != self.layers or ids.shape[0] < 1 or ids.shape[2] < 1:
+            raise ValueError(f"topk_ids must be (rows, {self.layers}, k), got {np.asarray(topk_ids).shape}")
+        if not np.issubdtype(ids.dtype, np.integer):
+            raise ValueError(f"topk_ids must be integer, got {ids.dtype}")
+        if ids.min() < 0 or ids.max() >= self.num_experts:
+            raise ValueError(f"topk_ids out of range [0, {self.num_experts}): min {ids.min()} max {ids.max()}")
+        c = np.zeros((self.layers, self.num_experts))
+        lay = np.broadcast_to(self._lay[None, :, None], ids.shape)
+        np.add.at(c, (lay.ravel(), ids.astype(np.int64).ravel()), 1.0)
+        return c
+
+    # ------------------------------------------------------------------ step
+    def step(self, counts, now: float | None = None) -> StepResult:
+        """One decode step. counts: (layers, experts) routing selections per logical expert (>= 0).
+        ``now``: clock in seconds; with ``min_residency_s > 0`` an expert whose admission is younger than that is
+        never evicted (a layer whose whole cache is still protected makes no swap). ``now=None`` = no protection."""
+        c = np.asarray(counts, dtype=np.float64)
+        if c.shape != (self.layers, self.num_experts):
+            raise ValueError(f"counts must have shape {(self.layers, self.num_experts)}, got {c.shape}")
+        if not np.isfinite(c).all() or (c < 0).any():
+            raise ValueError("counts must be finite and >= 0")
+        cfg = self.cfg
+        hits = float((c * self.mask).sum())
+        sel = float(c.sum())
+        self.score *= cfg.decay
+        self.score += c
+        self.credit = np.minimum(self.credit + cfg.budget / self.layers, cfg.credit_cap)
+        swaps: list[Swap] = []
+        lay = self._lay
+        protect = cfg.min_residency_s > 0.0
+        if protect and (now is None or not math.isfinite(float(now))):
+            raise RuntimeError(
+                f"A1_POLICY: min_residency_s={cfg.min_residency_s} needs a finite clock, got now={now!r} "
+                f"(step(..., now=...))")
+        for _ in range(cfg.max_rounds):
+            go = self.credit >= 1.0
+            if not go.any():
+                break
+            admit = np.where(self.mask, -np.inf, self.score).argmax(axis=1)
+            if protect:
+                old_enough = (float(now) - self.t_admit) >= cfg.min_residency_s
+                evictable = (self.mask & old_enough).any(axis=1)
+                evict = np.where(self.mask & old_enough, self.score, np.inf).argmin(axis=1)
+            else:
+                evictable = np.ones(self.layers, dtype=bool)
+                evict = np.where(self.mask, self.score, np.inf).argmin(axis=1)
+            gain = self.score[lay, admit] > self.score[lay, evict] * cfg.hysteresis + cfg.margin
+            do = go & gain & evictable
+            if not do.any():
+                break
+            for li in np.nonzero(do)[0]:
+                swaps.append(self._apply(int(li), int(evict[li]), int(admit[li]), now))
+            self.credit[do] -= 1.0
+        self.steps += 1
+        self.total_swaps += len(swaps)
+        self.total_hits += hits
+        self.total_selections += sel
+        return StepResult(tuple(swaps), hits, sel)
+
+    def mark_resident(self, layer: int, expert: int, now: float) -> None:
+        """The expert was published in a slot at ``now`` -- its protection starts here. Public because in the
+        executor the policy's decision is only a target: the slot gets the bytes later (a1_swap.publish)."""
+        if not (0 <= int(layer) < self.layers) or not (0 <= int(expert) < self.num_experts):
+            raise ValueError(f"mark_resident({layer}, {expert}) outside {(self.layers, self.num_experts)}")
+        if not np.isfinite(now):
+            raise ValueError(f"mark_resident: now={now!r} is not finite")
+        self.t_admit[int(layer), int(expert)] = float(now)
+
+    def _apply(self, layer: int, evict: int, admit: int, now: float | None = None) -> Swap:
+        gs = int(self.l2p[layer, evict])
+        cs = int(self.l2p[layer, admit])
+        if not (gs < self.slots <= cs):  # internal invariant; never expected
+            raise RuntimeError(f"invariant broken in layer {layer}: evict slot {gs}, admit slot {cs}")
+        self.p2l[layer, gs], self.p2l[layer, cs] = admit, evict
+        self.l2p[layer, admit], self.l2p[layer, evict] = gs, cs
+        self.mask[layer, admit] = True
+        self.mask[layer, evict] = False
+        if self.cfg.min_residency_s > 0.0 and now is not None:
+            self.t_admit[layer, admit] = float(now)
+            self.t_admit[layer, evict] = -np.inf
+        return Swap(layer, gs, cs, evict, admit)
+
+    # ------------------------------------------------------------------ checks
+    def check_invariants(self) -> None:
+        """Raise if p2l/l2p/mask disagree (used by tests and by executor debug builds)."""
+        expect = np.arange(self.num_experts)
+        if not (np.sort(self.p2l, axis=1) == expect[None, :]).all():
+            raise AssertionError("p2l is not a permutation")
+        if not (np.take_along_axis(self.l2p, self.p2l, axis=1) == expect[None, :]).all():
+            raise AssertionError("l2p is not the inverse of p2l")
+        if not ((self.l2p < self.slots) == self.mask).all():
+            raise AssertionError("mask disagrees with l2p")
+        if not (self.mask.sum(axis=1) == self.slots).all():
+            raise AssertionError("cached count per layer != slots")
+
+    @property
+    def hit_rate(self) -> float:
+        if self.total_selections <= 0:
+            raise ValueError("no selections observed")
+        return self.total_hits / self.total_selections
