--- a/python/sglang/srt/layers/moe/a1_stat.py	1970-01-01 01:00:00.000000000 +0100
+++ b/python/sglang/srt/layers/moe/a1_stat.py	2026-10-18 12:44:34.836072504 +0200
@@ -0,0 +1,236 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Window statistics and the page-cache probe of the dynamic expert cache.
+
+Pure python/numpy plus libc, no torch, so the numbers can be checked without a device:
+
+* ``WindowStats``: the executor feeds it one decode step (routing selections, hits, layers without a CPU expert)
+  and every finished copy (stage milliseconds, source class). Once per ``interval_s`` it renders ONE log line
+  ``A1_STAT ...`` whose hit rate belongs to THAT WINDOW (the cumulative value is printed next to it).
+* ``stat_interval_s``: ``SGLANG_DS41_MU_A1_STAT_S`` (fail-closed, default 60.0 seconds).
+* ``resident_pages``: mincore(2) on the checkpoint mapping, so a stage time can be attributed to the page cache or
+  to the NVMe device.
+
+The clock is passed in, never read inside: the executor hands over ``time.monotonic()``, the offline tests replay
+recorded hook times from ``a1-trace.jsonl`` or a declared step time base.
+"""
+from __future__ import annotations
+
+import ctypes
+import os
+from typing import Mapping, Optional
+
+import numpy as np
+
+ENV_STAT_S = "SGLANG_DS41_MU_A1_STAT_S"
+STAT_S_DEFAULT = 60.0
+STAT_S_MIN = 0.05
+STAT_S_MAX = 3600.0
+STAGE_SAMPLES = 256      # stage samples kept per window and class (percentiles need a bounded buffer)
+RESIDENT_CLASSES = ("resident", "disk")
+CHECKPOINT_PARTS = ("gate_w", "up_w", "down_w", "gate_s", "up_s", "down_s")   # names of a1_exec.CheckpointExperts
+
+__all__ = ["ENV_STAT_S", "STAT_S_DEFAULT", "STAGE_SAMPLES", "WindowStats", "stat_interval_s", "resident_pages",
+           "percentiles"]
+
+
+def stat_interval_s(environ: Optional[Mapping[str, str]] = None) -> float:
+    """``STAT_S`` from the environment: unset or empty -> STAT_S_DEFAULT (60 s); otherwise a finite
+    number inside [STAT_S_MIN, STAT_S_MAX]. Every other value raises (A1_ENV), never a silent default."""
+    env = os.environ if environ is None else environ
+    raw = env.get(ENV_STAT_S)
+    if raw is None or raw.strip() == "":
+        return STAT_S_DEFAULT
+    try:
+        v = float(raw)
+    except (TypeError, ValueError):
+        raise RuntimeError(f"A1_ENV: {ENV_STAT_S}={raw!r} is not a number") from None
+    if not np.isfinite(v) or not (STAT_S_MIN <= v <= STAT_S_MAX):
+        raise RuntimeError(f"A1_ENV: {ENV_STAT_S}={raw!r} outside [{STAT_S_MIN}, {STAT_S_MAX}]")
+    return v
+
+
+def percentiles(values, qs=(50.0, 99.0)):
+    """Percentiles of a non-empty sequence (numpy's linear interpolation); raises on an empty input."""
+    a = np.asarray(values, dtype=np.float64)
+    if a.size == 0:
+        raise ValueError("percentiles of an empty sample")
+    return tuple(float(np.percentile(a, q)) for q in qs)
+
+
+_LIBC = None
+
+
+def _libc():
+    """libc handle for mincore(2), built once (the executor calls the probe six times per staged copy)."""
+    global _LIBC
+    if _LIBC is None:
+        lib = ctypes.CDLL("libc.so.6", use_errno=True)
+        lib.mincore.restype = ctypes.c_int
+        lib.mincore.argtypes = (ctypes.c_void_p, ctypes.c_size_t, ctypes.c_char_p)
+        _LIBC = lib
+    return _LIBC
+
+
+def resident_pages(addr: int, nbytes: int, page_size: Optional[int] = None) -> tuple[int, int]:
+    """(resident, total) pages of the file mapping that covers ``[addr, addr + nbytes)`` via mincore(2); the start
+    address is rounded down to a page. A resident page sits in the page cache, everything else has to come from the
+    device. Nothing is faulted in here: mincore only reports. Raises RuntimeError with the errno on failure."""
+    if nbytes <= 0:
+        raise ValueError(f"nbytes must be > 0, got {nbytes}")
+    ps = int(page_size or os.sysconf("SC_PAGE_SIZE"))
+    if ps <= 0 or ps & (ps - 1):
+        raise ValueError(f"page size {ps} is not a power of two")
+    start = int(addr) - (int(addr) % ps)
+    span = int(addr) + int(nbytes) - start
+    total = (span + ps - 1) // ps
+    vec = ctypes.create_string_buffer(total)
+    rc = _libc().mincore(ctypes.c_void_p(start), ctypes.c_size_t(span), vec)
+    if rc != 0:
+        err = ctypes.get_errno()
+        raise RuntimeError(f"A1_STAT: mincore({start:#x}, {span}) failed with errno {err}")
+    raw = vec.raw[:total]
+    resident = sum(1 for b in raw if b & 1)
+    return resident, total
+
+
+class WindowStats:
+    """Counters of one statistics window; ``line()`` renders and resets when the interval is over.
+
+    ``step`` counts a decode step (``sel`` routed selections, ``hits`` of them on a GPU-resident expert,
+    ``no_cpu_layers`` MoE layers whose selections all landed on GPU experts, ``active_layers`` layers with at least
+    one selection). ``state`` carries the queue picture of the last hook, ``stage`` one finished copy.
+    """
+
+    def __init__(self, interval_s: float, start: float, tags: Optional[Mapping[str, object]] = None):
+        if not np.isfinite(interval_s) or interval_s <= 0:
+            raise ValueError(f"interval_s must be finite and > 0, got {interval_s!r}")
+        self.interval_s = float(interval_s)
+        self.tags = dict(tags or {})
+        for key, value in self.tags.items():
+            if not key.isidentifier() or not isinstance(value, (int, float, str)):
+                raise ValueError(f"A1_STAT: tag {key!r}={value!r} is not a plain key/value pair")
+        self.windows = 0
+        self.drains_total = 0      # cumulative over the run, never reset per window
+        self.backlog_max_cum = 0   # same for the backlog maximum
+        self.reset(float(start))
+
+    def reset(self, now: float) -> None:
+        self.t_start = float(now)
+        self.steps = 0
+        self.dec_steps = 0
+        self.sel = 0.0
+        self.hits = 0.0
+        self.no_cpu = []
+        self.active = []
+        self.stage = {name: [] for name in RESIDENT_CLASSES}   # per staged PART (six per copy)
+        self.stage_job_ms = []                                 # per finished COPY (all six parts)
+        self.hooks = 0
+        self.state_last = {"backlog": 0, "queue": 0, "inflight": 0, "transit": 0}
+        self.backlog_max = 0                                   # maximum of THIS window
+
+    # ------------------------------------------------------------------ inputs
+    def step(self, now: float, decode: bool, sel: float, hits: float, no_cpu_layers: int = 0,
+             active_layers: int = 0) -> None:
+        if not (np.isfinite(sel) and np.isfinite(hits)) or sel < 0 or hits < 0 or hits > sel + 1e-9:
+            raise ValueError(f"A1_STAT: sel={sel!r} hits={hits!r} are not a hit count")
+        self.steps += 1
+        if not decode:
+            return
+        self.dec_steps += 1
+        self.sel += float(sel)
+        self.hits += float(hits)
+        self.no_cpu.append(int(no_cpu_layers))
+        self.active.append(int(active_layers))
+
+    def stage_time(self, part: str, resident_share: float, ms: float) -> None:
+        """One finished staged part (``part``: checkpoint part name): ``resident_share`` = share of its pages that
+        were in the page cache before the copy (>= 0.99 counts as 'resident', else 'disk')."""
+        if not np.isfinite(ms) or ms < 0:
+            raise ValueError(f"A1_STAT: stage time {ms!r} for {part} is not finite and >= 0")
+        if not (0.0 <= resident_share <= 1.0):
+            raise ValueError(f"A1_STAT: resident share {resident_share!r} outside [0, 1]")
+        if part not in CHECKPOINT_PARTS:
+            raise ValueError(f"A1_STAT: unknown checkpoint part {part!r}, expected one of {CHECKPOINT_PARTS}")
+        name = "resident" if resident_share >= 0.99 else "disk"
+        buf = self.stage[name]
+        if len(buf) < STAGE_SAMPLES:
+            buf.append(float(ms))
+
+    def state(self, backlog: int, queue: int, inflight: int, transit: int, drains: int = 0) -> None:
+        """The queue picture at the end of one hook (called once per hook, so it counts the hooks of the window)."""
+        self.state_last = {"backlog": int(backlog), "queue": int(queue), "inflight": int(inflight),
+                           "transit": int(transit)}
+        self.drains_total = int(drains)
+        self.hooks += 1
+        self.backlog_max = max(self.backlog_max, int(backlog))
+        self.backlog_max_cum = max(self.backlog_max_cum, int(backlog))
+
+    # ------------------------------------------------------------------ output
+    def stage_job(self, ms: float) -> None:
+        """Duration of one finished copy (all six parts).
+        The per-part split lives in the resident/disk classes below."""
+        if not np.isfinite(ms) or ms < 0:
+            raise ValueError(f"A1_STAT: stage job time {ms!r} is not finite and >= 0")
+        self.stage_job_ms.append(float(ms))
+
+    def due(self, now: float) -> bool:
+        return (float(now) - self.t_start) >= self.interval_s
+
+    def line(self, now: float, cum_hits: float, cum_sel: float, cum_policy: float = float("nan"),
+             cum: Optional[Mapping[str, object]] = None) -> Optional[str]:
+        """The window line, or None while the interval is still running. Resets the window on emission.
+
+        ``cum`` carries the cumulative counters of the controller (policy_swaps/copies/published/dropped), so the log
+        keeps cumulative counters next to the window numbers. Field names identify their units:
+        ``steps`` = consumed steps of the window, ``hooks`` = hooks of the window,
+        ``backlog_max_win``/``backlog_max_cum`` = backlog maximum of the window / of the run, and the stage times are
+        printed twice: ``stage_job_ms_p50/p99``+``over5ms`` per finished copy and
+        ``stage_part_ms_p50/p99`` per staged part (six per copy), split by source class in ``stage_src``."""
+        if not self.due(now):
+            return None
+        win_s = float(now) - self.t_start
+        c_win = (self.hits / self.sel) if self.sel > 0 else float("nan")
+        c_cum = (cum_hits / cum_sel) if cum_sel > 0 else float("nan")
+        part_ms = [v for name in RESIDENT_CLASSES for v in self.stage[name]]
+        job_ms = self.stage_job_ms
+        if part_ms:
+            part_p50, part_p99 = percentiles(part_ms)
+        else:
+            part_p50 = part_p99 = float("nan")
+        if job_ms:
+            job_p50, job_p99 = percentiles(job_ms)
+            over5 = sum(1 for v in job_ms if v > 5.0) / len(job_ms)
+        else:
+            job_p50 = job_p99 = float("nan")
+            over5 = float("nan")
+        src = []
+        for name in RESIDENT_CLASSES:
+            buf = self.stage[name]
+            src.append(f"{name}:{len(buf)}:{np.mean(buf):.3f}" if buf else f"{name}:0:nan")
+        nc = np.asarray(self.no_cpu, dtype=np.int64)
+        ac = np.asarray(self.active, dtype=np.int64)
+        text = (
+            f"A1_STAT win_s={win_s:.2f} hooks={self.hooks} steps={self.steps} dec={self.dec_steps} "
+            f"sel={self.sel:.0f} c_win={c_win:.4f} c_cum={c_cum:.4f} c_pol={cum_policy:.4f} "
+            f"no_cpu_avg={np.mean(nc) if nc.size else float('nan'):.2f} "
+            f"no_cpu_min={int(nc.min()) if nc.size else -1} no_cpu_max={int(nc.max()) if nc.size else -1} "
+            f"active_avg={np.mean(ac) if ac.size else float('nan'):.1f} "
+            f"backlog={self.state_last['backlog']} backlog_max_win={self.backlog_max} "
+            f"backlog_max_cum={self.backlog_max_cum} queue={self.state_last['queue']} "
+            f"inflight={self.state_last['inflight']} transit={self.state_last['transit']} "
+            f"drains={self.drains_total} "
+            f"stage_job_ms_p50={job_p50:.2f} stage_job_ms_p99={job_p99:.2f} over5ms={over5:.3f} "
+            f"stage_part_ms_p50={part_p50:.2f} stage_part_ms_p99={part_p99:.2f} stage_src={','.join(src)}"
+        )
+        for key in sorted(cum or {}):
+            text += f" {key}={cum[key]}"
+        for key in sorted(self.tags):
+            text += f" {key}={self.tags[key]}"
+        self.windows += 1
+        self.reset(now)
+        return text
+
+    # ------------------------------------------------------------------ views (tests)
+    def window_c(self) -> float:
+        """Hit rate of the window just run (nan without decode selections)."""
+        return (self.hits / self.sel) if self.sel > 0 else float("nan")
