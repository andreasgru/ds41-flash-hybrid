+# SPDX-License-Identifier: Apache-2.0
+"""Host-side swap controller for the dynamic GPU expert cache.
+
+Pure numpy, no torch, no CUDA: this module decides WHAT happens at a step boundary; the executor in a1_cache.py
+does it on the device. Physical expert ids are fixed (the start placement); only two per-layer tables change:
+
+* ``phys2slot`` (physical id -> GPU slot or -1), mirrored here; the device copy and KT's pinned mask
+  (``phys2slot >= 0``) are written from the plans this controller returns.
+* the slot contents, refilled by copy jobs.
+
+Protocol per GPU slot s:
+1. ``unpublish``: the old expert leaves the tables at hook h (lazy: only when its copy is about to start, so the
+   slot keeps serving until then). From step h on nothing reads s.
+2. the copy job carries ``release_hook = h``; the executor makes the copy wait for the read-done event recorded at
+   hook h (= end of step h-1, the last step that could read s).
+3. ``publish``: at a later hook, only after the executor reported the job done (copy event complete, canary ok).
+
+Targets come from the policy as a SET per layer: experts the policy keeps stay in their slot, an
+expert the policy drops and takes back before its slot was refilled simply keeps its slot (no copy). Decisions are
+never capped (the numbers stay those of the oracle); the copies run through at most ``max_inflight`` slots.
+"""
+from __future__ import annotations
+
+import math
+from collections import deque
+from dataclasses import dataclass, field
+
+import numpy as np
+
+try:  # inside the fork tree
+    from sglang.srt.layers.moe.a1_policy import ExpertCachePolicy, PolicyConfig
+except ImportError:  # tests load the file directly
+    from a1_policy import ExpertCachePolicy, PolicyConfig  # type: ignore
+
+__all__ = ["CopyJob", "HookPlan", "SwapController"]
+
+
+@dataclass(frozen=True)
+class CopyJob:
+    seq: int
+    layer: int
+    slot: int
+    phys: int
+    release_hook: int
+
+
+@dataclass
+class HookPlan:
+    hook: int
+    unpublish: list = field(default_factory=list)   # (layer, phys, slot)
+    publish: list = field(default_factory=list)     # (layer, phys, slot)
+    dropped: list = field(default_factory=list)     # seqs whose copy finished for an outdated target
+    copies: list = field(default_factory=list)      # CopyJob
+    changed_layers: tuple = ()
+
+    @property
+    def record_read_done(self) -> bool:
+        return bool(self.unpublish)
+
+    @property
+    def empty(self) -> bool:
+        return not (self.unpublish or self.publish or self.copies or self.dropped)
+
+
+@dataclass(frozen=True)
+class StepCounters:
+    """What one counted step looked like: the swaps the policy decided, the routed selections, the GPU hits and
+    the layer picture of the step -- ``no_cpu_layers`` = MoE layers whose selections all hit GPU experts (their
+    forward never touches the CPU path), ``active_layers`` = layers with at least one selection."""
+
+    swaps: int
+    sel: float
+    hits: float
+    no_cpu_layers: int
+    active_layers: int
+
+
+class SwapController:
+    def __init__(self, p2l, slots: int, config: PolicyConfig | None = None, max_inflight: int = 8,
+                 history: int = 64):
+        p2l = np.asarray(p2l)
+        self.policy = ExpertCachePolicy(p2l, slots, config)  # validates p2l, slots, config
+        if not isinstance(max_inflight, int) or max_inflight < 1:
+            raise ValueError(f"max_inflight must be an int >= 1, got {max_inflight!r}")
+        self.layers, self.num_experts, self.slots = self.policy.layers, self.policy.num_experts, self.policy.slots
+        self.max_inflight = max_inflight
+        self.p2l = p2l.astype(np.int64).copy()  # static: physical -> logical (start placement)
+        self.l2p = np.empty_like(self.p2l)
+        np.put_along_axis(self.l2p, self.p2l, np.broadcast_to(np.arange(self.num_experts), self.p2l.shape), axis=1)
+        L, S, NE = self.layers, self.slots, self.num_experts
+        self.phys2slot = np.full((L, NE), -1, dtype=np.int64)
+        self.phys2slot[:, :S] = np.arange(S)
+        self.slot_pub = np.tile(np.arange(S, dtype=np.int64), (L, 1))   # published physical id, -1 = none
+        self.slot_target = self.slot_pub.copy()                          # wanted physical id
+        self.slot_ready = np.full((L, S), -1, dtype=np.int64)            # copied, not yet published
+        self.slot_seq = np.zeros((L, S), dtype=np.int64)                 # copy in flight (0 = none)
+        self.slot_release = np.full((L, S), -1, dtype=np.int64)          # hook of the last unpublish
+        self.queue: deque = deque()                                      # (layer, slot) waiting for a copy
+        self.inflight: dict[int, CopyJob] = {}
+        self.seq = 0
+        self.hook = -1
+        self._mask_hist: dict[int, np.ndarray] = {-1: self.phys2slot >= 0}
+        self._history = max(2, int(history))
+        self.stats = {"decode_intervals": 0, "other_intervals": 0, "live_hits": 0.0, "live_sel": 0.0,
+                      "policy_swaps": 0, "copies": 0, "published": 0, "dropped": 0, "unpublished": 0,
+                      "backlog_max": 0}
+
+    # ------------------------------------------------------------------ inputs
+    def account(self, counts_phys, decode: bool, mask_hook: int, now: float | None = None) -> StepCounters:
+        """One counted step (counts per physical id, summed over the rows). Live hits use the tables that step ran
+        with (``mask_hook`` = the hook before it). Only decode steps reach the policy (no decay otherwise).
+        ``now``: clock for the minimum residency (required as soon as min_residency_s > 0). Returns the step
+        counters (swaps, selections, hits, layers without a CPU expert)."""
+        c = np.asarray(counts_phys, dtype=np.float64)
+        if c.shape != (self.layers, self.num_experts):
+            raise ValueError(f"counts must have shape {(self.layers, self.num_experts)}, got {c.shape}")
+        if not np.isfinite(c).all() or (c < 0).any():
+            raise ValueError("counts must be finite and >= 0")
+        if mask_hook not in self._mask_hist:
+            raise RuntimeError(f"A1_SWAP: no table state for hook {mask_hook} (history {sorted(self._mask_hist)})")
+        if not decode:
+            self.stats["other_intervals"] += 1
+            return StepCounters(0, 0.0, 0.0, 0, 0)
+        mask = self._mask_hist[mask_hook]
+        sel_l = c.sum(axis=1)
+        cpu_l = (c * ~mask).sum(axis=1)
+        counters = StepCounters(0, float(c.sum()), float((c * mask).sum()),
+                                int(((sel_l > 0) & (cpu_l == 0.0)).sum()), int((sel_l > 0).sum()))
+        self.stats["decode_intervals"] += 1
+        self.stats["live_hits"] += counters.hits
+        self.stats["live_sel"] += counters.sel
+        res = self.policy.step(np.take_along_axis(c, self.l2p, axis=1), now=now)  # logical counts
+        if res.swaps:
+            self.stats["policy_swaps"] += len(res.swaps)
+            for li in sorted({s.layer for s in res.swaps}):
+                self._retarget(li)
+        return StepCounters(len(res.swaps), counters.sel, counters.hits, counters.no_cpu_layers,
+                            counters.active_layers)
+
+    def _retarget(self, li: int) -> None:
+        """Make the layer's slot targets hold exactly the policy's cached set (physical ids)."""
+        want = set(self.l2p[li, np.nonzero(self.policy.mask[li])[0]].tolist())
+        pub, tgt = self.slot_pub[li], self.slot_target[li]
+        new = np.full(self.slots, -1, dtype=np.int64)
+        taken = set()
+        for s in range(self.slots):  # 1) a wanted expert that is still published keeps its slot
+            p = int(pub[s])
+            if p >= 0 and p in want:
+                new[s] = p
+                taken.add(p)
+        for s in range(self.slots):  # 2) a wanted target already on its way keeps its slot
+            t = int(tgt[s])
+            if new[s] < 0 and t in want and t not in taken:
+                new[s] = t
+                taken.add(t)
+        free = [s for s in range(self.slots) if new[s] < 0]
+        need = sorted(want - taken)
+        if len(free) != len(need):
+            raise RuntimeError(f"A1_SWAP layer {li}: {len(free)} free slots for {len(need)} experts")
+        for s, p in zip(free, need):
+            new[s] = p
+        for s in range(self.slots):
+            if new[s] != tgt[s]:
+                tgt[s] = new[s]
+                if (li, s) not in self.queue:
+                    self.queue.append((li, s))
+
+    # ------------------------------------------------------------------ hook
+    def begin_hook(self, done=(), allow_unpublish: bool = True, now: float | None = None) -> HookPlan:
+        """Step boundary. ``done``: seqs of copy jobs the executor found complete and verified. ``now``: clock in
+        seconds for the minimum residency (required as soon as min_residency_s > 0). The table
+        transition (``transition``) is followed by the invariant check of every changed layer; a failed check
+        raises before the new tables are recorded, so the executor never applies them."""
+        plan = self.transition(done, allow_unpublish, now=now)
+        if plan.changed_layers:
+            self.check_layers(plan.changed_layers)
+        h = plan.hook
+        self._mask_hist[h] = self.phys2slot >= 0
+        for k in [k for k in self._mask_hist if k < h - self._history]:
+            del self._mask_hist[k]
+        return plan
+
+    def transition(self, done=(), allow_unpublish: bool = True, now: float | None = None) -> HookPlan:
+        """The state transition of one hook without the invariant check (``begin_hook`` adds it). Exposed so the
+        tests can observe the tables a transition produces even when the check would reject them."""
+        if self.policy.cfg.min_residency_s > 0.0 and (now is None or not math.isfinite(float(now))):
+            raise RuntimeError(
+                f"A1_SWAP: min_residency_s={self.policy.cfg.min_residency_s} needs a finite clock, got now={now!r}")
+        self.hook += 1
+        h = self.hook
+        plan = HookPlan(hook=h)
+        changed = set()
+        for seq in done:
+            job = self.inflight.pop(int(seq), None)
+            if job is None:
+                raise RuntimeError(f"A1_SWAP: unknown or repeated copy seq {seq}")
+            li, s = job.layer, job.slot
+            if self.slot_seq[li, s] != job.seq or self.slot_pub[li, s] != -1:
+                raise RuntimeError(f"A1_SWAP: copy {job} finished on a slot that is not waiting for it")
+            self.slot_seq[li, s] = 0
+            if self.slot_target[li, s] == job.phys:
+                self.slot_ready[li, s] = job.phys
+            else:
+                plan.dropped.append(job.seq)
+                self.stats["dropped"] += 1
+                if (li, s) not in self.queue:
+                    self.queue.append((li, s))
+        # publish every slot whose wanted expert has arrived
+        li_s = np.nonzero((self.slot_pub < 0) & (self.slot_ready >= 0))
+        for li, s in zip(*li_s):
+            li, s = int(li), int(s)
+            p = int(self.slot_ready[li, s])
+            self.slot_ready[li, s] = -1
+            if p != self.slot_target[li, s]:
+                if (li, s) not in self.queue:
+                    self.queue.append((li, s))
+                continue
+            if self.phys2slot[li, p] != -1:
+                raise RuntimeError(f"A1_SWAP layer {li}: expert {p} already published in slot {self.phys2slot[li, p]}")
+            self.phys2slot[li, p] = s
+            self.slot_pub[li, s] = p
+            plan.publish.append((li, p, s))
+            changed.add(li)
+            self.stats["published"] += 1
+            if now is not None:  # the protection of a slot starts when its bytes are published
+                # p is a PHYSICAL id (the slot tables work in that space); t_admit of the policy is indexed by
+                # LOGICAL expert, so the same conversion as in a1_exec._begin (p2l is static, never mutated).
+                self.policy.mark_resident(li, int(self.p2l[li, p]), now)
+        # start copies in decision order, unpublishing lazily
+        keep = deque()
+        while self.queue:
+            li, s = self.queue.popleft()
+            t = int(self.slot_target[li, s])
+            if self.slot_pub[li, s] == t:
+                continue  # cancelled: the wanted expert is still there
+            if self.slot_seq[li, s] != 0 or self.slot_ready[li, s] == t:
+                keep.append((li, s))  # a copy for this slot is still running / waiting to publish
+                continue
+            if len(self.inflight) >= self.max_inflight or (self.slot_pub[li, s] >= 0 and not allow_unpublish):
+                keep.append((li, s))
+                continue
+            if self.slot_pub[li, s] >= 0:
+                old = int(self.slot_pub[li, s])
+                self.phys2slot[li, old] = -1
+                self.slot_pub[li, s] = -1
+                self.slot_release[li, s] = h
+                plan.unpublish.append((li, old, s))
+                changed.add(li)
+                self.stats["unpublished"] += 1
+            self.seq += 1
+            job = CopyJob(self.seq, li, s, t, int(self.slot_release[li, s]))
+            self.inflight[job.seq] = job
+            self.slot_seq[li, s] = job.seq
+            plan.copies.append(job)
+            self.stats["copies"] += 1
+        self.queue = keep
+        self.stats["backlog_max"] = max(self.stats["backlog_max"], len(self.queue) + len(self.inflight))
+        plan.changed_layers = tuple(sorted(changed))
+        return plan
+
+    # ------------------------------------------------------------------ views
+    def transit(self) -> int:
+        """Slots without a published expert (their expert computes on the CPU meanwhile)."""
+        return int((self.slot_pub < 0).sum())
+
+    def pending(self) -> int:
+        return int((self.slot_pub != self.slot_target).sum())
+
+    def virt_row(self, li: int):
+        """Stream prefill under A1: (phys2virt, virt2phys) of a layer with no slot in transit. CPU experts get the
+        virtual ids slots..num_experts-1 in ascending physical order, GPU experts -1; at the start this is the
+        identity on slots..num_experts-1, i.e. today's groups."""
+        if (self.slot_pub[li] < 0).any():
+            raise RuntimeError(f"A1_VIRT_TRANSIT layer {li}: {int((self.slot_pub[li] < 0).sum())} slots in transit")
+        cpu = np.nonzero(self.phys2slot[li] < 0)[0]
+        if cpu.size != self.num_experts - self.slots:
+            raise RuntimeError(f"A1_VIRT_COUNT layer {li}: {cpu.size} CPU experts, expected {self.num_experts - self.slots}")
+        p2v = np.full(self.num_experts, -1, dtype=np.int64)
+        p2v[cpu] = np.arange(self.slots, self.num_experts)
+        return p2v, cpu.astype(np.int64)
+
+    def check_layers(self, layers) -> None:
+        """Mirror invariants: published ids unique per slot and consistent with phys2slot."""
+        for li in layers:
+            p2s = self.phys2slot[li]
+            on = np.nonzero(p2s >= 0)[0]
+            sl = p2s[on]
+            if sl.size and (sl.max() >= self.slots or np.unique(sl).size != sl.size):
+                raise RuntimeError(f"A1_INVARIANT layer {li}: slot ids {sl.tolist()[:8]}")
+            pub = self.slot_pub[li]
+            if not np.array_equal(np.sort(pub[pub >= 0]), np.sort(on)):
+                raise RuntimeError(f"A1_INVARIANT layer {li}: slot table and phys2slot disagree")
+            if not (self.phys2slot[li, pub[pub >= 0]] == np.nonzero(pub >= 0)[0]).all():
+                raise RuntimeError(f"A1_INVARIANT layer {li}: slot table points to other slots")
+            if ((pub >= 0) & (self.slot_seq[li] != 0)).any():
+                raise RuntimeError(f"A1_INVARIANT layer {li}: a published slot has a copy in flight")
+
+    def check_all(self) -> None:
+        self.check_layers(range(self.layers))
+        self.policy.check_invariants()
+
+    @property
+    def live_hit_rate(self) -> float:
+        if self.stats["live_sel"] <= 0:
+            raise ValueError("no decode selections observed")
+        return self.stats["live_hits"] / self.stats["live_sel"]
