diff -ruN a/python/sglang/srt/mem_cache/ds41_mu_hicache.py b/python/sglang/srt/mem_cache/ds41_mu_hicache.py
--- a/python/sglang/srt/mem_cache/ds41_mu_hicache.py	1970-01-01 01:00:00.000000000 +0100
+++ b/python/sglang/srt/mem_cache/ds41_mu_hicache.py	2026-10-03 13:33:28.851538994 +0200
@@ -0,0 +1,387 @@
+"""HiCache host-tier support (L2, RAM only) for DeepSeek-V4.1-Flash.
+
+All switches are off by default; they take effect only when HiCache is enabled (--enable-hierarchical-cache).
+- SGLANG_DS41_MU_HICACHE_ATOMIC=1: load_back evicts on the GPU only if enough memory will be freed afterward
+  (upstream #35129 cause 3: otherwise it evicts and then still aborts).
+- SGLANG_DS41_MU_HICACHE_MAX_GIB=<n>: fixed cap for all host pools combined, additionally limited by the
+  remaining headroom of the current cgroup (memory.max − (anon + shmem) − reserve SGLANG_DS41_MU_HICACHE_RESERVE_GIB, default 40).
+  0 = off (then only the upstream check psutil.available − 10 GiB applies; it does not know about MemoryMax).
+  Use anon + shmem instead of memory.current. memory.current includes the page cache
+  (weights, Engram files), which fills the cgroup up to memory.max after loading and can be reclaimed; with memory.current
+  the headroom when creating host pools would be ≈ 0 (page cache can consume most of memory.max)
+  and startup would abort with "Not enough host memory". anon + shmem is also the size used by the launcher's guard
+  (RESOURCE_STOP when anon_shmem > MemoryMax − 20 GiB). Reserve 40 = 20 margin to the guard + 20 growth after startup.
+- Counters (always when HiCache is enabled): failed saves (host full), rejected or ineffective load-backs;
+  log line "[ds41_mu-hicache] ..." at most every 30 s when values change, plus host use at startup.
+Reads only its own cgroup (memory.max, memory.stat), never /proc/<pid>/smaps* or numa_maps.
+"""
+from __future__ import annotations
+
+import logging
+import os
+import time
+
+_log = logging.getLogger(__name__)
+GIB = 1 << 30
+
+
+def _int(name: str, default: int) -> int:
+    v = os.environ.get(name, "")
+    if v == "":
+        return default
+    if not v.isdigit():
+        raise ValueError(f"{name} must be an integer >= 0, got {v!r}")
+    return int(v)
+
+
+def _bool(name: str) -> bool:
+    v = os.environ.get(name, "0")
+    if v not in ("0", "1"):
+        raise ValueError(f"{name} must be 0 or 1, got {v!r}")
+    return v == "1"
+
+
+DS41_MU_ATOMIC_ENABLED = _bool("SGLANG_DS41_MU_HICACHE_ATOMIC")
+MAX_GIB = _int("SGLANG_DS41_MU_HICACHE_MAX_GIB", 0)
+RESERVE_GIB = _int("SGLANG_DS41_MU_HICACHE_RESERVE_GIB", 40)
+_DS41_MU_CGROUP_ROOT = None  # For tests only: directory for a mock cgroup (memory.max, memory.stat)
+
+
+def ds41_mu_set_switches(**ds41_mu_settings) -> dict:
+    """For tests: override switches and return their previous values."""
+    g = globals(); ds41_mu_previous_value = {}
+    for k, v in ds41_mu_settings.items():
+        assert k in ("DS41_MU_ATOMIC_ENABLED", "MAX_GIB", "RESERVE_GIB", "_DS41_MU_CGROUP_ROOT"), k
+        ds41_mu_previous_value[k] = g[k]; g[k] = v
+    return ds41_mu_previous_value
+
+
+# ---- Counters ----
+DS41_MU_COUNTERS = {
+    "backup_failed": 0,        # Count of nodes whose write-through backup failed because host memory was unavailable.
+    "backup_failed_tokens": 0,
+    "restore_rejected": 0,            # ATOMIC: if not enough can be evicted, evict nothing and load nothing
+    "restore_without_progress": 0,          # evicted, but there is still not enough free space (upstream behavior)
+    "restore_without_progress_tokens": 0,
+}
+_ds41_mu_last_timestamp = {"t": 0.0, "ds41_mu_state": None}
+
+
+def ds41_mu_count_event(name: str, n: int = 1) -> None:
+    DS41_MU_COUNTERS[name] += n
+
+
+def ds41_mu_report(cache=None, ds41_mu_now: float | None = None) -> str | None:
+    """From check_hicache_events: at most one line every 30 s, only when values change."""
+    ds41_mu_now = time.monotonic() if ds41_mu_now is None else ds41_mu_now
+    ds41_mu_state = tuple(sorted(DS41_MU_COUNTERS.items()))
+    if ds41_mu_state == _ds41_mu_last_timestamp["ds41_mu_state"] or ds41_mu_now - _ds41_mu_last_timestamp["t"] < 30.0:
+        return None
+    _ds41_mu_last_timestamp.update(t=ds41_mu_now, ds41_mu_state=ds41_mu_state)
+    ds41_mu_parts = [f"{k}={v}" for k, v in ds41_mu_state]
+    if cache is not None and getattr(cache, "cache_controller", None) is not None:
+        try:
+            host = cache.cache_controller.mem_pool_host
+            ds41_mu_parts.append(f"host_free={host.available_size()} host_total={host.size}")
+        except Exception:  # noqa: BLE001 - logging only
+            pass
+    ds41_mu_log_line = "[ds41_mu-hicache] " + " ".join(ds41_mu_parts)
+    _log.info(ds41_mu_log_line)
+    return ds41_mu_log_line
+
+
+# ---- Host cap ----
+DS41_MU_HOST_USED_BYTES = {"bytes": 0, "pools": []}
+
+
+def _ds41_mu_cgroup_base() -> str:
+    if _DS41_MU_CGROUP_ROOT:
+        return _DS41_MU_CGROUP_ROOT
+    with open("/proc/self/cgroup") as f:
+        ds41_mu_path = next(l.split(":", 2)[2].strip() for l in f if l.startswith("0::"))
+    return "/sys/fs/cgroup" + ds41_mu_path
+
+
+def _ds41_mu_cgroup_memory_values() -> tuple[int, int] | None:
+    """Read memory.max and anon + shmem from the current cgroup (v2); return None when the limit is unlimited or unreadable."""
+    try:
+        ds41_mu_base = _ds41_mu_cgroup_base()
+        with open(ds41_mu_base + "/memory.max") as f:
+            mx = f.read().strip()
+        if mx == "max":
+            return None
+        stat = {}
+        with open(ds41_mu_base + "/memory.stat") as f:
+            for ds41_mu_log_line in f:
+                ds41_mu_parts = ds41_mu_log_line.split()
+                if len(ds41_mu_parts) == 2 and ds41_mu_parts[0] in ("anon", "shmem"):
+                    stat[ds41_mu_parts[0]] = int(ds41_mu_parts[1])
+        return int(mx), stat["anon"] + stat["shmem"]
+    except Exception:  # noqa: BLE001
+        return None
+
+
+def _ds41_mu_cgroup_headroom() -> int | None:
+    """memory.max − (anon + shmem) for this cgroup (v2), None if unlimited or unknown (page cache does not count)."""
+    w = _ds41_mu_cgroup_memory_values()
+    return None if w is None else w[0] - w[1]
+
+
+def ds41_mu_cap_budget(ds41_mu_free_capacity: int) -> int:
+    """From pool_host.base.host_memory_budget_bytes(): additionally cap the upstream budget (only when MAX_GIB > 0)."""
+    if MAX_GIB <= 0:
+        return ds41_mu_free_capacity
+    ds41_mu_remaining = MAX_GIB * GIB - DS41_MU_HOST_USED_BYTES["bytes"]
+    w = _ds41_mu_cgroup_memory_values()
+    if w is not None:
+        ds41_mu_remaining = min(ds41_mu_remaining, w[0] - w[1] - RESERVE_GIB * GIB)
+    budget = max(0, min(ds41_mu_free_capacity, ds41_mu_remaining))
+    _log.info(
+        "[ds41_mu-hicache] Budget %.2f GiB: upstream free %.2f, cap %d GiB (used %.2f), cgroup %s, reserve %d GiB",
+        budget / GIB, ds41_mu_free_capacity / GIB, MAX_GIB, DS41_MU_HOST_USED_BYTES["bytes"] / GIB,
+        "unbegrenzt/unlesbar" if w is None else f"max {w[0] / GIB:.1f} anon+shmem {w[1] / GIB:.1f}", RESERVE_GIB,
+    )
+    return budget
+
+
+def ds41_mu_record_allocation(n_bytes: int, name: str) -> None:
+    """After a host pool passes the budget check: record its usage (for the cap and startup log line)."""
+    DS41_MU_HOST_USED_BYTES["bytes"] += int(n_bytes)
+    DS41_MU_HOST_USED_BYTES["pools"].append((str(name), int(n_bytes)))
+    _log.info(
+        "[ds41_mu-hicache] Host pool %s %.2f GiB, total %.2f GiB (cap %s)",
+        name, n_bytes / GIB, DS41_MU_HOST_USED_BYTES["bytes"] / GIB, f"{MAX_GIB} GiB" if MAX_GIB > 0 else "disabled",
+    )
+
+
+# ---- Atomic load-back ----
+def ds41_mu_enough_evictable_capacity(cache, needed: int) -> bool:
+    """Can evict_for_alloc free at least `needed` full tokens from the GPU?"""
+    from sglang.srt.mem_cache.unified_cache.components.tree_component import ComponentType
+
+    return cache.tree_core.component_evictable_size(ComponentType.FULL) >= needed
+
+
+# ---- Host protection classes ----
+# SGLANG_DS41_MU_HICACHE_CLASSES=1 (off by default; useful only with HiCache and class-aware SWA handling): the device protection class of an SWA node
+# A node class (0 checkpoint, 1 normal, 2 disposable) persists through the device tombstone in ds41_mu_host_class_lru; the SWA host LRU orders nodes by
+# this class (disposable first, checkpoint last) and restores it before insert_mru on load-back.
+# Host checkpoints are capped: SGLANG_DS41_MU_HICACHE_CLASS_MAX (0 = default: host SWA pool/4/256, as with the device cap);
+# Demote the oldest checkpoint as in ds41_mu_mark_checkpoint.
+DS41_MU_CLASSES_ENABLED = _bool("SGLANG_DS41_MU_HICACHE_CLASSES")
+DS41_MU_HOST_CLASS_MAX = _int("SGLANG_DS41_MU_HICACHE_CLASS_MAX", 0)
+
+
+def ds41_mu_host_cap(comp) -> int:
+    if DS41_MU_HOST_CLASS_MAX > 0:
+        return DS41_MU_HOST_CLASS_MAX
+    pool = getattr(comp, "_swa_kv_pool_host", None)
+    n = getattr(pool, "size", None) if pool is not None else None
+    if not n:
+        return 64
+    return max(1, int(n) // 4 // comp.tree_core.page_size)
+DS41_MU_HOST_CLASS_KEY = "ds41_mu_host_class_lru"
+
+
+def _ds41_mu_host_lru_class():
+    from sglang.srt.mem_cache.ds41_mu_radix_lru import (
+        DS41_MU_CLASS_DISPOSABLE,
+        DS41_MU_CLASS_CHECKPOINT,
+        DS41_MU_CLASS_NORMAL,
+        DS41MUClassLRU,
+    )
+    from sglang.srt.mem_cache.unified_cache.unified_tree_core import (
+        UnifiedLRUList,
+        UnifiedTreeNode,
+    )
+
+    class DS41MUHostClassLRU(DS41MUClassLRU):
+        """Class LRU for the SWA host list: like DS41MUClassLRU, but with use_host_ptr=True and key ds41_mu_host_class_lru.
+        The checkpoint registry contains exactly the class-0 nodes in the list (maintained in _add_node/_remove_node)."""
+
+        def __init__(self, component_type, tree_components):  # pylint: disable=super-init-not-called
+            UnifiedLRUList.__init__(self, component_type, tree_components, use_host_ptr=True)
+            assert self.mid is None, "Host class LRU only without session partition"
+            self.w01 = UnifiedTreeNode(tree_components)
+            self.w12 = UnifiedTreeNode(tree_components)
+            for ct in tree_components:
+                for w in (self.w01, self.w12):
+                    w.component_data[ct].lock_ref = 1
+                    w.component_data[ct].host_lock_ref = 1
+            self._add_node_after(self.head, self.w01)
+            self._add_node_after(self.w01, self.w12)
+            self._ds41_mu_guard = (self.w01, self.w12)
+            self.ds41_mu_checkpoint_registry: dict = {}
+
+        def ds41_mu_node_class(self, node) -> int:
+            return node.component_data[self.component_type].metadata.get(DS41_MU_HOST_CLASS_KEY, DS41_MU_CLASS_NORMAL)
+
+        def _add_node(self, node):
+            super()._add_node(node)
+            if self.ds41_mu_node_class(node) == DS41_MU_CLASS_CHECKPOINT:
+                self.ds41_mu_checkpoint_registry[node.id] = node
+
+        def _remove_node(self, node):
+            super()._remove_node(node)
+            self.ds41_mu_checkpoint_registry.pop(node.id, None)
+
+        def _ds41_mu_reset_sentinels(self, node, root_node, should_include, ds41_mu_window):
+            # DS41MUClassLRU reorders via _add_node_after (without _add_node): update the registry afterward.
+            super()._ds41_mu_reset_sentinels(node, root_node, should_include, ds41_mu_window)
+            x, acc = node, 0
+            while x != root_node and (ds41_mu_window is None or acc < ds41_mu_window):
+                if x.id in self.cache and self.ds41_mu_node_class(x) == DS41_MU_CLASS_CHECKPOINT:
+                    self.ds41_mu_checkpoint_registry[x.id] = x
+                acc += len(x.key)
+                x = x.parent
+
+        def ds41_mu_set_class(self, node, ds41_mu_class_id: int) -> bool:
+            md = node.component_data[self.component_type].metadata
+            if md.get(DS41_MU_HOST_CLASS_KEY, DS41_MU_CLASS_NORMAL) == ds41_mu_class_id:
+                return False
+            if ds41_mu_class_id == DS41_MU_CLASS_NORMAL:
+                md.pop(DS41_MU_HOST_CLASS_KEY, None)
+            else:
+                md[DS41_MU_HOST_CLASS_KEY] = ds41_mu_class_id
+            if node.id in self.cache:
+                self._remove_node(node)
+                self._add_node(node)
+            return True
+
+    return DS41MUHostClassLRU, DS41_MU_CLASS_CHECKPOINT, DS41_MU_CLASS_NORMAL, DS41_MU_CLASS_DISPOSABLE
+
+
+def ds41_mu_install_host_classes(tree_core) -> None:
+    """Called from UnifiedTreeCore.reset() after host_lru_lists are created: replace the SWA host list when class tracking is enabled."""
+    if not DS41_MU_CLASSES_ENABLED:
+        return
+    from sglang.srt.mem_cache import ds41_mu_radix as _pr
+    from sglang.srt.mem_cache.unified_cache.components.tree_component import ComponentType
+
+    if not _pr.ds41_mu_needs_class_lru() or ComponentType.SWA not in tree_core.component_types:
+        return
+    if tree_core.enable_session_radix_cache:
+        _log.warning("[ds41_mu-hicache] Session radix cache enabled: host classes disabled")
+        return
+    DS41MUDeviceClassLRU, *_ = _ds41_mu_host_lru_class()
+    ds41_mu_previous_value = tree_core.host_lru_lists[ComponentType.SWA]
+    assert not ds41_mu_previous_value.cache, "Install host class LRU only on an empty list"
+    tree_core.host_lru_lists[ComponentType.SWA] = DS41MUDeviceClassLRU(ComponentType.SWA, tree_core.component_types)
+
+
+def _ds41_mu_get_host_class_lru(tree_core):
+    from sglang.srt.mem_cache.unified_cache.components.tree_component import ComponentType
+
+    lru = tree_core.host_lru_lists.get(ComponentType.SWA)
+    return lru if getattr(lru, "_ds41_mu_guard", None) else None
+
+
+def ds41_mu_on_device_tombstone(comp, node, ds41_mu_class_id) -> None:
+    """Called by ds41_mu_radix.ds41_mu_on_device_tombstone after the device value
+    is already None and class `ds41_mu_class_id` has been removed. Preserve the class for the host
+    while a SWA host_value remains. This runs before evict_component calls
+    host_lru.insert_mru, so the class takes effect immediately."""
+    if not DS41_MU_CLASSES_ENABLED:
+        return
+    cd = node.component_data[comp.component_type]
+    if cd.host_value is None or ds41_mu_class_id in (None, 1):
+        cd.metadata.pop(DS41_MU_HOST_CLASS_KEY, None)
+        return
+    if ds41_mu_class_id == 0:
+        lru = _ds41_mu_get_host_class_lru(comp.tree_core)
+        if lru is not None:
+            d = ds41_mu_host_cap(comp)
+            while lru.ds41_mu_checkpoint_registry and len(lru.ds41_mu_checkpoint_registry) >= d:
+                ds41_mu_previous_value = lru.ds41_mu_class_lru_end(0)
+                if ds41_mu_previous_value is None:
+                    break
+                lru.ds41_mu_set_class(ds41_mu_previous_value, 1)
+                _log.info("[ds41_mu-hicache] Host checkpoint demoted node %s (cap %d)", ds41_mu_previous_value.id, d)
+    cd.metadata[DS41_MU_HOST_CLASS_KEY] = ds41_mu_class_id
+
+
+def ds41_mu_before_device_insertion(tree_core, node, component_type) -> None:
+    """Called by UnifiedTreeCore.set_component_device_value before
+    host_lru.remove_node/insert_mru when a node returns from the host.
+    Restore the class from ds41_mu_host_class_lru to ds41_mu_class_lru
+    and register the checkpoint under the device cap, demoting as in
+    ds41_mu_mark_checkpoint."""
+    from sglang.srt.mem_cache import ds41_mu_radix as _pr
+    from sglang.srt.mem_cache.unified_cache.components.tree_component import ComponentType
+
+    if component_type != ComponentType.SWA:
+        return
+    if not tree_core.host_lru_lists[component_type].in_list(node):
+        return
+    md = node.component_data[component_type].metadata
+    ds41_mu_class_id = md.pop(DS41_MU_HOST_CLASS_KEY, None)
+    if ds41_mu_class_id is None or ds41_mu_class_id == 1:
+        return
+    comp = tree_core.components_by_type.get(ComponentType.SWA)
+    dev = _pr._ds41_mu_get_class_lru(comp) if comp is not None else None
+    if dev is None:
+        return
+    if ds41_mu_class_id == 2:
+        md["ds41_mu_class_lru"] = 2
+        return
+    reg = dev.ds41_mu_checkpoint_registry
+    d = _pr.ds41_mu_cap(comp)
+    while reg and len(reg) >= d:
+        ds41_mu_previous_value = dev.ds41_mu_class_lru_end(0)
+        if ds41_mu_previous_value is None:
+            break
+        dev.ds41_mu_set_class(ds41_mu_previous_value, 1)
+        reg.pop(ds41_mu_previous_value.id, None)
+        _log.info("[ds41_mu-hicache] Checkpoint demoted node %s on load-back (cap %d)", ds41_mu_previous_value.id, d)
+    md["ds41_mu_class_lru"] = 0
+    reg[node.id] = node
+    _log.info("[ds41_mu-hicache] Checkpoint restored from host, node %s (%d/%d)", node.id, len(reg), d)
+
+
+def ds41_mu_on_node_split(comp, new_parent, child) -> None:
+    """Called by ds41_mu_radix.ds41_mu_on_node_split after the upstream
+    host_lru.insert_mru(new_parent): inherit the host class from the device
+    class. The child keeps its class; the parent becomes disposable if the
+    child is disposable, otherwise normal; reorder the host list."""
+    if not DS41_MU_CLASSES_ENABLED:
+        return
+    ct = comp.component_type
+    ds41_mu_class_id = child.component_data[ct].metadata.get(DS41_MU_HOST_CLASS_KEY)
+    lru = _ds41_mu_get_host_class_lru(comp.tree_core)
+    ds41_mu_target = 2 if ds41_mu_class_id == 2 else 1
+    if lru is not None:
+        lru.ds41_mu_set_class(new_parent, ds41_mu_target)
+    elif ds41_mu_target == 2:
+        new_parent.component_data[ct].metadata[DS41_MU_HOST_CLASS_KEY] = 2
+    else:
+        new_parent.component_data[ct].metadata.pop(DS41_MU_HOST_CLASS_KEY, None)
+
+
+def ds41_mu_check_host_classes(tree_core, ds41_mu_error) -> None:
+    """Invariants (tests/simulation): host registry == class-0 nodes in the list; every list node is host-only with host_value;
+    classes are nondecreasing in list order (MRU->LRU: 0, 1, 2)."""
+    lru = _ds41_mu_get_host_class_lru(tree_core)
+    if lru is None:
+        return
+    pt = lru._pt; ct = lru.component_type
+    x = lru.head.lru_next[pt]; ds41_mu_class_entries = []; null = set()
+    while x is not lru.tail:
+        if x in lru._ds41_mu_guard:
+            x = x.lru_next[pt]; continue
+        cd = x.component_data[ct]
+        if cd.host_value is None or cd.value is not None:
+            ds41_mu_error(f"Host class LRU: node {x.id} is not host-only")
+        k = lru.ds41_mu_node_class(x); ds41_mu_class_entries.append(k)
+        if k == 0:
+            null.add(x.id)
+        x = x.lru_next[pt]
+    if ds41_mu_class_entries != sorted(ds41_mu_class_entries):
+        ds41_mu_error(f"Host class LRU: invalid order {ds41_mu_class_entries[:20]}")
+    if null != set(lru.ds41_mu_checkpoint_registry):
+        ds41_mu_error(f"Host registry {sorted(lru.ds41_mu_checkpoint_registry)} != class-0 nodes {sorted(null)}")
+    from sglang.srt.mem_cache.unified_cache.components.tree_component import ComponentType
+
+    comp = getattr(tree_core, "components_by_type", {}).get(ComponentType.SWA)
+    d = ds41_mu_host_cap(comp) if comp is not None else DS41_MU_HOST_CLASS_MAX
+    if d and len(null) > d:
+        ds41_mu_error(f"Host checkpoints {len(null)} > cap {d}")
diff -ruN a/python/sglang/srt/mem_cache/ds41_mu_radix.py b/python/sglang/srt/mem_cache/ds41_mu_radix.py
--- a/python/sglang/srt/mem_cache/ds41_mu_radix.py	1970-01-01 01:00:00.000000000 +0100
+++ b/python/sglang/srt/mem_cache/ds41_mu_radix.py	2026-10-03 13:31:08.232305834 +0200
@@ -0,0 +1,677 @@
+"""DS41MU switches for the SWA radix cache.
+
+F1  (SGLANG_DS41_MU_RADIX_F1):   disposable-node cleanup at chunk boundaries (remainder 256, disposable class).
+F1C (SGLANG_DS41_MU_RADIX_F1C):  trim completed requests to 256 before insertion.
+F2  (SGLANG_DS41_MU_RADIX_F2):   checkpoints; port of SGLang #34565 (merge 3a770da7)
+                              plus message boundary, protection class, second step, refresh.
+F2_MAX (SGLANG_DS41_MU_RADIX_F2_MAX, Default 16): cap for protection-class checkpoints.
+DS41_MU_CHECKPOINT_SOURCE (SGLANG_DS41_MU_RADIX_F2_SOURCE, Default "msg,full"): checkpoint sources.
+DS41_MU_CHECKPOINT_LINES (SGLANG_DS41_MU_RADIX_F2_LINES, Default off): fair cap per
+             prefix line, with preference for the shallowest checkpoint as anchor.
+
+All switches are off by default; without a switch, every path remains unchanged.
+Values are module attributes and are read at runtime (tests can
+change them with ds41_mu_set_switches()).
+"""
+
+from __future__ import annotations
+
+import os
+from sglang.srt.mem_cache import ds41_mu_hicache as _ds41_mu_hc  # DS41MU
+
+
+def _bool(name: str) -> bool:
+    return os.environ.get(name, "0").strip().lower() in ("1", "true", "yes", "on")
+
+
+def _ds41_mu_sources(name: str) -> frozenset[str]:
+    ds41_mu_raw_value = os.environ.get(name, "msg,full")
+    return frozenset(q.strip() for q in ds41_mu_raw_value.split(",") if q.strip())
+
+
+def _f2_min() -> int:
+    """Use the same syntax as the launcher; report invalid configuration at startup."""
+    raw = os.environ.get("SGLANG_DS41_MU_RADIX_F2_MIN")
+    if raw is None:
+        return 0
+    if not (1 <= len(raw) <= 6 and raw.isascii() and raw.isdecimal()):
+        raise ValueError("SGLANG_DS41_MU_RADIX_F2_MIN must be 0..999999 (1..6 ASCII digits)")
+    return int(raw, 10)
+
+
+F1: bool = _bool("SGLANG_DS41_MU_RADIX_F1")
+F1C: bool = _bool("SGLANG_DS41_MU_RADIX_F1C")
+F2: bool = _bool("SGLANG_DS41_MU_RADIX_F2")
+F2_MAX: int = int(os.environ.get("SGLANG_DS41_MU_RADIX_F2_MAX", "16"))
+DS41_MU_CHECKPOINT_SOURCE: frozenset[str] = _ds41_mu_sources("SGLANG_DS41_MU_RADIX_F2_SOURCE")
+# Protect checkpoints against fill traffic; disabled by default.
+# F2_MIN: create a msg checkpoint only when c >= F2_MIN tokens (shorter prefixes remain class 1).
+# DS41_MU_CHECKPOINT_VALUE_POLICY: at the cap, demote the checkpoint with the lowest value (length x LRU rank) instead of the oldest.
+F2_MIN: int = _f2_min()
+DS41_MU_CHECKPOINT_VALUE_POLICY: bool = _bool("SGLANG_DS41_MU_RADIX_F2_VALUE")
+DS41_MU_CHECKPOINT_LINES: bool = _bool("SGLANG_DS41_MU_RADIX_F2_LINES")
+
+
+def f2_full() -> bool:
+    """Port of #34565: use the branch point from the full-KV hit."""
+    return F2 and "full" in DS41_MU_CHECKPOINT_SOURCE
+
+
+def f2_msg() -> bool:
+    """Addition Z2: checkpoint at the message boundary."""
+    return F2 and "msg" in DS41_MU_CHECKPOINT_SOURCE
+
+
+def ds41_mu_set_switches(**ds41_mu_settings) -> dict:
+    """Override switches for tests; return their previous values."""
+    ds41_mu_previous_value = {}
+    g = globals()
+    for k, v in ds41_mu_settings.items():
+        if k not in ("F1", "F1C", "F2", "F2_MAX", "DS41_MU_CHECKPOINT_SOURCE", "F2_MIN", "DS41_MU_CHECKPOINT_VALUE_POLICY", "DS41_MU_CHECKPOINT_LINES"):
+            raise KeyError(k)
+        ds41_mu_previous_value[k] = g[k]
+        g[k] = frozenset(v) if k == "DS41_MU_CHECKPOINT_SOURCE" else v
+    return ds41_mu_previous_value
+
+
+def ds41_mu_description() -> str:
+    ds41_mu_base = (
+        f"F1={int(F1)} F1C={int(F1C)} F2={int(F2)} F2_MAX={F2_MAX} "
+        f"DS41_MU_CHECKPOINT_SOURCE={','.join(sorted(DS41_MU_CHECKPOINT_SOURCE))}"
+    )
+    return ds41_mu_base + " DS41_MU_CHECKPOINT_LINES=1" if DS41_MU_CHECKPOINT_LINES else ds41_mu_base
+
+
+# ---------------------------------------------------------------------------
+# Class LRU (F1b disposable nodes, F2 checkpoints). Implemented in ds41_mu_radix_lru.py,
+# only the entry points go here, so changes to existing files stay small
+# everything is imported only when the switch is enabled
+# ---------------------------------------------------------------------------
+
+
+def ds41_mu_needs_class_lru() -> bool:
+    return F1 or F2
+
+
+def ds41_mu_install_class_lru(tree_core) -> None:
+    """From UnifiedTreeCore.reset(): replace the SWA device list with the class LRU."""
+    if not ds41_mu_needs_class_lru():
+        return
+    from sglang.srt.mem_cache.unified_cache.components.tree_component import (
+        ComponentType,
+    )
+
+    if ComponentType.SWA not in tree_core.component_types:
+        return
+    if tree_core.enable_session_radix_cache:
+        import logging
+
+        logging.getLogger(__name__).warning(
+            "[ds41_mu-radix] session radix cache enabled: class LRU (F1b/F2) disabled"
+        )
+        return
+    from sglang.srt.mem_cache.ds41_mu_radix_lru import DS41MUClassLRU
+
+    ds41_mu_previous_value = tree_core.lru_lists[ComponentType.SWA]
+    assert not ds41_mu_previous_value.cache, "Install class LRU only on an empty list"
+    tree_core.lru_lists[ComponentType.SWA] = DS41MUClassLRU(
+        ComponentType.SWA, tree_core.component_types
+    )
+
+
+def _ds41_mu_get_class_lru(comp):
+    lru = comp.tree_core.lru_lists[comp.component_type]
+    return lru if getattr(lru, "_ds41_mu_guard", None) else None
+
+
+def ds41_mu_on_device_tombstone(comp, node) -> None:
+    """From SWAComponent.evict_component after cd.value = None: remove the class."""
+    md = node.component_data[comp.component_type].metadata
+    ds41_mu_class_id = md.pop("ds41_mu_class_lru", None)
+    if ds41_mu_class_id == 0:
+        _ds41_mu_remove_checkpoint(comp, node)
+    if _ds41_mu_hc.DS41_MU_CLASSES_ENABLED:  # Remember the class for the host
+        _ds41_mu_hc.ds41_mu_on_device_tombstone(comp, node, ds41_mu_class_id)
+
+
+def ds41_mu_on_node_split(comp, new_parent, child) -> None:
+    """From redistribute_on_node_split: the child keeps its end and class;
+    the older parent becomes disposable if the child is disposable, otherwise normal.
+    When page >= W, a checkpoint window always fits entirely inside the child."""
+    ct = comp.component_type
+    ds41_mu_class_id = child.component_data[ct].metadata.get("ds41_mu_class_lru")
+    if ds41_mu_class_id == 2:
+        new_parent.component_data[ct].metadata["ds41_mu_class_lru"] = 2
+    else:
+        new_parent.component_data[ct].metadata.pop("ds41_mu_class_lru", None)
+    if _ds41_mu_hc.DS41_MU_CLASSES_ENABLED:  # DS41MU C3: Inherit the host class
+        _ds41_mu_hc.ds41_mu_on_node_split(comp, new_parent, child)
+
+
+def ds41_mu_on_match_end(comp, node, root_node) -> None:
+    """From refresh_lru(MATCH_END) before refreshing the window (F1b): disposable nodes in the
+    window before the match end were useful after all and become class 1 again."""
+    if not F1:
+        return
+    lru = _ds41_mu_get_class_lru(comp)
+    if lru is None:
+        return
+    ct = comp.component_type
+    ds41_mu_window = comp.sliding_window_size + comp.tree_core.page_size
+    acc = 0
+    x = node
+    while x is not root_node and acc < ds41_mu_window:
+        if x.component_data[ct].metadata.get("ds41_mu_class_lru") == 2:
+            lru.ds41_mu_set_class(x, 1)
+        acc += len(x.key)
+        x = x.parent
+
+
+def ds41_mu_after_insertion(comp, req, insert_params, insert_result, is_finished) -> None:
+    """From SWAComponent.cleanup_after_caching_req (F1b): the remainder at the previous
+    chunk boundary for this request is now an interior node and becomes disposable
+    (class 2, evicted first). The remainder at the prompt end (chunked=False) and
+    remainders from completed requests remain class 1."""
+    if not F1:
+        return
+    lru = _ds41_mu_get_class_lru(comp)
+    if lru is None:
+        return
+    tc = comp.tree_core
+    ct = comp.component_type
+    ds41_mu_previous_settings = getattr(req, "_ds41_mu_tail_end", None)
+    ds41_mu_end_node = req.kv.cache_protected_len
+    if (
+        ds41_mu_previous_settings is not None
+        and not is_finished
+        and insert_result is not None
+        and req.last_node is not None
+        and ds41_mu_previous_settings < ds41_mu_end_node
+    ):
+        x = tc.node_by_id(req.last_node) if not hasattr(req.last_node, "key") else req.last_node
+        pos = ds41_mu_end_node
+        root = tc.root_node
+        while x is not root and pos > ds41_mu_previous_settings:
+            pos -= len(x.key)
+            x = x.parent
+        if pos == ds41_mu_previous_settings and x is not root:
+            ds41_mu_marked = 0
+            ds41_mu_boundary = 2 * tc.page_size
+            while x is not root and ds41_mu_marked < ds41_mu_boundary:
+                cd = x.component_data[ct]
+                if cd.value is None or cd.lock_ref > 0:
+                    break
+                if cd.metadata.get("ds41_mu_class_lru") == 0:
+                    break
+                lru.ds41_mu_set_class(x, 2)
+                ds41_mu_marked += len(x.key)
+                x = x.parent
+    if insert_result is not None and getattr(insert_result, "swa_branch_inserted", False):
+        # A checkpoint-capped insertion does not represent a chunk remainder;
+        # set the chunk-boundary remainder during the subsequent insertion step.
+        req._ds41_mu_tail_end = None
+    elif is_finished:
+        req._ds41_mu_tail_end = None
+    elif insert_params is not None and insert_params.chunked:
+        req._ds41_mu_tail_end = ds41_mu_end_node
+    else:
+        req._ds41_mu_tail_end = None
+
+
+def ds41_mu_check_invariants(cache) -> None:
+    """For simulation and tests: I5 (class LRU)."""
+    from sglang.srt.mem_cache.unified_cache.components.tree_component import (
+        ComponentType,
+    )
+
+    lru = cache.tree_core.lru_lists.get(ComponentType.SWA)
+    if lru is None or not getattr(lru, "_ds41_mu_guard", None):
+        return
+    ds41_mu_error: list[str] = []
+    lru.ds41_mu_check(ds41_mu_error.append)
+    ds41_mu_check_checkpoints(cache, ds41_mu_error.append)
+    if ds41_mu_error:
+        raise AssertionError("; ".join(ds41_mu_error[:5]))
+
+
+# ---------------------------------------------------------------------------
+# F2 additions Z1 (second step), Z3 (protection class + cap), Z4 (refresh)
+# and the scheduler side of Z2 (open checkpoints from req.ds41_mu_ckpt_offset).
+# Port #34565 provides the single cap point req.swa_branching_seqlen;
+# collect its open checkpoints here in ascending order.
+# ---------------------------------------------------------------------------
+
+import logging as _logging
+
+_log = _logging.getLogger("sglang.ds41_mu_radix")
+
+# Debug logging: only log lines "[ds41_mu-radix-dbg]" in silent checkpoint outputs;
+# no behavior change. Data boundary: lengths only,
+# Offsets, counters, flags, node IDs and rid; never token IDs or text.
+# off by default; enable with SGLANG_DS41_MU_RADIX_DBG=1 for diagnostic runs only.
+DBG: bool = os.environ.get("SGLANG_DS41_MU_RADIX_DBG", "0") != "0"
+
+
+def _dbg(fmt: str, *args) -> None:
+    if not DBG:
+        return
+    try:
+        _log.info("[ds41_mu-radix-dbg] " + fmt, *args)
+    except Exception:  # noqa: BLE001  (Logging must never put the request at risk)
+        pass
+
+
+def _rid(req) -> str:
+    return str(getattr(req, "rid", "?"))
+
+
+def _floor(x: int, p: int) -> int:
+    return x // p * p
+
+
+def ds41_mu_after_match(req, page_size: int) -> None:
+    """From Req.init_next_round_input and match_prefix_for_req after adopting the port field:
+    collect open checkpoints in ascending order and set the first as
+    swa_branching_seqlen. Sources: "full" (port, already in the field) and
+    "msg" (the floored message boundary)."""
+    if not F2:
+        return
+    h = len(req.prefix_indices) if req.prefix_indices is not None else 0
+    ds41_mu_upper_limit = _floor(len(req.origin_input_ids), page_size)
+    ds41_mu_candidate: dict[int, str] = {}
+    if f2_full() and req.swa_branching_seqlen is not None:
+        ds41_mu_candidate[req.swa_branching_seqlen] = "full"
+    off = getattr(req, "ds41_mu_ckpt_offset", None)
+    if f2_msg() and off:
+        ds41_mu_candidate[_floor(int(off), page_size)] = "msg"  # msg takes precedence when c is equal
+    ds41_mu_open_checkpoint = sorted((c, q) for c, q in ds41_mu_candidate.items() if h < c <= ds41_mu_upper_limit and c > 0)
+    req._ds41_mu_mem_peak_pending = ds41_mu_open_checkpoint
+    req.swa_branching_seqlen = ds41_mu_open_checkpoint[0][0] if ds41_mu_open_checkpoint else None
+    if DBG:
+        # only when a request changes (ds41_mu_after_match runs in each planning round)
+        sig = (h, ds41_mu_upper_limit, off, tuple(sorted(ds41_mu_candidate.items())), tuple(ds41_mu_open_checkpoint))
+        if getattr(req, "_ds41_mu_debug_name", None) != sig:
+            req._ds41_mu_debug_name = sig
+            _dbg(
+                "after_match rid=%s h=%d len=%d upper_bound=%d off=%s candidates=%s open=%s",
+                _rid(req), h, len(req.origin_input_ids), ds41_mu_upper_limit, off,
+                sorted(ds41_mu_candidate.items()), ds41_mu_open_checkpoint,
+            )
+
+
+def _swa_comp(cache):
+    from sglang.srt.mem_cache.unified_cache.components.tree_component import (
+        ComponentType,
+    )
+
+    return cache.components.get(ComponentType.SWA)
+
+
+def _node(tc, handle):
+    return handle if hasattr(handle, "key") else tc.node_by_id(handle)
+
+
+def ds41_mu_cap(comp) -> int:
+    alloc = comp.cache.token_to_kv_pool_allocator
+    pool = getattr(alloc, "_size_swa", None)
+    page = comp.tree_core.page_size
+    if not pool:
+        return F2_MAX
+    return max(1, min(F2_MAX, pool // 4 // page))
+
+
+def _ds41_mu_depth(tc, node) -> int:
+    n = 0
+    x = node
+    while x is not tc.root_node and x is not None:
+        n += len(x.key)
+        x = x.parent
+    return n
+
+
+def _ds41_mu_select_lowest_value_victim(lru, tc, ds41_mu_new_value, ds41_mu_new_checkpoint_end: int):
+    """DS41_MU_CHECKPOINT_VALUE_POLICY: value = end position (token) x LRU rank in class 0 (1 = least recently used,
+    the new checkpoint gets rank n+1). Returns the node with the lowest value,
+    with the older node winning ties; it can be the new node itself."""
+    pt = lru._pt
+    x = lru.w01.lru_prev[pt]
+    ds41_mu_rank = 1
+    best, ds41_mu_best_value = None, None
+    while x is not lru.head:
+        w = _ds41_mu_depth(tc, x) * ds41_mu_rank
+        if ds41_mu_best_value is None or w < ds41_mu_best_value:
+            best, ds41_mu_best_value = x, w
+        ds41_mu_rank += 1
+        x = x.lru_prev[pt]
+    if best is not None and ds41_mu_new_checkpoint_end * ds41_mu_rank < ds41_mu_best_value:
+        return ds41_mu_new_value
+    return best
+
+
+def _ds41_mu_select_checkpoint_line(lru, tc, ds41_mu_new_value, maximum: int):
+    """Select protection points without an agent ID, using only tree ancestry.
+
+    The shallowest registered ancestor is the line anchor. All points below it
+    belong to the same line. If prefixes are nested, they are
+    deliberately counted as *one* line; without a stable agent ID, a
+    different assignment cannot be proven from the tree. If an agent branches before the
+    first checkpoint, multiple lines are created.
+
+    Each line gets an equal share of floor(maximum/line_count), with a minimum of one. If there are more
+    lines than slots, the longest anchors win (the youngest wins ties). Remaining pool slots
+    stay free rather than allowing a line to exceed its share.
+    Within a line, the anchor always stays ahead of later checkpoints.
+    Return: (newly_allowed, old_points_to_demote).
+    """
+    ds41_mu_previous_value = list(lru.ds41_mu_checkpoint_registry.values())
+    ds41_mu_checkpoint_points = ds41_mu_previous_value + [ds41_mu_new_value]
+    # Class 0 is reserved for registered checkpoints. Ordered from oldest to newest.
+    ds41_mu_rank = {}
+    pt = lru._pt
+    x = lru.w01.lru_prev[pt]
+    while x is not lru.head:
+        ds41_mu_rank[x.id] = len(ds41_mu_rank)
+        x = x.lru_prev[pt]
+    ds41_mu_rank[ds41_mu_new_value.id] = len(ds41_mu_rank)
+
+    ids = {n.id for n in ds41_mu_checkpoint_points}
+    ds41_mu_groups = {}
+    for n in ds41_mu_checkpoint_points:
+        ds41_mu_anchor = n
+        x = n.parent
+        while x is not None and x is not tc.root_node:
+            if x.id in ids:
+                ds41_mu_anchor = x
+            x = x.parent
+        ds41_mu_groups.setdefault(ds41_mu_anchor.id, []).append(n)
+
+    ds41_mu_anchor = {n.id: n for n in ds41_mu_checkpoint_points if n.id in ds41_mu_groups}
+    if len(ds41_mu_groups) > maximum:
+        ds41_mu_retained = {n.id for n in sorted(ds41_mu_anchor.values(), key=lambda n: (_ds41_mu_depth(tc, n), ds41_mu_rank[n.id]), reverse=True)[:maximum]}
+    else:
+        ds41_mu_share = max(1, maximum // len(ds41_mu_groups))
+        ds41_mu_retained = set()
+        for aid, ds41_mu_group in ds41_mu_groups.items():
+            ds41_mu_retained.add(aid)
+            ds41_mu_sequence = (n for n in ds41_mu_group if n.id != aid)
+            ds41_mu_retained.update(n.id for n in sorted(ds41_mu_sequence, key=lambda n: ds41_mu_rank[n.id], reverse=True)[:ds41_mu_share - 1])
+    return ds41_mu_new_value.id in ds41_mu_retained, [n for n in ds41_mu_previous_value if n.id not in ds41_mu_retained]
+
+
+def ds41_mu_mark_checkpoint(cache, req) -> None:
+    """Z3: put the node that ends at c = cache_protected_len after capped insertion
+    in protection class 0; enforce the cap by demoting the least recently used
+    checkpoint (to class 1, MRU)."""
+    comp = _swa_comp(cache)
+    lru = _ds41_mu_get_class_lru(comp) if comp is not None else None
+    if lru is None or req.last_node is None:
+        _dbg(
+            "checkpoint skipped rid=%s reason=%s c=%s",
+            _rid(req), "lru_missing" if lru is None else "last_node_none",
+            getattr(getattr(req, "kv", None), "cache_protected_len", None),
+        )
+        return
+    tc = comp.tree_core
+    node = _node(tc, req.last_node)
+    ct = comp.component_type
+    cd = node.component_data[ct]
+    if node is tc.root_node or cd.value is None or len(node.key) < comp.sliding_window_size:
+        _dbg(
+            "checkpoint skipped rid=%s reason=%s c=%d node=%s len_key=%d W=%d",
+            _rid(req),
+            "root" if node is tc.root_node else ("swa_tombstone" if cd.value is None else "key_shorter_than_W"),
+            req.kv.cache_protected_len, getattr(node, "id", "?"), len(node.key),
+            comp.sliding_window_size,
+        )
+        return
+    reg = lru.ds41_mu_checkpoint_registry
+    if node.id in reg:
+        _dbg(
+            "mark_checkpoint already_checkpoint rid=%s c=%d node=%s (MRU only)",
+            _rid(req), req.kv.cache_protected_len, node.id,
+        )
+        lru.reset_node_mru(node)
+        return
+    ds41_mu_new_checkpoint_end = req.kv.cache_protected_len
+    if F2_MIN and ds41_mu_new_checkpoint_end < F2_MIN:
+        _log.info("[ds41_mu-radix] Checkpoint too short c=%d (F2_MIN %d) rid=%s", ds41_mu_new_checkpoint_end, F2_MIN, _rid(req))
+        return
+    d = ds41_mu_cap(comp)
+    if DS41_MU_CHECKPOINT_LINES:
+        ds41_mu_retained, ds41_mu_victim = _ds41_mu_select_checkpoint_line(lru, tc, node, d)
+        if not ds41_mu_retained:
+            _log.info("[ds41_mu-radix] Checkpoint not set (line cap) c=%d node %s rid=%s", ds41_mu_new_checkpoint_end, node.id, _rid(req))
+            return
+        # Same demotion as before; only the selection differs.
+        for ds41_mu_previous_value in ds41_mu_victim:
+            lru.ds41_mu_set_class(ds41_mu_previous_value, 1)
+            reg.pop(ds41_mu_previous_value.id, None)
+            _log.info("[ds41_mu-radix] Checkpoint demoted node %s (line cap %d)", ds41_mu_previous_value.id, d)
+        lru.ds41_mu_set_class(node, 0)
+        reg[node.id] = node
+        _log.info("[ds41_mu-radix] Checkpoint set c=%d node %s rid=%s (%d/%d; lines)", ds41_mu_new_checkpoint_end, node.id, _rid(req), len(reg), d)
+        return
+    while reg and len(reg) >= d:
+        ds41_mu_previous_value = _ds41_mu_select_lowest_value_victim(lru, tc, node, ds41_mu_new_checkpoint_end) if DS41_MU_CHECKPOINT_VALUE_POLICY else lru.ds41_mu_class_lru_end(0)
+        if ds41_mu_previous_value is None:
+            break
+        if ds41_mu_previous_value is node:
+            _log.info(
+                "[ds41_mu-radix] Checkpoint not set (value) c=%d node %s rid=%s",
+                ds41_mu_new_checkpoint_end, node.id, _rid(req),
+            )
+            return
+        lru.ds41_mu_set_class(ds41_mu_previous_value, 1)
+        reg.pop(ds41_mu_previous_value.id, None)
+        _log.info("[ds41_mu-radix] Checkpoint demoted node %s (cap %d)", ds41_mu_previous_value.id, d)
+    lru.ds41_mu_set_class(node, 0)
+    reg[node.id] = node
+    _log.info(
+        "[ds41_mu-radix] Checkpoint set c=%d node %s rid=%s (%d/%d)",
+        req.kv.cache_protected_len, node.id, getattr(req, "rid", "?"), len(reg), d,
+    )
+
+
+def ds41_mu_continue_insertion(cache, req, insert_result, fill_len: int) -> bool:
+    """Z1 from cache_unfinished_req after cleanup: If this pass capped at
+    checkpoint c, record the checkpoint (class 0 for source msg), set the next
+    open point, and return True if more needs to be inserted up to
+    page_floor(fill_len) (then the caller calls itself once more). Every follow-up call caps later or not at all, so it terminates."""
+    if not F2 or insert_result is None or not insert_result.swa_branch_inserted:
+        if F2 and DBG and getattr(req, "_ds41_mu_mem_peak_pending", None):
+            _dbg(
+                "checkpoint_continue skipped rid=%s reason=%s c=%s open=%s fill=%d ev=%s",
+                _rid(req),
+                "insert_result_none" if insert_result is None else "no_swa_branch_inserted",
+                getattr(getattr(req, "kv", None), "cache_protected_len", None),
+                req._ds41_mu_mem_peak_pending, fill_len,
+                getattr(getattr(req, "kv", None), "swa_evicted_seqlen", None),
+            )
+        return False
+    page = cache.page_size
+    c = req.kv.cache_protected_len
+    ds41_mu_open_checkpoint = list(getattr(req, "_ds41_mu_mem_peak_pending", None) or [])
+    # This pass caps at the smallest open point, set by ds41_mu_after_match or the prior ds41_mu_continue_insertion call.
+    # That call set swa_branching_seqlen to the point; cleanup_after_caching_req has already set the field to None.
+    ds41_mu_capped = ds41_mu_open_checkpoint[0][0] if ds41_mu_open_checkpoint else None
+    ds41_mu_source = None
+    while ds41_mu_open_checkpoint and ds41_mu_open_checkpoint[0][0] <= c:
+        cc, q = ds41_mu_open_checkpoint.pop(0)
+        if cc == c:
+            ds41_mu_source = q
+    # Keep the Z1 frontier advancing after free_out_of_window_slots releases SWA slots:
+    # swa_evicted_seqlen measures released slots from the chunk end, not from the cap.
+    # A later checkpoint cc with cc - W < swa_evicted_seqlen no longer has a live
+    # SWA window. The next pass could insert a tombstone node, leaving the match
+    # below prefix_len (asserted in cache_unfinished_req) and c capped indefinitely
+    # at the same location. Discard points without a live window and remaining points through
+    # an unreached cap (c < cap), so each later call advances c or has fewer points.
+    comp = _swa_comp(cache)
+    if ds41_mu_open_checkpoint and comp is not None:
+        W = comp.sliding_window_size
+        ev = req.kv.swa_evicted_seqlen
+        ds41_mu_removed = [cc for cc, _ in ds41_mu_open_checkpoint if cc - W < ev or (ds41_mu_capped is not None and c < ds41_mu_capped and cc <= ds41_mu_capped)]
+        if ds41_mu_removed:
+            ds41_mu_open_checkpoint = [(cc, q) for cc, q in ds41_mu_open_checkpoint if cc not in ds41_mu_removed]
+            _log.info(
+                "[ds41_mu-radix] Checkpoint discarded c=%s (SWA free through %d, capped %s, reached %d) rid=%s",
+                ds41_mu_removed, ev, ds41_mu_capped, c, getattr(req, "rid", "?"),
+            )
+    req._ds41_mu_mem_peak_pending = ds41_mu_open_checkpoint
+    _dbg(
+        "checkpoint_continue rid=%s cap=%s c=%d source=%s remaining_open=%s fill=%d ev=%s",
+        _rid(req), ds41_mu_capped, c, ds41_mu_source, ds41_mu_open_checkpoint, fill_len,
+        getattr(req.kv, "swa_evicted_seqlen", None),
+    )
+    if ds41_mu_source == "msg":
+        ds41_mu_mark_checkpoint(cache, req)
+    ds41_mu_next_checkpoint = ds41_mu_open_checkpoint[0][0] if ds41_mu_open_checkpoint else None
+    # Keep the next open point even when
+    # it is beyond page_floor(fill), so a later chunk reaches it.
+    # Previously, this field was set to None. ds41_mu_after_match does not run between chunks, so the point
+    # (for example, msg in the final chunk after a full point in the first) was silently lost. A point
+    # after the chunk end follows the port's open after_match behavior (no cap
+    # until that chunk reaches it). Recursion is unchanged.
+    req.swa_branching_seqlen = ds41_mu_next_checkpoint
+    return _floor(fill_len, page) > c
+
+
+def ds41_mu_before_finish(cache, req) -> bool:
+    """Z1 from cache_finished_req: if a checkpoint remains open at the end of prefill,
+    run the unfinished path first to process the checkpoint and continue insertion."""
+    if not F2:
+        return False
+    c = getattr(req, "swa_branching_seqlen", None)
+    if c is None or c <= req.kv.cache_protected_len:
+        if DBG and getattr(req, "_ds41_mu_mem_peak_pending", None):
+            _dbg(
+                "checkpoint_before_finish no rid=%s c=%s protected=%d open=%s",
+                _rid(req), c, req.kv.cache_protected_len, req._ds41_mu_mem_peak_pending,
+            )
+        return False
+    if req.extend_range is None:
+        _dbg("checkpoint_before_finish no rid=%s c=%d extend_range_none", _rid(req), c)
+        return False
+    fill = len(req.get_fill_ids())
+    ds41_mu_yes = c <= _floor(fill, cache.page_size)
+    _dbg(
+        "checkpoint_before_finish %s rid=%s c=%d protected=%d fill=%d ev=%s",
+        "yes" if ds41_mu_yes else "no", _rid(req), c, req.kv.cache_protected_len,
+        fill, getattr(req.kv, "swa_evicted_seqlen", None),
+    )
+    return ds41_mu_yes
+
+
+def ds41_mu_on_match_traversal(comp, node, root_node) -> None:
+    """Z4 from refresh_lru(MATCH_END): refresh every checkpoint on the hit path
+    within the protection class (O(depth))."""
+    if not F2:
+        return
+    lru = _ds41_mu_get_class_lru(comp)
+    if lru is None or not lru.ds41_mu_checkpoint_registry:
+        return
+    x = node
+    while x is not root_node and x is not None:
+        if x.id in lru.ds41_mu_checkpoint_registry:
+            lru.reset_node_mru(x)
+        x = x.parent
+
+
+def _ds41_mu_remove_checkpoint(comp, node) -> None:
+    lru = _ds41_mu_get_class_lru(comp)
+    if lru is not None and lru.ds41_mu_checkpoint_registry.pop(node.id, None) is not None:
+        _log.info("[ds41_mu-radix] Checkpoint evicted node %s", node.id)
+
+
+def ds41_mu_check_checkpoints(cache, ds41_mu_error) -> None:
+    """I4: registry == class-0 nodes; live, len >= W, end is page-aligned,
+    node is in the tree, count <= cap."""
+    comp = _swa_comp(cache)
+    lru = _ds41_mu_get_class_lru(comp) if comp is not None else None
+    if lru is None:
+        return
+    ct = comp.component_type
+    tc = comp.tree_core
+    page = tc.page_size
+    reg = lru.ds41_mu_checkpoint_registry
+    if len(reg) > ds41_mu_cap(comp):
+        ds41_mu_error(f"I4 {len(reg)} checkpoints > cap {ds41_mu_cap(comp)}")
+    for nid, n in reg.items():
+        cd = n.component_data[ct]
+        if cd.metadata.get("ds41_mu_class_lru") != 0:
+            ds41_mu_error(f"I4 Checkpoint {nid} is not class 0")
+        if cd.value is None:
+            ds41_mu_error(f"I4 Checkpoint {nid} has no SWA value")
+        if len(n.key) < comp.sliding_window_size:
+            ds41_mu_error(f"I4 Checkpoint {nid} is shorter than W")
+        ds41_mu_end_node = 0
+        x = n
+        while x is not tc.root_node:
+            if x.parent is None or x.parent.children.get(x.key.child_key(page)) is not x:
+                ds41_mu_error(f"I4 Checkpoint {nid} is no longer in the tree")
+                break
+            ds41_mu_end_node += len(x.key)
+            x = x.parent
+        if ds41_mu_end_node % page:
+            ds41_mu_error(f"I4 Checkpoint {nid} end {ds41_mu_end_node} is not page-aligned")
+    pt = lru._pt
+    x = lru.head.lru_next[pt]
+    while x is not lru.w01:
+        if x.id not in reg:
+            ds41_mu_error(f"I4 Class-0 node {x.id} is not registered")
+        x = x.lru_next[pt]
+
+
+# ---------------------------------------------------------------------------
+# Z2: token offset of the last actual user message from serving_chat.
+# ---------------------------------------------------------------------------
+
+
+def _ds41_mu_is_real_user_message(m: dict) -> bool:
+    """developer always; user only when it has text (not only tool_result blocks).
+    After merge_tool_messages, every user message has content_blocks."""
+    if m.get("role") == "developer":
+        return True
+    ds41_mu_blocks = m.get("content_blocks")
+    if ds41_mu_blocks is None:
+        return bool(m.get("content"))
+    return any(b.get("type") == "text" for b in ds41_mu_blocks)
+
+
+def ds41_mu_last_user_message_offset(messages, prompt_ids, tokenizer, thinking_mode) -> "int | None":
+    """Token offset (position of the <｜User｜> token) of the last actual user message
+    in the dsv41 prompt. Returns None if the mapping is ambiguous (probe:
+    the number of <｜User｜> tokens equals the number of user/developer messages after merging
+    as in the encoder) or if no actual user message exists."""
+    try:
+        from sglang.srt.entrypoints.openai import encoding_dsv41 as enc
+
+        msgs = enc.merge_tool_messages(messages)
+        tm = getattr(thinking_mode, "value", thinking_mode)
+        if tm == "thinking" and not any(m.get("tools") for m in msgs):
+            msgs = enc._drop_thinking_messages(msgs)  # as in _encode_messages_text
+        user_like = [m for m in msgs if m.get("role") in ("user", "developer")]
+        uid = tokenizer.convert_tokens_to_ids(enc.USER_SP_TOKEN)
+        if not user_like or uid is None:
+            _dbg("offset None reason=%s n_msgs=%d len=%d", "no_user" if not user_like else "uid_none",
+                 len(msgs), len(prompt_ids))
+            return None
+        pos = [i for i, t in enumerate(prompt_ids) if t == uid]
+        if len(pos) != len(user_like):
+            _dbg("offset None reason=user_token_count n_user_token=%d n_user_like=%d n_msgs=%d len=%d tm=%s",
+                 len(pos), len(user_like), len(msgs), len(prompt_ids), tm)
+            return None
+        ds41_mu_target = None
+        for k, m in enumerate(user_like):
+            if _ds41_mu_is_real_user_message(m):
+                ds41_mu_target = k
+        if ds41_mu_target is None:
+            _dbg("offset None reason=no_actual_user_message n_user_like=%d len=%d", len(user_like), len(prompt_ids))
+        else:
+            _dbg("offset=%d ziel=%d/%d n_msgs=%d len=%d tm=%s", pos[ds41_mu_target], ds41_mu_target, len(user_like), len(msgs),
+                 len(prompt_ids), tm)
+        return None if ds41_mu_target is None else pos[ds41_mu_target]
+    except Exception as e:  # noqa: BLE001  (never put the request at risk)
+        _log.debug("[ds41_mu-radix] Could not determine user-message offset", exc_info=True)
+        _dbg("offset None reason=exception type=%s", type(e).__name__)
+        return None
diff -ruN a/python/sglang/srt/mem_cache/ds41_mu_radix_lru.py b/python/sglang/srt/mem_cache/ds41_mu_radix_lru.py
--- a/python/sglang/srt/mem_cache/ds41_mu_radix_lru.py	1970-01-01 01:00:00.000000000 +0100
+++ b/python/sglang/srt/mem_cache/ds41_mu_radix_lru.py	2026-10-03 13:31:08.233388206 +0200
@@ -0,0 +1,134 @@
+"""Three-class SWA LRU for F1b/F2.
+
+Order from MRU to LRU:
+    head, class 0 (checkpoint), w01, class 1 (normal), w12, class 2 (disposable), tail
+Eviction starts at tail (get_lru_no_lock/get_prev_no_lock) and therefore evicts
+disposable nodes first, then normal nodes, and checkpoints last. Sentinels w01/w12 use
+lock_ref = 1 and are skipped by every walker (pattern: session partition
+with mid, unified_tree_core.UnifiedLRUList).
+
+The class is stored in component field metadata["ds41_mu_class_lru"] (default 1).
+Only for the SWA device list and only without the session radix cache.
+"""
+
+from __future__ import annotations
+
+from sglang.srt.mem_cache.unified_cache.unified_tree_core import (
+    UnifiedLRUList,
+    UnifiedTreeNode,
+)
+
+DS41_MU_CLASS_CHECKPOINT = 0
+DS41_MU_CLASS_NORMAL = 1
+DS41_MU_CLASS_DISPOSABLE = 2
+DS41_MU_CLASS_KEY = "ds41_mu_class_lru"
+
+
+def ds41_mu_class_of_node(node: UnifiedTreeNode, ct) -> int:
+    return node.component_data[ct].metadata.get(DS41_MU_CLASS_KEY, DS41_MU_CLASS_NORMAL)
+
+
+class DS41MUClassLRU(UnifiedLRUList):
+    def __init__(self, component_type, tree_components):
+        super().__init__(component_type, tree_components, use_host_ptr=False)
+        assert self.mid is None, "Class LRU only without session partition"
+        self.w01 = UnifiedTreeNode(tree_components)
+        self.w12 = UnifiedTreeNode(tree_components)
+        for ct in tree_components:
+            for w in (self.w01, self.w12):
+                w.component_data[ct].lock_ref = 1
+                w.component_data[ct].host_lock_ref = 1
+        self._add_node_after(self.head, self.w01)
+        self._add_node_after(self.w01, self.w12)
+        # For _check_lru_linked_list (unified_tree_core): skip sentinels.
+        self._ds41_mu_guard = (self.w01, self.w12)
+        # Z3: checkpoint registry (class 0), node.id -> node; it lives with the
+        # list and is recreated when the tree is reset().
+        self.ds41_mu_checkpoint_registry: dict = {}
+
+    def ds41_mu_node_class(self, node: UnifiedTreeNode) -> int:
+        return ds41_mu_class_of_node(node, self.component_type)
+
+    def _ds41_mu_class_anchor(self, ds41_mu_class_id: int) -> UnifiedTreeNode:
+        if ds41_mu_class_id == DS41_MU_CLASS_CHECKPOINT:
+            return self.head
+        if ds41_mu_class_id == DS41_MU_CLASS_DISPOSABLE:
+            return self.w12
+        return self.w01
+
+    def _add_node(self, node: UnifiedTreeNode):
+        self._add_node_after(self._ds41_mu_class_anchor(self.ds41_mu_node_class(node)), node)
+
+    def _ds41_mu_reset_sentinels(self, node, root_node, should_include, ds41_mu_window):
+        # As in UnifiedLRUList.reset_node_and_*: ancestors are inserted into each class
+        # after the last node inserted into that class, so
+        # the leaf-nearest node in its class remains closest to the MRU end.
+        prev = {
