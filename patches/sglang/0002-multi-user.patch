+            leftovers = bool(self.tasks or self.inflight or self.published)
+            # Counting first marks every older task as dropped, so a task that
+            # waits for a slot the aborted forward never released gives up.
+            self.forward += 1
+            self.scheduled.clear()
+            self.cv.notify_all()
+            if leftovers:
+                self.tasks.clear()
