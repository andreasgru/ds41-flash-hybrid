diff -ruN a/python/sglang/kernels/ops/layernorm/mhc_post_defer.py b/python/sglang/kernels/ops/layernorm/mhc_post_defer.py
--- a/python/sglang/kernels/ops/layernorm/mhc_post_defer.py	1970-01-01 01:00:00.000000000 +0100
+++ b/python/sglang/kernels/ops/layernorm/mhc_post_defer.py	2026-10-03 13:31:08.229724781 +0200
@@ -0,0 +1,64 @@
+"""HC=4 post-mix of the attention sublayer with a deferred MoE contribution of the previous layer with deferred MoE output (KT_DS41_MU_DEFER_MHC).
+
+Same arithmetic as mhc_post_split_h, except that every residual stream i first gets the deferred CPU-expert output
+of layer L added with that layer's FFN post weight:
+    res'_i = res_i + rsf * prev_post_i * d          (fp32, one fma per element)
+    out_j  = post_j * x + sum_i comb_ij * res'_i    (fma chain and order exactly as mhc_post_split_h)
+This is where the deferred term would have gone through the residual path if it had been part of R_out_L:
+exact up to rounding when the attention of L+1 is held fixed (only the attention input / mix coefficients of L+1
+did not see it). With d == 0 the result is bit-identical to mhc_post_split_h.
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _mhc_post_defer_kernel(X, R, P, C, D, PP, Y, rsf, H: tl.constexpr, B: tl.constexpr):
+    token = tl.program_id(0)
+    h = tl.program_id(1) * B + tl.arange(0, B)
+    channel = tl.arange(0, 4)
+    x = tl.load(X + token * H + h, h < H, 0).to(tl.float32)
+    d = tl.load(D + token * H + h, h < H, 0).to(tl.float32)
+    post = tl.load(P + token * 4 + channel)
+    q0 = tl.load(PP + token * 4) * rsf
+    residual0 = tl.fma(q0, d, tl.load(R + token * 4 * H + h, h < H, 0).to(tl.float32))
+    comb0 = tl.load(C + token * 16 + channel)
+    # same contraction order as mhc_post_split_h (comb[0]*residual[0] rounded first, then fma post*x)
+    acc = tl.fma(post[:, None], x[None, :], comb0[:, None] * residual0[None, :])
+    for i in tl.static_range(1, 4):
+        qi = tl.load(PP + token * 4 + i) * rsf
+        residual = tl.fma(qi, d, tl.load(R + (token * 4 + i) * H + h, h < H, 0).to(tl.float32))
+        comb = tl.load(C + token * 16 + i * 4 + channel)
+        acc = tl.fma(comb[:, None], residual[None, :], acc)
+    tl.store(Y + (token * 4 + channel[:, None]) * H + h[None, :], acc, h[None, :] < H)
+
+
+def mhc_post_defer(x, residual, post, comb, d, prev_post, rsf):
+    """x [T,H] bf16 (attention out), residual [T,4,H] bf16 (R_out_L without the deferred part), post [T,4] fp32,
+    comb [T,4,4] fp32 (attention L+1), d [T,H] bf16 (deferred CPU-expert sum of layer L, unscaled),
+    prev_post [T,4] fp32 (FFN post of layer L), rsf = routed_scaling_factor of layer L."""
+    T, Hd = x.shape
+    assert x.dtype == residual.dtype == d.dtype == torch.bfloat16
+    assert post.dtype == comb.dtype == prev_post.dtype == torch.float32
+    assert residual.shape == (T, 4, Hd) and d.shape == (T, Hd)
+    assert post.numel() == T * 4 and prev_post.numel() == T * 4 and comb.numel() == T * 16
+    assert all(t.is_contiguous() for t in (x, residual, post, comb, d, prev_post))
+    output = torch.empty_like(residual)
+    block = 128 if T <= 8 else 1024
+    _mhc_post_defer_kernel[(T, triton.cdiv(Hd, block))](
+        x,
+        residual,
+        post,
+        comb,
+        d,
+        prev_post,
+        output,
+        float(rsf),
+        H=Hd,
+        B=block,
+        num_warps=4,
+        enable_fp_fusion=False,
+    )
+    return output
