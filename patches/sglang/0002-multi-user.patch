+    def forward_batch_ds41_mu_split(self, batch: ScheduleBatch, forward_count: int = 1):
+        """Run one layer range of a split-prefill batch.
+
+        The batch stays EXTEND. The ForwardBatch is built once (split_index 0)
+        and reused; the model runs only layers [split_index, +forward_count)
+        (DeepseekV4ForCausalLM.ds41_mu_request). Attention metadata is planned on
+        the first call only. After the last layer, sampling matches
+        forward_batch_generation (non-delayed, non-verify)."""
+        model = self.model_runner.model
+        # a decode step between two calls rebinds the consumer index
+        self.set_hicache_consumer(batch.hicache_consumer_index)
+        if batch.split_index == 0:
+            batch.split_forward_batch = ForwardBatch.init_new(
+                batch,
+                self.model_runner,
+                return_hidden_states_before_norm=False,
+            )
+        forward_batch = batch.split_forward_batch
+        start = batch.split_index
+        num_layers = model.model.end_layer
+        end = min(start + max(forward_count, 1), num_layers)
+        if start > 0 and not forward_batch.forward_metadata_ready:
+            forward_batch.mark_forward_metadata_ready()
+        model.ds41_mu_request = (start, end)
+        try:
+            out = self.model_runner.forward(forward_batch)
+        finally:
+            model.ds41_mu_request = None
+        batch.split_index = end
+        logits_output = out.logits_output
+        batch_result = GenerationBatchResult(
+            logits_output=logits_output,
+            can_run_cuda_graph=out.can_run_graph,
+            expert_distribution_metrics=out.expert_distribution_metrics,
+            routed_experts_output=out.routed_experts_output,
+            indexer_topk_output=out.indexer_topk_output,
+        )
+        if end < num_layers:
+            batch_result.next_token_ids = None
+            return batch_result
+        batch.split_prefill_finished = True
+        batch.split_forward_batch = None
+        capture_pre_sample_logits(batch, forward_batch, logits_output)
+        if not forward_batch.is_prefill_only:
+            batch_result.next_token_ids = self.model_runner.sample(
+                logits_output, forward_batch
+            )
+        else:
+            batch_result.next_token_ids = torch.zeros(
+                len(forward_batch.seq_lens),
+                dtype=torch.long,
+                device=forward_batch.input_ids.device,
+            )
+            if (
+                forward_batch.return_logprob
+                and logits_output.next_token_logits is not None
+            ):
+                self.model_runner.compute_logprobs_only(logits_output, forward_batch)
+        return batch_result
