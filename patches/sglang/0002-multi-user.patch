+        self.published = {}  # (forward, layer, gi) -> seq
+        self.slot_last = [0] * sp.S  # seq of the slot's latest occupant
+        self.slot_released = [0] * sp.S  # latest occupant seq the main thread computed
+        self.forward = 0
+        self.seq = 0
+        self.inflight = 0  # tasks taken but not yet published
+        self.paused = False
+        self.writing = False
+        self.error: Optional[BaseException] = None
+        self.stats = {"write": 0.0, "hostwait": 0.0, "slotwait": 0.0, "dma_enq": 0.0}
+        if P2_SWITCH_MS > 0:
+            sys.setswitchinterval(P2_SWITCH_MS / 1000.0)
+        self.thread = threading.Thread(target=self._loop, name="kt-stream-p2", daemon=True)
+        self.thread.start()
+        _log(f"rank {sp.rank}: P2 writer thread up, {sp.S} device slots, {HOST_BUFFERS} host buffers")
+
+    # -- main thread ---------------------------------------------------------
+
