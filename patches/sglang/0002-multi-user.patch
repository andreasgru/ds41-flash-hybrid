diff -ruN a/python/sglang/srt/managers/ds41_mu_oom_guard.py b/python/sglang/srt/managers/ds41_mu_oom_guard.py
--- a/python/sglang/srt/managers/ds41_mu_oom_guard.py	1970-01-01 01:00:00.000000000 +0100
+++ b/python/sglang/srt/managers/ds41_mu_oom_guard.py	2026-10-03 13:31:08.230201701 +0200
@@ -0,0 +1,395 @@
+# SPDX-License-Identifier: Apache-2.0
+"""OOM recovery guard.
+
+When SGLANG_DS41_MU_OOM_GUARD=1, the scheduler catches CUDA out-of-memory
+errors raised while an EXTEND batch runs. It rolls the batch back like a retract
+(release_kv_cache(is_insert=False) + reset_for_retract), returns its requests
+to the front of the waiting queue, and caps prefill chunks at
+max(minimum_limit, floor_page(T / 2)) until every request in the failed batch
+finishes prefill. A request that reaches the configured attempt limit, or has
+an OOM at the minimum chunk size, ends with FINISH_ABORT; the server keeps
+running.
+
+The guard does not catch decode batches (including decode steps interleaved
+with prefill), batches below the stream threshold (CB-JOIN), a failed KT
+streamer (_failed), a failed P2 writer, or an error after
+torch.cuda.synchronize() itself fails.
+
+Switches (all default off):
+  SGLANG_DS41_MU_OOM_GUARD       1 = catch and roll back
+  SGLANG_DS41_MU_OOM_MIN_LIMIT   minimum cap, a multiple of the page (2048)
+  SGLANG_DS41_MU_OOM_ATTEMPTS    OOMs per request before abort (4)
+  SGLANG_DS41_MU_OOM_TEST        injection "n:k[:location]": raise
+                                torch.OutOfMemoryError in the n-th
+                                extend run at layer k; location =
+                                normal | a8 | p3 | phase3_midpoint (before the
+                                FFN half of the first tile, while P2
+                                tasks are open). Requires
+                                SGLANG_DS41_MU_OOM_GUARD=1.
+
+The injection wraps methods on layer instances (no model-source change)
+and exists only when SGLANG_DS41_MU_OOM_TEST is set.
+
+This module imports torch lazily so the logic can be tested without a GPU.
+"""
+
+import gc
+import logging
+import os
+from dataclasses import dataclass
+from typing import Callable, Dict, Iterable, List, Mapping, Optional, Set, Tuple
+
+logger = logging.getLogger(__name__)
+
+DS41_MU_INJECTION_LOCATIONS = ("normal", "a8", "p3", "phase3_midpoint")
+DS41_MU_WRITER_ERROR = "kt-stream P2 writer failed"
+OOM_TEXT = "CUDA out of memory"
+
+
+# ---------------------------------------------------------------- configuration
+
+
+@dataclass(frozen=True)
+class DS41MUInjectionSpec:
+    n: int  # the n-th extend run (1-based, counted by the scheduler)
+    ds41_mu_layer_index: int  # layer index
+    ds41_mu_location: str  # one of DS41_MU_INJECTION_LOCATIONS
+
+
+@dataclass(frozen=True)
+class DS41MUOOMConfig:
+    ds41_mu_lower_limit: int
+    ds41_mu_attempts: int
+    test: Optional[DS41MUInjectionSpec]
+
+
+def _int(env: Mapping[str, str], name: str, default: int) -> int:
+    raw = env.get(name, "")
+    if raw == "":
+        return default
+    try:
+        return int(raw)
+    except ValueError:
+        raise ValueError(f"[oom-guard] {name}={raw!r} is not an integer")
+
+
+def ds41_mu_parse_injection(raw: str) -> DS41MUInjectionSpec:
+    ds41_mu_parts = raw.split(":")
+    if len(ds41_mu_parts) not in (2, 3):
+        raise ValueError(f"[oom-guard] SGLANG_DS41_MU_OOM_TEST={raw!r}: expected n:k[:location]")
+    try:
+        n, k = int(ds41_mu_parts[0]), int(ds41_mu_parts[1])
+    except ValueError:
+        raise ValueError(f"[oom-guard] SGLANG_DS41_MU_OOM_TEST={raw!r}: n and k must be integers")
+    ds41_mu_location = ds41_mu_parts[2] if len(ds41_mu_parts) == 3 else "normal"
+    if n < 1 or k < 0 or ds41_mu_location not in DS41_MU_INJECTION_LOCATIONS:
+        raise ValueError(
+            f"[oom-guard] SGLANG_DS41_MU_OOM_TEST={raw!r}: need n >= 1, k >= 0, location in {DS41_MU_INJECTION_LOCATIONS}"
+        )
+    return DS41MUInjectionSpec(n, k, ds41_mu_location)
+
+
+def ds41_mu_read_config(page_size: int, env: Optional[Mapping[str, str]] = None) -> Optional[DS41MUOOMConfig]:
+    """Return None when SGLANG_DS41_MU_OOM_GUARD is not 1. Raise ValueError
+    if the configuration is invalid; the guard must not start partially enabled."""
+    env = os.environ if env is None else env
+    ds41_mu_enabled = env.get("SGLANG_DS41_MU_OOM_GUARD", "0")
+    ds41_mu_raw_test = env.get("SGLANG_DS41_MU_OOM_TEST", "")
+    if ds41_mu_enabled not in ("0", "1", ""):
+        raise ValueError(f"[oom-guard] SGLANG_DS41_MU_OOM_GUARD={ds41_mu_enabled!r}: 0 or 1")
+    if ds41_mu_enabled != "1":
+        if ds41_mu_raw_test:
+            raise ValueError("[oom-guard] SGLANG_DS41_MU_OOM_TEST needs SGLANG_DS41_MU_OOM_GUARD=1")
+        return None
+    ds41_mu_page = max(int(page_size or 1), 1)
+    ds41_mu_lower_limit = _int(env, "SGLANG_DS41_MU_OOM_MIN_LIMIT", 2048)
+    if ds41_mu_lower_limit < ds41_mu_page or ds41_mu_lower_limit % ds41_mu_page:
+        raise ValueError(
+            f"[oom-guard] SGLANG_DS41_MU_OOM_MIN_LIMIT={ds41_mu_lower_limit}: a positive multiple of the page {ds41_mu_page}"
+        )
+    ds41_mu_attempts = _int(env, "SGLANG_DS41_MU_OOM_ATTEMPTS", 4)
+    if ds41_mu_attempts < 1:
+        raise ValueError(f"[oom-guard] SGLANG_DS41_MU_OOM_ATTEMPTS={ds41_mu_attempts}: at least 1")
+    test = ds41_mu_parse_injection(ds41_mu_raw_test) if ds41_mu_raw_test else None
+    return DS41MUOOMConfig(ds41_mu_lower_limit, ds41_mu_attempts, test)
+
+
+# ---------------------------------------------------------------- classification
+
+
+def ds41_mu_is_oom(e: BaseException) -> bool:
+    """torch.OutOfMemoryError, or a RuntimeError reporting a CUDA OOM outside the
+    caching allocator (cuBLAS workspace, JIT). The P2 writer's error is never
+    an OOM here even when an OOM caused it: the writer thread is gone."""
+    if DS41_MU_WRITER_ERROR in str(e):
+        return False
+    try:
+        import torch
+
+        ds41_mu_oom_type = getattr(torch, "OutOfMemoryError", None) or torch.cuda.OutOfMemoryError
+        if isinstance(e, ds41_mu_oom_type):
+            return True
+    except ImportError:  # pragma: no cover - the server always has torch
+        pass
+    return isinstance(e, RuntimeError) and OOM_TEXT in str(e)
+
+
+def _ds41_mu_stream_module():
+    try:
+        from sglang.srt.layers.moe import kt_stream_prefill as ks
+    except Exception:  # KT not built into this tree
+        return None
+    return ks
+
+
+def ds41_mu_uncaught_reason(
+    e: BaseException,
+    *,
+    ds41_mu_is_extend: bool,
+    ds41_mu_in_decode_step: bool,
+    extend_tokens: int,
+    ds41_mu_stream_threshold: int,
+    ks=None,
+) -> Optional[str]:
+    """None when the brake may take this error; else the reason it re-raises."""
+    if not ds41_mu_is_oom(e):
+        return "no-oom"
+    if not ds41_mu_is_extend:
+        return "decode"
+    if ds41_mu_in_decode_step:
+        return "split-prefill-decode"
+    if ds41_mu_stream_threshold > 0 and extend_tokens < ds41_mu_stream_threshold:
+        return "below-stream-threshold"
+    ks = _ds41_mu_stream_module() if ks is None else ks
+    if ks is not None:
+        if getattr(ks, "_failed", False):
+            return "kt-failed"
+        inst = getattr(ks, "_instance", None)
+        p2 = getattr(inst, "_p2", None) if inst is not None else None
+        if p2 is not None and getattr(p2, "error", None) is not None:
+            return "p2-writer"
+    return None
+
+
+# ---------------------------------------------------------------- cap and attempts
+
+
+def ds41_mu_page_floor(x: int, ds41_mu_page: int) -> int:
+    return (int(x) // ds41_mu_page) * ds41_mu_page
+
+
+class DS41MUOOMState:
+    """Cap, attempts per rid, counters. The scheduler owns one instance."""
+
+    def __init__(self, ds41_mu_config: DS41MUOOMConfig, page_size: int):
+        self.k = ds41_mu_config
+        self.ds41_mu_page = max(int(page_size or 1), 1)
+        self.ds41_mu_cap: Optional[int] = None
+        self.rids: Set[str] = set()  # requests the cap waits for
+        self.ds41_mu_attempts: Dict[str, int] = {}
+        self.ds41_mu_caught = 0
+        self.ds41_mu_aborted = 0
+
+    # -- after an OOM
+    def ds41_mu_after_oom(self, rids: Iterable[str], ds41_mu_failed_timestamp: int) -> Tuple[Optional[int], List[str]]:
+        """Record an OOM for a batch whose failed extend size was t tokens.
+        Return the updated cap (if any) and the request IDs to abort."""
+        self.ds41_mu_caught += 1
+        rids = list(rids)
+        ds41_mu_at_floor = ds41_mu_failed_timestamp <= self.k.ds41_mu_lower_limit
+        ds41_mu_abort: List[str] = []
+        for rid in rids:
+            self.ds41_mu_attempts[rid] = self.ds41_mu_attempts.get(rid, 0) + 1
+            if ds41_mu_at_floor or self.ds41_mu_attempts[rid] >= self.k.ds41_mu_attempts:
+                ds41_mu_abort.append(rid)
+        for rid in ds41_mu_abort:
+            self._ds41_mu_forget_injection(rid)
+        self.ds41_mu_aborted += len(ds41_mu_abort)
+        ds41_mu_remain = [r for r in rids if r not in ds41_mu_abort]
+        if ds41_mu_remain:
+            ds41_mu_new_value = max(self.k.ds41_mu_lower_limit, ds41_mu_page_floor(ds41_mu_failed_timestamp // 2, self.ds41_mu_page))
+            self.ds41_mu_cap = ds41_mu_new_value if self.ds41_mu_cap is None else min(self.ds41_mu_cap, ds41_mu_new_value)
+            self.rids.update(ds41_mu_remain)
+        elif not self.rids:
+            self.ds41_mu_cap = None
+        return self.ds41_mu_cap, ds41_mu_abort
+
+    # -- while planning a batch
+    def budget(self, ds41_mu_base: Optional[int]) -> Optional[int]:
+        if self.ds41_mu_cap is None or ds41_mu_base is None:
+            return ds41_mu_base
+        return min(ds41_mu_base, self.ds41_mu_cap)
+
+    # -- when a request leaves the prefill (finished prefill, finished, aborted)
+    def ds41_mu_finished(self, rid: str) -> bool:
+        """True when this released the cap."""
+        ds41_mu_was_active = self.ds41_mu_cap is not None
+        self._ds41_mu_forget_injection(rid)
+        if ds41_mu_was_active and not self.rids:
+            self.ds41_mu_cap = None
+            return True
+        return False
+
+    def _ds41_mu_forget_injection(self, rid: str) -> None:
+        self.rids.discard(rid)
+        self.ds41_mu_attempts.pop(rid, None)
+
+    def ds41_mu_log_line(self, ds41_mu_event_value: str, **ds41_mu_fields) -> str:
+        ds41_mu_parts = " ".join(f"{k}={v}" for k, v in ds41_mu_fields.items())
+        return (
+            f"[oom-guard] {ds41_mu_event_value} {ds41_mu_parts} cap={self.ds41_mu_cap} caught={self.ds41_mu_caught} "
+            f"aborted={self.ds41_mu_aborted}"
+        ).rstrip()
+
+
+# ---------------------------------------------------------------- device side
+
+
+def ds41_mu_memory_text() -> str:
+    try:
+        import torch
+
+        if not torch.cuda.is_available():
+            return "cuda=off"
+        ds41_mu_free_capacity, ds41_mu_total = torch.cuda.mem_get_info()
+        mib = 1 << 20
+        return (
+            f"alloc={torch.cuda.memory_allocated() // mib}MiB "
+            f"reserved={torch.cuda.memory_reserved() // mib}MiB free={ds41_mu_free_capacity // mib}MiB"
+        )
+    except Exception as x:  # the log line must never raise
+        return f"memory=? ({type(x).__name__})"
+
+
+def ds41_mu_clear_device_cache(
+    backend=None,
+    *,
+    sync: Optional[Callable[[], None]] = None,
+    ks=None,
+) -> None:
+    """Waits for the kernels of the aborted run. Raises when synchronize fails
+    (sticky CUDA error): the caller then re-raises the original error."""
+    if sync is None:
+        import torch
+
+        sync = torch.cuda.synchronize
+    sync()
+    ks = _ds41_mu_stream_module() if ks is None else ks
+    inst = getattr(ks, "_instance", None) if ks is not None else None
+    p2 = getattr(inst, "_p2", None) if inst is not None else None
+    if p2 is not None and hasattr(p2, "new_forward"):
+        p2.new_forward()  # drops the leftovers of the aborted run, waits for in-flight
+    if backend is not None and hasattr(backend, "candidate_masks"):
+        backend.candidate_masks = None
+
+
+def ds41_mu_release_memory(*, ds41_mu_clear_memory: Optional[Callable[[], None]] = None) -> None:
+    gc.collect()
+    if ds41_mu_clear_memory is None:
+        import torch
+
+        if not torch.cuda.is_available():
+            return
+        ds41_mu_clear_memory = torch.cuda.empty_cache
+    ds41_mu_clear_memory()
+
+
+# ---------------------------------------------------------------- injection
+
+
+class DS41MUOOMInjector:
+    """Raises torch.OutOfMemoryError once, in the n-th extend run at layer k.
+    The scheduler calls ds41_mu_new_run() before each extend run and
+    ds41_mu_run_end() after it; interleaved decode steps set ds41_mu_in_decode."""
+
+    def __init__(self, e: DS41MUInjectionSpec):
+        self.e = e
+        self.ds41_mu_index = 0  # extend runs launched so far
+        self.ds41_mu_removed: Optional[str] = None  # "normal" | "a8" while an extend run is active
+        self.ds41_mu_in_decode = False
+        self.in_p3 = False
+        self.ds41_mu_triggered = False
+
+    def ds41_mu_new_run(self, ds41_mu_removed: str) -> None:
+        self.ds41_mu_index += 1
+        self.ds41_mu_removed = ds41_mu_removed
